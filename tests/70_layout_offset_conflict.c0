// expect: compile-error
//
// tests/70_layout_offset_conflict.c0 - an untyped access to a field at conflicting offsets is rejected
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
// 'y' is field 1 (offset 8) in A but field 0 (offset 0) in B. Two layouts
// may do that, but then an UNTYPED base cannot say which one it means, so a
// variable has to be declared with its layout (see 108_typed_layout_decl).
layout A { int x; int y; }
layout B { int y; int x; }
int main() { int a = alloc(16); return a.y; }
