// expect: 42
//
// tests/58_seven_args_boundary.c0 - the six-to-seven argument boundary
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
int sum7(int a, int b, int c, int d, int e, int f, int g) {
    return a + b + c + d + e + f + g;
}

int main() {
    int before;
    int after;
    int r;

    before = 111;
    r = sum7(1, 2, 3, 4, 5, 6, 7);
    after = 222;

    if (before != 111) { return 1; }
    if (after != 222) { return 2; }
    if (r != 28) { return 3; }

    return 42;
}
