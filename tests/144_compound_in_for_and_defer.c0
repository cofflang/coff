// expect: 42
//
// tests/144_compound_in_for_and_defer.c0 - compound assignment as a for step and in a defer
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
// A compound assignment as a for-loop step and as a deferred statement
// evaluates its target once, like any other. Each check that holds adds one.
layout P { int pa; int pb; }

int kc = 0;
int gc = 0;

int k() {
    kc += 1;
    return 0;
}

int gpass(int p) {
    gc += 1;
    return p;
}

int d(int p) {
    defer gpass(p).pb += 1;
    return 0;
}

int main() {
    int ok = 0;
    int b = alloc(8);
    int i = 0;
    store8(b, 0);
    store8(b + 1, 0);
    for (i = 0; i < 3; b[k()] += 2) {
        i += 1;
    }
    if (kc == 3 && b[0] == 6 && b[1] == 0) { ok += 1; }
    int p = alloc(sizeof(P));
    p.pb = 4;
    d(p);
    if (gc == 1 && p.pb == 5) { ok += 1; }
    if (ok == 2) { return 42; }
    return ok;
}
