// expect: 6
//
// tests/116_for_loop.c0 - for loops, with continue, break, a declaring init and nesting
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
//
// for (init; cond; step) body. continue runs the step (no infinite loop),
// break exits, init may declare a variable, the step may be a compound
// assignment, and for loops nest. Each check that holds adds one.
int main() {
    int ok = 0;
    int sum = 0;
    int i = 0;
    for (i = 0; i < 5; i = i + 1) { sum = sum + i; }
    if (sum == 10) { ok = ok + 1; }
    int t = 0;
    for (int j = 0; j < 4; j += 1) { t += j; }
    if (t == 6) { ok = ok + 1; }
    int evens = 0;
    int k = 0;
    for (k = 0; k < 10; k = k + 1) {
        if (k % 2 == 1) { continue; }
        evens = evens + 1;
    }
    if (evens == 5) { ok = ok + 1; }
    int odds = 0;
    int k2 = 0;
    for (k2 = 0; k2 < 10; k2 += 1) {
        if (k2 % 2 == 0) { continue; }
        odds = odds + 1;
    }
    if (odds == 5) { ok = ok + 1; }
    int c = 0;
    int m = 0;
    for (m = 0; m < 100; m = m + 1) {
        if (m == 7) { break; }
        c = c + 1;
    }
    if (c == 7) { ok = ok + 1; }
    int prod = 0;
    int a = 0;
    for (a = 0; a < 3; a = a + 1) {
        int b = 0;
        for (b = 0; b < 3; b = b + 1) { prod = prod + 1; }
    }
    if (prod == 9) { ok = ok + 1; }
    return ok;
}
