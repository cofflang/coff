int main() {
    int vals = alloc(48);
    int counts = alloc(48);
    int i = 0;
    int j = 0;
    int v = 0;
    int r = 0;
    gb = alloc(8);
    gp = alloc(sizeof(F));
    gq = alloc(sizeof(F));
    store64(vals, 0);
    store64(vals + 8, 1);
    store64(vals + 16, 0 - 1);
    store64(vals + 24, 255);
    store64(vals + 32, 256);
    store64(vals + 40, -9223372036854775808);
    store64(counts, 0);
    store64(counts + 8, 1);
    store64(counts + 16, 63);
    store64(counts + 24, 64);
    store64(counts + 32, 65);
    store64(counts + 40, 0 - 1);
    for (i = 0; i < 6; i += 1) {
        v = load64(vals + i * 8);
        for (j = 0; j < 6; j += 1) {
            r = load64(vals + j * 8);
            tr_add(v, r); ts_add(v, r); tg_add(v, r); ti_add(v, r); tf_add(v, r);
            tr_sub(v, r); ts_sub(v, r); tg_sub(v, r); ti_sub(v, r); tf_sub(v, r);
            tr_mul(v, r); ts_mul(v, r); tg_mul(v, r); ti_mul(v, r); tf_mul(v, r);
            if (r != 0 && (v != -9223372036854775808 || r != 0 - 1)) {
                tr_div(v, r); ts_div(v, r); tg_div(v, r); ti_div(v, r); tf_div(v, r);
            }
            if (r != 0 && (v != -9223372036854775808 || r != 0 - 1)) {
                tr_mod(v, r); ts_mod(v, r); tg_mod(v, r); ti_mod(v, r); tf_mod(v, r);
            }
            tr_and(v, r); ts_and(v, r); tg_and(v, r); ti_and(v, r); tf_and(v, r);
            tr_or(v, r); ts_or(v, r); tg_or(v, r); ti_or(v, r); tf_or(v, r);
            tr_xor(v, r); ts_xor(v, r); tg_xor(v, r); ti_xor(v, r); tf_xor(v, r);
            r = load64(counts + j * 8);
            tr_shl(v, r); ts_shl(v, r); tg_shl(v, r); ti_shl(v, r); tf_shl(v, r);
            tr_shr(v, r); ts_shr(v, r); tg_shr(v, r); ti_shr(v, r); tf_shr(v, r);
        }
    }
    int b = gb;
    store8(b + 1, 200);
    b[1] += 300;
    if (b[1] != 244) { bad += 1; }
    store8(b + 1, 0x9c);
    b[1] <<= 4;
    if (b[1] != 0xc0) { bad += 1; }
    store8(b + 1, 0xff);
    b[1] >>= 1;
    if (b[1] != 0x7f) { bad += 1; }
    if (bad == 0) { return 42; }
    return bad;
}
