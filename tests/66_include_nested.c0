// Transitive include: this file includes include_fixtures/mid.c0,
// which itself includes include_fixtures/deep.c0. Proves both that
// includes nest, and that a file's include paths resolve relative to
// its own directory: mid.c0 says `include "deep.c0";`, not
// `include "include_fixtures/deep.c0";`, and still finds it from here.
include "include_fixtures/mid.c0";

int main() {
    return mid_val();
}
