// Purpose: this file IS the compiler. Lexer, parser, resolver and code
// generator in one file; the binary built from it is called coff1.
// Called as `coff1 input.c0 output.s` it reads and writes real files;
// with no arguments it reads stdin and writes stdout (the form the
// differential test harness uses).
//
// The output is byte-for-byte identical to what coff0 produces for the
// same input. On any lex, parse or resolve error it prints an error
// sentinel and exits 1, same rule as coff0: nothing is emitted until
// the whole program is known to be valid.
//
// Verified as a real bootstrap fixpoint: coff0 compiling coff.c0
// (stage 1) and coff.c0 compiling itself (stage 2) produce identical
// assembly, and stage 2 compiling coff.c0 again (stage 3) matches
// stage 2. See the fixpoint checks in run_tests.sh.
// Token record: 32 bytes — 0 kind, 8 ival, 16 name ptr, 24 len. Same as
// parse.c0.
// Token kinds: 1 NUM, 2 IDENT, 3 STR, 4 PLUS, 5 MINUS, 6 STAR, 7 SLASH,
//   8 ASSIGN, 9 EQ, 10 NE, 11 LT, 12 LE, 13 GT, 14 GE, 15 LPAREN,
//   16 RPAREN, 17 LBRACE, 18 RBRACE, 19 SEMI, 20 COMMA, 21 INT, 22 IF,
//   23 ELSE, 24 WHILE, 25 RETURN, 26 EOF, 27 AND, 28 OR, 29 BREAK, 30 CONTINUE,
//   31 LBRACKET, 32 RBRACKET, 33 VOID, 34 EXTERN.
//
// AST node: 72 bytes (parse.c0's 64-byte record plus one more slot) —
//   0 kind, 8 ival, 16 name/str ptr, 24 str len,
//   32 child1 (lhs/cond/args/body), 40 child2 (rhs/then), 48 child3 (else),
//   56 next sibling, 64 extra (VAR/ASSIGN: is_global flag; STR: string
//   table index, assigned at parse time so numbering matches coff0's).
// Node kinds: same numbering as parse.c0 (1 NUM .. 22 BLOCK), plus
//   23 AND, 24 OR (both short-circuiting; precedence between equality and
//   the statement grammar, || loosest of the two), 25 BREAK, 26 CONTINUE
//   (both only valid inside a while loop — resolve() enforces this),
//   27 INDEX (child1=base, child2=index; buf[i] sugar over load8(buf+i)),
//   28 INDEXASSIGN (child1=base, child2=index, child3=value),
//   29 FUNCREF (a VAR node (kind 3) whose name turned out to be a declared
//   function rather than a variable/global -- resolve() rewrites its kind
//   in place; evaluates to the function's address via `lea`). The extra
//   field (offset 64) is also reused for CALL nodes (kind 6): 1 means this
//   call's `name` is a variable holding a function-reference value rather
//   than a declared function, so gen_call must call *through* its value
//   instead of calling `name` directly (indirect call).
//
// Function record: 104 bytes (parse.c0's 96-byte record plus stack_size) —
//   0 name, 8 nparams, 16+8i param names for the first 6 (register-passed),
//   64 body, 72 next, 80 stack_size (filled in by resolve_function),
//   88 is_void (1 if declared "void" instead of "int" -- may not return a
//   value), 96 extra_params (head of a linked list for the 7th param
//   onward, stack-passed; max 16 total params). Extra-param node: 16
//   bytes — 0 name, 8 next.
// Global record: 24 bytes — 0 name, 8 init, 16 next. Same as parse.c0.
//
// Layout/LayoutField records are declared as real `layout` blocks below,
// not hand-offset comments like the records above -- dogfooding the
// feature itself into the compiler that implements it, same as every
// other feature has been dogfooded back in once landed and verified. The
// field order (name, next, fields) is deliberate, not alphabetical: both
// layouts declare `name` first and `next` second, so the two agree on
// `next`'s position (offset 8) despite Layout having a third field
// LayoutField does not -- the shared-field-offset-table rule (see
// field_declare_or_check below) would otherwise reject two record shapes
// that disagree on where their own `next` pointer lives.

layout LayoutField {
    int name;
    int next;
}

layout Layout {
    int name;
    int next;
    int fields;
}

// Token's third field is named `sval` rather than `name` -- it holds an
// identifier's text or a decoded string literal's bytes, a different role
// than Layout/LayoutField/Global/Function's own first-field `name`, which
// already claims offset 0 in the shared field table. `kind`/`ival`/`len`
// were free (no earlier layout used them).
layout Token {
    int kind;
    int ival;
    int sval;
    int len;
}

// `next` comes before `init` (not the source order name/init/next you'd
// naively expect) so it lands at offset 8, matching Layout/LayoutField's
// own `next` -- same field-table-conflict reasoning as those two.
layout Global {
    int name;
    int next;
    int init;
}

// The inline 6-slot register-param array (originally offset 16, indexed at
// runtime as f+16+i*8 by param_name_at) has no field names of its own --
// `layout` has no notion of an array-shaped field, so it cannot be declared
// here. Reordered to put it LAST (p0..p5) instead of in its original
// middle position, so every other field can get a real name without
// leaving an unrepresentable gap; param_name_at's own i<6 case now reads
// from a fixed base of 56 instead of 16. `fnext` (not `next`) since
// Function's own list-link naturally falls at offset 24 here, not 8 --
// forcing it to 8 would mean moving `nparams` (read far more often) out
// of its natural early position for no real benefit.
layout Function {
    int name;
    int nparams;
    int body;
    int fnext;
    int stack_size;
    int is_void;
    int extra_params;
    int p0;
    int p1;
    int p2;
    int p3;
    int p4;
    int p5;
}

// The 7th-parameter-onward linked list. Same (name, next) shape as
// LayoutField -- declared separately anyway, purely for self-documentation
// at each use site, not because the field table treats it any differently.
layout ExtraParam {
    int name;
    int next;
}

// AST node. `sval`/`len` match Token's own field names (offsets 16/24) on
// purpose -- both hold "an identifier's or string's text/length," the
// same role in both records, so there was no reason to invent different
// names once Token had already claimed them. `child1`/`child2`/`child3`
// stay generic (not `lhs`/`rhs`/`cond`/`then`) because a single flat node
// shape serves every node kind -- child1 means lhs for a binary op, cond
// for an if, the args-list head for a call, depending on `kind`; a more
// "specific"-looking name would be accurate for some kinds and misleading
// for others. `sibling` (not `next`) since offset 56 does not match
// Layout/LayoutField/Global's `next`=8. `extra` is reused per-kind, same
// as before (VAR/ASSIGN is_global flag, STR string-table index, CALL's
// direct/indirect-call marker).
layout Node {
    int kind;
    int ival;
    int sval;
    int len;
    int child1;
    int child2;
    int child3;
    int sibling;
    int extra;
}

int toks = 0;
int tpos = 0;

int fhead = 0;
int ghead = 0;
int ehead = 0;
int etail = 0;
int lhead = 0;
int ltail = 0;

int sym_names = 0;
int sym_offsets = 0;
int sym_count = 0;
int stack_size = 0;
int loop_depth = 0;
int current_fn_is_void = 0;

int scope_marks = 0;
int scope_depth = 0;

int string_ptrs = 0;
int string_lens = 0;
int string_count = 0;

int label_count = 0;
int current_ret_label = 0;

int loop_labels = 0;
int gen_loop_depth = 0;

int outfd = 1;

// --- raw-bytes emission mode ---
// When raw_mode is 1, codegen emits x86-64 machine code instead of assembly
// text.  The output is a flat binary: code, then string data, then globals.
// Function labels and call sites are tracked for post-codegen patching.
int raw_mode = 0;
int elf_mode = 0;   // --elf: emit ELF64 targeting Moonshot (implies raw_mode)
int raw_buf  = 0;   // alloc'd buffer for raw bytes

// ELF64 constants for the Moonshot ring-3 ABI.  The file is loaded at
// USER_VIRT_BASE (2 GB) by the kernel's ELF loader; the entry point sits
// at USER_VIRT_BASE + ELF_HDR_SIZE + ELF_PHDR_SIZE (past both headers).
int ELF_HDR_SIZE  = 64;
int ELF_PHDR_SIZE = 56;
int ELF_USER_VIRT_BASE = 0x80000000;
int raw_pos  = 0;   // current write offset in raw_buf
int raw_cap  = 0;   // allocated capacity
// Sized with real headroom rather than "exactly enough for today": label ids
// come from one flat, never-reset counter shared by every if/while/&&/||/
// print in the whole program, so a moderately large program reaches numbers
// far above the old 256. Overflowing either table now errors loudly (see
// raw_label / raw_je) instead of silently producing wrong jumps.
int RAW_LABEL_CAP = 8192;
int RAW_PATCH_CAP = 16384;
int raw_labels    = 0;  // label → byte-offset map (RAW_LABEL_CAP slots × 8 bytes)
int raw_patches   = 0;  // pending patch records (RAW_PATCH_CAP slots × 16 bytes: pos, label_id)
int raw_patch_count = 0;
int raw_funcs     = 0;  // function-name → byte-offset map (256 slots × 16 bytes: name_ptr, offset)
int raw_func_count = 0;
int raw_pending_calls = 0;  // pending call patches (256 slots × 16 bytes: pos, name_ptr)
int raw_pending_call_count = 0;

// Include-expansion state -- see the "includes" section below (right
// after copy_bytes/streq) for the real logic; these are just the shared
// globals it needs across recursive calls.
int INCLUDE_MAX_DEPTH = 32;
int include_stack = 0; // alloc'd once, INCLUDE_MAX_DEPTH * 8 bytes
int include_depth = 0;
int EXPAND_CAP = 4194304; // 4MB
int expand_buf = 0;
int expand_len = 0;

// --- shared helpers (same as parse.c0) -------------------------------------

int strlen_(int s) {
    int i = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

// All generated-assembly output goes through emit() rather than the print()
// builtin, since print() always targets stdout — emit() targets outfd, which
// main() points at the -o file when one is given (see the CLI handling at
// the top of main), or stdout otherwise.
void emit(int s) {
    write(outfd, s, strlen_(s));
    return;
}

int is_digit(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

int is_hex_digit(int c) {
    if (is_digit(c) == 1) { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int hex_value(int c) {
    if (is_digit(c) == 1) { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

int is_ident_start(int c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

int is_ident_char(int c) {
    if (is_digit(c) == 1) { return 1; }
    return is_ident_start(c);
}

void print_int(int v) {
    int tmp = alloc(32);
    int neg = 0;
    int i = 31;
    if (v == 0) { emit("0"); return; }
    if (v < 0) { neg = 1; v = 0 - v; }
    while (v > 0) {
        i = i - 1;
        tmp[i] = '0' + (v - (v / 10) * 10);
        v = v / 10;
    }
    if (neg == 1) { i = i - 1; tmp[i] = '-'; }
    emit(tmp + i);
    return;
}

// --- raw-bytes emitter ---------------------------------------------------------
// When raw_mode is 1, codegen calls these instead of emit().  The output is
// accumulated in raw_buf and flushed to outfd at the end.

void raw_init() {
    raw_cap = 65536;  // 64 KB initial buffer
    raw_buf = alloc(raw_cap);
    raw_pos = 0;
    raw_labels  = alloc(RAW_LABEL_CAP * 8);
    raw_patches = alloc(RAW_PATCH_CAP * 16);
    raw_patch_count = 0;
    raw_funcs   = alloc(256 * 16);  // 256 functions (name_ptr, offset)
    raw_func_count = 0;
    raw_pending_calls = alloc(256 * 16);  // 256 pending calls (pos, name_ptr)
    raw_pending_call_count = 0;
    // Mark all labels as undefined (-1).
    int i = 0;
    while (i < RAW_LABEL_CAP) {
        store64(raw_labels + i * 8, -1);
        i = i + 1;
    }
    return;
}

void raw_ensure(int n) {
    if (raw_pos + n <= raw_cap) { return; }
    int new_cap = raw_cap * 2;
    int new_buf = alloc(new_cap);
    int i = 0;
    while (i < raw_pos) {
        store8(new_buf + i, load8(raw_buf + i));
        i = i + 1;
    }
    raw_buf = new_buf;
    raw_cap = new_cap;
    return;
}

void raw_byte(int b) {
    raw_ensure(1);
    store8(raw_buf + raw_pos, b);
    raw_pos = raw_pos + 1;
    return;
}

void raw_int32(int v) {
    raw_ensure(4);
    // Convert to unsigned for correct byte extraction with negative values.
    int u = v;
    if (u < 0) { u = u + 65536 * 65536; }  // + 2^32
    store8(raw_buf + raw_pos, u - (u / 256) * 256);
    store8(raw_buf + raw_pos + 1, (u / 256) - (u / 65536) * 256);
    store8(raw_buf + raw_pos + 2, (u / 65536) - (u / 16777216) * 256);
    store8(raw_buf + raw_pos + 3, u / 16777216);
    raw_pos = raw_pos + 4;
    return;
}

// Record the current raw_pos as label `id`.
//
// Overflowing the table used to `return` silently, which does not drop the
// jump -- raw_patch_all still patches it, against a label that was never
// recorded, so the program compiles "successfully" and jumps somewhere
// wrong at runtime. Silently emitting incorrect code is the worst failure
// mode available here, so this is a loud error instead.
void raw_label(int id) {
    if (id < 0 || id >= RAW_LABEL_CAP) { cerr(); }
    store64(raw_labels + id * 8, raw_pos);
    return;
}

// je rel32 to label `id`.  Emits placeholder; patched by raw_patch_all().
void raw_je(int id) {
    if (raw_patch_count >= RAW_PATCH_CAP) { cerr(); }
    raw_ensure(6);
    store8(raw_buf + raw_pos, 0x0F); raw_pos = raw_pos + 1;
    store8(raw_buf + raw_pos, 0x84); raw_pos = raw_pos + 1;
    store64(raw_patches + raw_patch_count * 16, raw_pos);
    store64(raw_patches + raw_patch_count * 16 + 8, id);
    raw_patch_count = raw_patch_count + 1;
    raw_pos = raw_pos + 4;  // 4-byte placeholder offset
    return;
}

// jne rel32 to label `id`.
void raw_jne(int id) {
    if (raw_patch_count >= RAW_PATCH_CAP) { cerr(); }
    raw_ensure(6);
    store8(raw_buf + raw_pos, 0x0F); raw_pos = raw_pos + 1;
    store8(raw_buf + raw_pos, 0x85); raw_pos = raw_pos + 1;
    store64(raw_patches + raw_patch_count * 16, raw_pos);
    store64(raw_patches + raw_patch_count * 16 + 8, id);
    raw_patch_count = raw_patch_count + 1;
    raw_pos = raw_pos + 4;
    return;
}

// jmp rel32 to label `id`.
void raw_jmp(int id) {
    if (raw_patch_count >= RAW_PATCH_CAP) { cerr(); }
    raw_ensure(5);
    store8(raw_buf + raw_pos, 0xE9); raw_pos = raw_pos + 1;
    store64(raw_patches + raw_patch_count * 16, raw_pos);
    store64(raw_patches + raw_patch_count * 16 + 8, id);
    raw_patch_count = raw_patch_count + 1;
    raw_pos = raw_pos + 4;
    return;
}

// call function by name.  If the function position is already known, compute
// the offset directly.  Otherwise record for post-codegen patching.
void raw_call(int name) {
    int found = 0;
    int target = 0;
    int fi = 0;
    while (fi < raw_func_count) {
        if (streq(load64(raw_funcs + fi * 16), name) == 1) {
            target = load64(raw_funcs + fi * 16 + 8);
            found = 1;
            break;
        }
        fi = fi + 1;
    }
    raw_ensure(5);
    store8(raw_buf + raw_pos, 0xE8); raw_pos = raw_pos + 1;
    if (found == 1) {
        int off = target - (raw_pos + 4);
        raw_int32(off);
        raw_pos = raw_pos - 4;  // raw_int32 advanced it — back up
        raw_int32(off);          // and re-emit
    } else {
        // Record for patching.
        store64(raw_pending_calls + raw_pending_call_count * 16, raw_pos);
        store64(raw_pending_calls + raw_pending_call_count * 16 + 8, name);
        raw_pending_call_count = raw_pending_call_count + 1;
        raw_pos = raw_pos + 4;  // placeholder
    }
    return;
}

// Record function `name` at the current position.
void raw_func_def(int name) {
    if (raw_func_count >= 256) { return; }
    store64(raw_funcs + raw_func_count * 16, name);
    store64(raw_funcs + raw_func_count * 16 + 8, raw_pos);
    raw_func_count = raw_func_count + 1;
    return;
}

// Resolve all pending label patches and call patches.
void raw_patch_all() {
    // Patch labels.
    int pi = 0;
    while (pi < raw_patch_count) {
        int patch_pos = load64(raw_patches + pi * 16);
        int label_id  = load64(raw_patches + pi * 16 + 8);
        int target = load64(raw_labels + label_id * 8);
        int offset = target - (patch_pos + 4);
        // Convert to unsigned 32-bit for byte extraction (c0's / truncates
        // toward 0, which corrupts negative offsets' high bytes).
        int u = offset;
        if (u < 0) { u = u + 65536 * 65536; }
        store8(raw_buf + patch_pos, u - (u / 256) * 256);
        store8(raw_buf + patch_pos + 1,
               (u / 256) - (u / 65536) * 256);
        store8(raw_buf + patch_pos + 2,
               (u / 65536) - (u / 16777216) * 256);
        store8(raw_buf + patch_pos + 3, u / 16777216);
        pi = pi + 1;
    }
    // Patch function calls.
    pi = 0;
    while (pi < raw_pending_call_count) {
        int patch_pos = load64(raw_pending_calls + pi * 16);
        int name      = load64(raw_pending_calls + pi * 16 + 8);
        int target = 0;
        int found_call = 0;
        int fi = 0;
        while (fi < raw_func_count) {
            if (streq(load64(raw_funcs + fi * 16), name) == 1) {
                target = load64(raw_funcs + fi * 16 + 8);
                found_call = 1;
                break;
            }
            fi = fi + 1;
        }
        if (found_call == 1) {
            int offset = target - (patch_pos + 4);
            int u = offset;
            if (u < 0) { u = u + 65536 * 65536; }
            store8(raw_buf + patch_pos, u - (u / 256) * 256);
            store8(raw_buf + patch_pos + 1,
                   (u / 256) - (u / 65536) * 256);
            store8(raw_buf + patch_pos + 2,
                   (u / 65536) - (u / 16777216) * 256);
            store8(raw_buf + patch_pos + 3, u / 16777216);
        }
        pi = pi + 1;
    }
    return;
}

// Write the accumulated raw buffer to outfd.
void raw_flush() {
    write(outfd, raw_buf, raw_pos);
    return;
}

// --- ELF64 header emission (--elf mode, Moonshot ring-3 ABI) ---------------
// Builds a 120-byte header (64-byte ELF header + one 56-byte PT_LOAD phdr) in
// an alloc'd buffer and writes it to outfd.  p_offset=0 so the entire file
// (headers + code) is loaded at ELF_USER_VIRT_BASE; e_entry points to
// USER_VIRT_BASE + 120, right past both headers where _start lives.

void elf_hdr_byte(int buf, int pos, int b) {
    store8(buf + pos, b);
}

void elf_hdr_int16(int buf, int pos, int v) {
    int u = v; if (u < 0) { u = u + 65536; }
    elf_hdr_byte(buf, pos,     u - (u / 256) * 256);
    elf_hdr_byte(buf, pos + 1, u / 256);
}

void elf_hdr_int32(int buf, int pos, int v) {
    int u = v; if (u < 0) { u = u + 65536 * 65536; }
    elf_hdr_byte(buf, pos,     u - (u / 256) * 256);
    elf_hdr_byte(buf, pos + 1, (u / 256) - (u / 65536) * 256);
    elf_hdr_byte(buf, pos + 2, (u / 65536) - (u / 16777216) * 256);
    elf_hdr_byte(buf, pos + 3, u / 16777216);
}

void elf_hdr_int64(int buf, int pos, int v) {
    int hi = v / 65536 / 65536;
    int lo = v - hi * 65536 * 65536;
    elf_hdr_int32(buf, pos, lo);
    elf_hdr_int32(buf, pos + 4, hi);
}

void elf_emit_header() {
    int total = ELF_HDR_SIZE + ELF_PHDR_SIZE + raw_pos;
    int entry = ELF_USER_VIRT_BASE + ELF_HDR_SIZE + ELF_PHDR_SIZE;
    int hdr = alloc(120);
    int i = 0;
    while (i < 120) { store8(hdr + i, 0); i = i + 1; }

    // e_ident magic
    elf_hdr_byte(hdr, 0, 0x7F);
    elf_hdr_byte(hdr, 1, 'E'); elf_hdr_byte(hdr, 2, 'L'); elf_hdr_byte(hdr, 3, 'F');
    elf_hdr_byte(hdr, 4, 2);   // ELFCLASS64
    elf_hdr_byte(hdr, 5, 1);   // ELFDATA2LSB
    elf_hdr_byte(hdr, 6, 1);   // EV_CURRENT
    // bytes 7-15 stay zero (OSABI, ABIVERSION, padding)

    elf_hdr_int16(hdr, 16, 2);   // e_type = ET_EXEC
    elf_hdr_int16(hdr, 18, 62);  // e_machine = EM_X86_64
    elf_hdr_int32(hdr, 20, 1);   // e_version
    elf_hdr_int64(hdr, 24, entry);  // e_entry
    elf_hdr_int64(hdr, 32, 64);     // e_phoff (right after ELF header)
    elf_hdr_int64(hdr, 40, 0);      // e_shoff (no section headers)
    elf_hdr_int32(hdr, 48, 0);      // e_flags
    elf_hdr_int16(hdr, 52, 64);     // e_ehsize
    elf_hdr_int16(hdr, 54, 56);     // e_phentsize
    elf_hdr_int16(hdr, 56, 1);      // e_phnum = 1
    elf_hdr_int16(hdr, 58, 0);      // e_shentsize
    elf_hdr_int16(hdr, 60, 0);      // e_shnum
    elf_hdr_int16(hdr, 62, 0);      // e_shstrndx

    // PT_LOAD program header at offset 64
    elf_hdr_int32(hdr, 64, 1);   // p_type = PT_LOAD
    elf_hdr_int32(hdr, 68, 5);   // p_flags = PF_R | PF_X
    elf_hdr_int64(hdr, 72, 0);   // p_offset (load entire file)
    elf_hdr_int64(hdr, 80, ELF_USER_VIRT_BASE);  // p_vaddr
    elf_hdr_int64(hdr, 88, ELF_USER_VIRT_BASE);  // p_paddr
    elf_hdr_int64(hdr, 96, total);   // p_filesz
    elf_hdr_int64(hdr, 104, total);  // p_memsz
    elf_hdr_int64(hdr, 112, 4096);   // p_align

    write(outfd, hdr, 120);
}

int word_is(int buf, int start, int len, int kw) {
    int i = 0;
    int k = 0;
    while (i < len) {
        k = kw[i];
        if (k == 0) { return 0; }
        if (buf[start + i] != k) { return 0; }
        i = i + 1;
    }
    if (kw[len] != 0) { return 0; }
    return 1;
}

int copy_bytes(int buf, int start, int len) {
    int p = alloc(len + 1);
    int i = 0;
    while (i < len) {
        p[i] = buf[start + i];
        i = i + 1;
    }
    return p;
}

// Both sides are null-terminated byte pointers (identifiers and string
// literals are always alloc'd fresh, hence zero-terminated).
int streq(int a, int b) {
    int i = 0;
    int going = 1;
    int result = 0;
    int ca = 0;
    int cb = 0;
    while (going == 1) {
        ca = a[i];
        cb = b[i];
        if (ca != cb) { going = 0; }
        else if (ca == 0) { going = 0; result = 1; }
        else { i = i + 1; }
    }
    return result;
}

// -------------------------------------------------------------- includes
//
// `include "path.c0";` is pure textual substitution, resolved entirely
// before real lexing starts -- mirrors coff0.c's resolve_includes exactly
// (differentially verified against it, and against lex.c0/parse.c0's own
// identical mirrors), see coff0.c for the full design rationale. This is
// the load-bearing copy: coff.c0 is what coff1 actually is, the compiler
// my OS kernel is built with.

// Directory portion of `path` (a null-terminated string), trailing slash
// included so callers can concatenate directly, or a fresh empty string
// if `path` has no slash (same-directory relative resolution).
int dirname_with_slash(int path) {
    int len = strlen_(path);
    int i = len - 1;
    while (i >= 0) {
        if (load8(path + i) == '/') {
            return copy_bytes(path, 0, i + 1);
        }
        i = i - 1;
    }
    int empty = alloc(1);
    store8(empty, 0);
    return empty;
}

int join_path(int dir, int rel) {
    int dl = strlen_(dir);
    int rl = strlen_(rel);
    int out = alloc(dl + rl + 1);
    int i = 0;
    while (i < dl) {
        store8(out + i, load8(dir + i));
        i = i + 1;
    }
    int j = 0;
    while (j < rl) {
        store8(out + dl + j, load8(rel + j));
        j = j + 1;
    }
    store8(out + dl + rl, 0);
    return out;
}

void expand_putc(int c) {
    if (expand_len >= EXPAND_CAP) {
        print("PARSEERROR\n");
        exit(1);
    }
    store8(expand_buf + expand_len, c);
    expand_len = expand_len + 1;
    return;
}

// Reads `path`, scans its raw text for `include "X";` directives (copying
// everything else through unchanged, including string literals, char
// literals, and // comments verbatim so none of them can trigger a false
// match), and recursively expands each include in place -- appending the
// result into the shared expand_buf/expand_len globals. include_stack/
// include_depth guard against a file including itself, directly or
// transitively. Char literals get the SAME verbatim-copy treatment as
// strings deliberately, not as an afterthought: without it, a literal
// like '"' makes the scanner wrongly enter STRING mode at that bare `"`
// instead, scanning forward to whatever `"` happens to appear next in the
// file -- a real bug found building lex.c0's identical mirror of this
// function (which itself contains `!= '"'`).
void expand_file(int path) {
    int i = 0;
    while (i < include_depth) {
        if (streq(load64(include_stack + i * 8), path) == 1) {
            print("PARSEERROR\n");
            exit(1);
        }
        i = i + 1;
    }
    if (include_depth >= INCLUDE_MAX_DEPTH) {
        print("PARSEERROR\n");
        exit(1);
    }
    store64(include_stack + include_depth * 8, path);
    include_depth = include_depth + 1;

    int fd = open_read(path);
    if (fd < 0) {
        print("PARSEERROR\n");
        exit(1);
    }
    int src = alloc(1048576);
    int n = 0;
    int got = read(fd, src, 1048576);
    while (got > 0) {
        n = n + got;
        got = read(fd, src + n, 1048576 - n);
    }
    close(fd);

    int dir = dirname_with_slash(path);
    int p = 0;
    while (p < n) {
        int c = load8(src + p);
        if (c == '"') {
            expand_putc(c);
            p = p + 1;
            int scanning = 1;
            while (scanning == 1) {
                if (p >= n || load8(src + p) == '"') { scanning = 0; }
                else {
                    int sc = load8(src + p);
                    if (sc == '\\' && p + 1 < n) {
                        expand_putc(sc);
                        p = p + 1;
                        expand_putc(load8(src + p));
                        p = p + 1;
                    } else {
                        expand_putc(sc);
                        p = p + 1;
                    }
                }
            }
            if (p < n) { expand_putc('"'); p = p + 1; }
        } else if (c == '\'') {
            expand_putc(c);
            p = p + 1;
            if (p < n && load8(src + p) == '\\' && p + 1 < n) {
                expand_putc(load8(src + p));
                p = p + 1;
                expand_putc(load8(src + p));
                p = p + 1;
            } else if (p < n) {
                expand_putc(load8(src + p));
                p = p + 1;
            }
            if (p < n && load8(src + p) == '\'') {
                expand_putc('\'');
                p = p + 1;
            }
        } else if (c == '/' && p + 1 < n && load8(src + p + 1) == '/') {
            while (p < n && load8(src + p) != '\n') {
                expand_putc(load8(src + p));
                p = p + 1;
            }
        } else if (is_ident_start(c) == 1) {
            int start = p;
            while (p < n && is_ident_char(load8(src + p)) == 1) {
                p = p + 1;
            }
            int wlen = p - start;
            if (wlen == 7 && word_is(src, start, 7, "include") == 1) {
                int q = p;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q = q + 1;
                }
                if (q >= n || load8(src + q) != '"') { print("PARSEERROR\n"); exit(1); }
                q = q + 1;
                int pstart = q;
                while (q < n && load8(src + q) != '"') { q = q + 1; }
                if (q >= n) { print("PARSEERROR\n"); exit(1); }
                int rel = copy_bytes(src, pstart, q - pstart);
                q = q + 1;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q = q + 1;
                }
                if (q >= n || load8(src + q) != ';') { print("PARSEERROR\n"); exit(1); }
                q = q + 1;
                expand_file(join_path(dir, rel));
                p = q;
            } else {
                int k = start;
                while (k < p) {
                    expand_putc(load8(src + k));
                    k = k + 1;
                }
            }
        } else {
            expand_putc(c);
            p = p + 1;
        }
    }

    include_depth = include_depth - 1;
    return;
}

void perr() {
    print("PARSEERROR\n");
    exit(1);
    return;
}

void cerr() {
    print("CODEGENERROR\n");
    exit(1);
    return;
}

void tok_put(int i, int kind, int ival, int name, int len) {
    int p = toks + i * sizeof(Token);
    p.kind = kind;
    p.ival = ival;
    p.sval = name;
    p.len = len;
    return;
}

int tok_kind(int i) { return (toks + i * sizeof(Token)).kind; }
int tok_ival(int i) { return (toks + i * sizeof(Token)).ival; }
int tok_name(int i) { return (toks + i * sizeof(Token)).sval; }
int tok_len(int i)  { return (toks + i * sizeof(Token)).len; }

// Lex all of buf[0..n) into the global token array; appends an EOF token.
void lex_all(int buf, int n) {
    int pos = 0;
    int t = 0;
    int c = 0;
    int nxt = 0;
    int going = 0;
    int v = 0;
    int d = 0;
    int start = 0;
    int len = 0;
    int s = 0;
    int e = 0;
    int q = 0;
    int name = 0;
    int sbuf = 0;
    int slen = 0;
    int base = 0;
    int is_hex = 0;

    toks = alloc((n + 2) * sizeof(Token));

    while (pos < n) {
        c = load8(buf + pos);

        if (c == ' ') { pos = pos + 1; }
        else if (c == '\n') { pos = pos + 1; }
        else if (c == '\t') { pos = pos + 1; }
        else if (c == 13) { pos = pos + 1; }

        else if (c == '/') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '/') {
                going = 1;
                while (going == 1) {
                    if (pos < n) {
                        if (load8(buf + pos) != '\n') { pos = pos + 1; }
                        else { going = 0; }
                    } else { going = 0; }
                }
            } else {
                tok_put(t, 7, 0, 0, 0);
                t = t + 1;
                pos = pos + 1;
            }
        }

        else if (is_digit(c) == 1) {
            v = 0;
            base = 10;
            is_hex = 0;
            if (c == '0' && pos + 2 < n) {
                nxt = load8(buf + pos + 1);
                if ((nxt == 'x' || nxt == 'X') && is_hex_digit(load8(buf + pos + 2)) == 1) {
                    is_hex = 1;
                }
            }
            if (is_hex == 1) { pos = pos + 2; base = 16; }
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    d = load8(buf + pos);
                    if (base == 16) {
                        if (is_hex_digit(d) == 1) {
                            v = v * 16 + hex_value(d);
                            pos = pos + 1;
                        } else { going = 0; }
                    } else if (is_digit(d) == 1) {
                        v = v * 10 + (d - '0');
                        pos = pos + 1;
                    } else { going = 0; }
                } else { going = 0; }
            }
            tok_put(t, 1, v, 0, 0);
            t = t + 1;
        }

        else if (is_ident_start(c) == 1) {
            start = pos;
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    if (is_ident_char(load8(buf + pos)) == 1) { pos = pos + 1; }
                    else { going = 0; }
                } else { going = 0; }
            }
            len = pos - start;
            if (word_is(buf, start, len, "int") == 1) { tok_put(t, 21, 0, 0, 0); }
            else if (word_is(buf, start, len, "if") == 1) { tok_put(t, 22, 0, 0, 0); }
            else if (word_is(buf, start, len, "else") == 1) { tok_put(t, 23, 0, 0, 0); }
            else if (word_is(buf, start, len, "while") == 1) { tok_put(t, 24, 0, 0, 0); }
            else if (word_is(buf, start, len, "return") == 1) { tok_put(t, 25, 0, 0, 0); }
            else if (word_is(buf, start, len, "break") == 1) { tok_put(t, 29, 0, 0, 0); }
            else if (word_is(buf, start, len, "continue") == 1) { tok_put(t, 30, 0, 0, 0); }
            else if (word_is(buf, start, len, "void") == 1) { tok_put(t, 33, 0, 0, 0); }
            else if (word_is(buf, start, len, "extern") == 1) { tok_put(t, 34, 0, 0, 0); }
            else if (word_is(buf, start, len, "layout") == 1) { tok_put(t, 36, 0, 0, 0); }
            else if (word_is(buf, start, len, "sizeof") == 1) { tok_put(t, 37, 0, 0, 0); }
            else {
                name = copy_bytes(buf, start, len);
                tok_put(t, 2, 0, name, len);
            }
            t = t + 1;
        }

        else if (c == '"') {
            pos = pos + 1;
            sbuf = alloc(n + 1);
            slen = 0;
            going = 1;
            while (going == 1) {
                if (pos >= n) { perr(); }
                s = load8(buf + pos);
                if (s == '"') {
                    going = 0;
                    pos = pos + 1;
                } else if (s == '\\') {
                    pos = pos + 1;
                    if (pos >= n) { perr(); }
                    e = load8(buf + pos);
                    v = 0 - 1;
                    if (e == 'n') { v = '\n'; }
                    if (e == 't') { v = '\t'; }
                    if (e == '\\') { v = '\\'; }
                    if (e == '"') { v = '"'; }
                    if (v < 0) { perr(); }
                    store8(sbuf + slen, v);
                    slen = slen + 1;
                    pos = pos + 1;
                } else {
                    store8(sbuf + slen, s);
                    slen = slen + 1;
                    pos = pos + 1;
                }
            }
            tok_put(t, 3, 0, sbuf, slen);
            t = t + 1;
        }

        else if (c == '\'') {
            pos = pos + 1;
            if (pos >= n) { perr(); }
            v = 0 - 1;
            e = load8(buf + pos);
            if (e == '\\') {
                pos = pos + 1;
                if (pos >= n) { perr(); }
                q = load8(buf + pos);
                if (q == 'n') { v = '\n'; }
                if (q == 't') { v = '\t'; }
                if (q == '\\') { v = '\\'; }
                if (q == '\'') { v = '\''; }
                if (q == '0') { v = 0; }
                if (v < 0) {
                    if (q != '0') { perr(); }
                }
                pos = pos + 1;
            } else {
                if (e == '\'') { perr(); }
                v = e;
                pos = pos + 1;
            }
            if (pos >= n) { perr(); }
            if (load8(buf + pos) != '\'') { perr(); }
            pos = pos + 1;
            tok_put(t, 1, v, 0, 0);
            t = t + 1;
        }

        else if (c == '=') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 9, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 8, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '!') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 10, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '<') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 12, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 11, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '>') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 14, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 13, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '+') { tok_put(t, 4, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '-') { tok_put(t, 5, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '*') { tok_put(t, 6, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '(') { tok_put(t, 15, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ')') { tok_put(t, 16, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '{') { tok_put(t, 17, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '}') { tok_put(t, 18, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ';') { tok_put(t, 19, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ',') { tok_put(t, 20, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '&') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '&') { tok_put(t, 27, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '|') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '|') { tok_put(t, 28, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '[') { tok_put(t, 31, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ']') { tok_put(t, 32, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '.') { tok_put(t, 35, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else { perr(); }
    }

    tok_put(t, 26, 0, 0, 0);
    return;
}

// Name of the i'th declared parameter (0-indexed), regardless of whether it
// lives in the inline register-param slots (p0..p5, offset 56 onward -- no
// per-index field name exists for a runtime-variable i, so this part stays
// raw pointer arithmetic) or the extra_params list.
int param_name_at(int f, int i) {
    int p = 0;
    int k = 0;
    if (i < 6) { return load64(f + 56 + i * 8); }
    p = f.extra_params;
    k = i - 6;
    while (k > 0) {
        p = p.next;
        k = k - 1;
    }
    return p.name;
}

// --- parser (builds 72-byte nodes; registers string literals as it goes) --

int new_node(int kind) {
    int p = alloc(sizeof(Node));
    p.kind = kind;
    return p;
}

void expect(int k) {
    if (tok_kind(tpos) != k) { perr(); }
    tpos = tpos + 1;
    return;
}

int p_primary() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int head = 0;
    int tail = 0;
    int a = 0;
    k = tok_kind(tpos);
    if (k == 15) {
        tpos = tpos + 1;
        nd = p_expr();
        expect(16);
        return nd;
    }
    if (k == 1) {
        nd = new_node(1);
        nd.ival = tok_ival(tpos);
        tpos = tpos + 1;
        return nd;
    }
    if (k == 3) {
        nd = new_node(2);
        nd.sval = tok_name(tpos);
        nd.len = tok_len(tpos);
        if (string_count >= 4096) { cerr(); }
        store64(string_ptrs + string_count * 8, tok_name(tpos));
        store64(string_lens + string_count * 8, tok_len(tpos));
        nd.extra = string_count;
        string_count = string_count + 1;
        tpos = tpos + 1;
        return nd;
    }
    if (k == 2) {
        name = tok_name(tpos);
        tpos = tpos + 1;
        if (tok_kind(tpos) == 15) {
            tpos = tpos + 1;
            nd = new_node(6);
            nd.sval = name;
            head = 0;
            tail = 0;
            if (tok_kind(tpos) != 16) {
                a = p_expr();
                head = a;
                tail = a;
                while (tok_kind(tpos) == 20) {
                    tpos = tpos + 1;
                    a = p_expr();
                    tail.sibling = a;
                    tail = a;
                }
            }
            expect(16);
            nd.child1 = head;
            return nd;
        }
        nd = new_node(3);
        nd.sval = name;
        return nd;
    }
    if (k == 37) {
        tpos = tpos + 1;
        expect(15);
        if (tok_kind(tpos) != 2) { perr(); }
        nd = new_node(32);
        nd.sval = tok_name(tpos);
        tpos = tpos + 1;
        expect(16);
        return nd;
    }
    perr();
    return 0;
}

int p_postfix() {
    int nd = 0;
    int idx = 0;
    int fld = 0;
    int going = 1;
    nd = p_primary();
    while (going == 1) {
        if (tok_kind(tpos) == 31) {
            tpos = tpos + 1;
            idx = new_node(27);
            idx.child1 = nd;
            idx.child2 = p_expr();
            expect(32);
            nd = idx;
        } else if (tok_kind(tpos) == 35) {
            tpos = tpos + 1;
            if (tok_kind(tpos) != 2) { perr(); }
            fld = new_node(30);
            fld.child1 = nd;
            fld.sval = tok_name(tpos);
            tpos = tpos + 1;
            nd = fld;
        } else { going = 0; }
    }
    return nd;
}

int p_unary() {
    int nd = 0;
    if (tok_kind(tpos) == 5) {
        tpos = tpos + 1;
        nd = new_node(17);
        nd.child1 = p_unary();
        return nd;
    }
    return p_postfix();
}

int p_term() {
    int left = 0;
    int nd = 0;
    int op = 0;
    left = p_unary();
    while (1) {
        op = tok_kind(tpos);
        if (op == 6) {
            tpos = tpos + 1;
            nd = new_node(9);
            nd.child1 = left;
            nd.child2 = p_unary();
            left = nd;
        } else if (op == 7) {
            tpos = tpos + 1;
            nd = new_node(10);
            nd.child1 = left;
            nd.child2 = p_unary();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_add() {
    int left = 0;
    int nd = 0;
    int op = 0;
    left = p_term();
    while (1) {
        op = tok_kind(tpos);
        if (op == 4) {
            tpos = tpos + 1;
            nd = new_node(7);
            nd.child1 = left;
            nd.child2 = p_term();
            left = nd;
        } else if (op == 5) {
            tpos = tpos + 1;
            nd = new_node(8);
            nd.child1 = left;
            nd.child2 = p_term();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_rel() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    left = p_add();
    while (1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 11) { kind = 13; }
        if (op == 12) { kind = 14; }
        if (op == 13) { kind = 15; }
        if (op == 14) { kind = 16; }
        if (kind > 0) {
            tpos = tpos + 1;
            nd = new_node(kind);
            nd.child1 = left;
            nd.child2 = p_add();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_equality() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    left = p_rel();
    while (1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 9) { kind = 11; }
        if (op == 10) { kind = 12; }
        if (kind > 0) {
            tpos = tpos + 1;
            nd = new_node(kind);
            nd.child1 = left;
            nd.child2 = p_rel();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_logic_and() {
    int left = 0;
    int nd = 0;
    left = p_equality();
    while (tok_kind(tpos) == 27) {
        tpos = tpos + 1;
        nd = new_node(23);
        nd.child1 = left;
        nd.child2 = p_equality();
        left = nd;
    }
    return left;
}

int p_logic_or() {
    int left = 0;
    int nd = 0;
    left = p_logic_and();
    while (tok_kind(tpos) == 28) {
        tpos = tpos + 1;
        nd = new_node(24);
        nd.child1 = left;
        nd.child2 = p_logic_and();
        left = nd;
    }
    return left;
}

int p_expr() {
    return p_logic_or();
}

int p_stmt() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int e = 0;
    int out = 0;
    k = tok_kind(tpos);
    if (k == 17) { return p_block(); }
    if (k == 21) {
        tpos = tpos + 1;
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos = tpos + 1;
        nd = new_node(5);
        nd.sval = name;
        if (tok_kind(tpos) == 8) {
            tpos = tpos + 1;
            nd.child2 = p_expr();
        }
        expect(19);
        return nd;
    }
    if (k == 22) {
        tpos = tpos + 1;
        expect(15);
        nd = new_node(18);
        nd.child1 = p_expr();
        expect(16);
        nd.child2 = p_stmt();
        if (tok_kind(tpos) == 23) {
            tpos = tpos + 1;
            nd.child3 = p_stmt();
        }
        return nd;
    }
    if (k == 24) {
        tpos = tpos + 1;
        expect(15);
        nd = new_node(19);
        nd.child1 = p_expr();
        expect(16);
        nd.child2 = p_stmt();
        return nd;
    }
    if (k == 25) {
        tpos = tpos + 1;
        nd = new_node(20);
        if (tok_kind(tpos) != 19) { nd.child1 = p_expr(); }
        expect(19);
        return nd;
    }
    if (k == 29) {
        tpos = tpos + 1;
        expect(19);
        return new_node(25);
    }
    if (k == 30) {
        tpos = tpos + 1;
        expect(19);
        return new_node(26);
    }
    // Parse a full expression first, then decide: a plain assignment
    // (VAR '=' expr), an indexed assignment (buf[i] '=' expr), or -- if
    // not followed by '=' at all -- an expression statement. Needs
    // arbitrary lookahead (buf[i] can be any length), unlike the other
    // statement forms above which dispatch on a fixed token peek.
    e = p_expr();
    if (tok_kind(tpos) == 8) {
        tpos = tpos + 1;
        if (e.kind == 3) {
            name = e.sval;
            out = new_node(4);
            out.sval = name;
            out.child2 = p_expr();
            expect(19);
            return out;
        }
        if (e.kind == 27) {
            out = new_node(28);
            out.child1 = e.child1;
            out.child2 = e.child2;
            out.child3 = p_expr();
            expect(19);
            return out;
        }
        if (e.kind == 30) {
            out = new_node(31);
            out.sval = e.sval;
            out.child1 = e.child1;
            out.child2 = p_expr();
            expect(19);
            return out;
        }
        perr();
    }
    out = new_node(21);
    out.child1 = e;
    expect(19);
    return out;
}

int p_block() {
    int nd = 0;
    int head = 0;
    int tail = 0;
    int s = 0;
    expect(17);
    nd = new_node(22);
    while (tok_kind(tpos) != 18) {
        s = p_stmt();
        if (head == 0) { head = s; tail = s; }
        else { tail.sibling = s; tail = s; }
    }
    expect(18);
    nd.child1 = head;
    return nd;
}

// --- builtins table ---------------------------------------------------------

int builtin_arity(int name) {
    if (streq(name, "print") == 1) { return 1; }
    if (streq(name, "write") == 1) { return 3; }
    if (streq(name, "read") == 1) { return 3; }
    if (streq(name, "open_read") == 1) { return 1; }
    if (streq(name, "open_write") == 1) { return 1; }
    if (streq(name, "close") == 1) { return 1; }
    if (streq(name, "alloc") == 1) { return 1; }
    if (streq(name, "load8") == 1) { return 1; }
    if (streq(name, "store8") == 1) { return 2; }
    if (streq(name, "load64") == 1) { return 1; }
    if (streq(name, "store64") == 1) { return 2; }
    if (streq(name, "exit") == 1) { return 1; }
    if (streq(name, "win_info") == 1) { return 0; }
    if (streq(name, "win_max") == 1) { return 0; }
    if (streq(name, "fill") == 1) { return 5; }
    if (streq(name, "blit") == 1) { return 5; }
    if (streq(name, "key_poll") == 1) { return 0; }
    if (streq(name, "ticks") == 1) { return 0; }
    if (streq(name, "readfile") == 1) { return 3; }
    if (streq(name, "present") == 1) { return 1; }
    if (streq(name, "argc") == 1) { return 0; }
    if (streq(name, "argv") == 1) { return 1; }
    if (streq(name, "outb") == 1) { return 2; }
    if (streq(name, "inb") == 1) { return 1; }
    if (streq(name, "outw") == 1) { return 2; }
    if (streq(name, "inw") == 1) { return 1; }
    return 0 - 1;
}

int is_builtin(int name) {
    if (builtin_arity(name) >= 0) { return 1; }
    return 0;
}

int arg_reg(int i) {
    if (i == 0) { return "rdi"; }
    if (i == 1) { return "rsi"; }
    if (i == 2) { return "rdx"; }
    if (i == 3) { return "rcx"; }
    if (i == 4) { return "r8"; }
    return "r9";
}

// --- resolve: assign stack offsets to locals, mark global VAR/ASSIGN uses -

int func_nparams_of(int name) {
    int f = fhead;
    while (f != 0) {
        if (streq(f.name, name) == 1) { return f.nparams; }
        f = f.fnext;
    }
    cerr();
    return 0;
}

int func_exists(int name) {
    int f = fhead;
    while (f != 0) {
        if (streq(f.name, name) == 1) { return 1; }
        f = f.fnext;
    }
    return 0;
}

int glob_exists(int name) {
    int g = ghead;
    while (g != 0) {
        if (streq(g.name, name) == 1) { return 1; }
        g = g.next;
    }
    return 0;
}

int extern_exists(int name) {
    int e = ehead;
    while (e != 0) {
        if (streq(e.name, name) == 1) { return 1; }
        e = e.next;
    }
    return 0;
}

// --- layouts: a single flat field-name -> offset table shared across every
// `layout` declaration, plus a layout-name -> size table for sizeof(...).
// See coff0.c's field_declare_or_check/layout_declare for the full
// rationale (differentially verified against this).
int field_names = 0;   // alloc'd 4096 * 8
int field_offsets = 0; // alloc'd 4096 * 8
int field_count = 0;

int layout_names = 0;  // alloc'd 256 * 8
int layout_sizes = 0;  // alloc'd 256 * 8
int layout_count = 0;

int field_lookup(int name) {
    int i = 0;
    while (i < field_count) {
        if (streq(load64(field_names + i * 8), name) == 1) { return load64(field_offsets + i * 8); }
        i = i + 1;
    }
    cerr();
    return 0;
}

void field_declare_or_check(int name, int offset) {
    int i = 0;
    while (i < field_count) {
        if (streq(load64(field_names + i * 8), name) == 1) {
            if (load64(field_offsets + i * 8) != offset) { cerr(); }
            return;
        }
        i = i + 1;
    }
    if (field_count >= 4096) { cerr(); }
    store64(field_names + field_count * 8, name);
    store64(field_offsets + field_count * 8, offset);
    field_count = field_count + 1;
    return;
}

int layout_lookup_size(int name) {
    int i = 0;
    while (i < layout_count) {
        if (streq(load64(layout_names + i * 8), name) == 1) { return load64(layout_sizes + i * 8); }
        i = i + 1;
    }
    cerr();
    return 0;
}

// Validates one `layout` declaration (a Layout record, see the layout
// blocks near the top of this file): duplicate field names within the
// layout, cross-layout offset conflicts via field_declare_or_check, and
// records the layout's own size (nfields * 8) for sizeof(...).
void layout_declare(int l) {
    int i = 0;
    int offset = 0;
    int f = 0;
    int g = 0;
    while (i < layout_count) {
        if (streq(load64(layout_names + i * 8), l.name) == 1) { cerr(); }
        i = i + 1;
    }
    if (layout_count >= 256) { cerr(); }
    f = l.fields;
    while (f != 0) {
        g = l.fields;
        while (g != f) {
            if (streq(g.name, f.name) == 1) { cerr(); }
            g = g.next;
        }
        field_declare_or_check(f.name, offset);
        offset = offset + 8;
        f = f.next;
    }
    store64(layout_names + layout_count * 8, l.name);
    store64(layout_sizes + layout_count * 8, offset);
    layout_count = layout_count + 1;
    return;
}

// Scans innermost-declared-first (highest index first) so an inner scope's
// variable correctly shadows an outer one of the same name.
int sym_try_lookup(int name) {
    int i = sym_count - 1;
    while (i >= 0) {
        if (streq(load64(sym_names + i * 8), name) == 1) { return load64(sym_offsets + i * 8); }
        i = i - 1;
    }
    return 0 - 1;
}

int sym_declared_in_scope(int name) {
    int scope_start = 0;
    int i = 0;
    if (scope_depth > 0) { scope_start = load64(scope_marks + (scope_depth - 1) * 8); }
    i = scope_start;
    while (i < sym_count) {
        if (streq(load64(sym_names + i * 8), name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

int sym_declare(int name) {
    int off = 0;
    if (sym_declared_in_scope(name) == 1) { cerr(); }
    if (sym_count >= 4096) { cerr(); }
    off = (sym_count + 1) * 8;
    store64(sym_names + sym_count * 8, name);
    store64(sym_offsets + sym_count * 8, off);
    sym_count = sym_count + 1;
    if (off > stack_size) { stack_size = off; }
    return off;
}

void resolve(int nd) {
    int k = 0;
    int name = 0;
    int off = 0;
    int args = 0;
    int a = 0;
    int nargs = 0;
    int bar = 0;
    if (nd == 0) { return; }
    k = nd.kind;
    if (k == 1) { return; }
    if (k == 2) { return; }
    if (k == 3) {
        name = nd.sval;
        off = sym_try_lookup(name);
        if (off >= 0) { nd.ival = off; return; }
        if (glob_exists(name) == 1) { nd.extra = 1; return; }
        if (extern_exists(name) == 1) { nd.kind = 29; return; }
        if (func_exists(name) == 1) { nd.kind = 29; return; }
        cerr();
        return;
    }
    if (k == 29) { return; } // only ever reached already-resolved, via k==3 above
    if (k == 4) {
        resolve(nd.child2);
        name = nd.sval;
        off = sym_try_lookup(name);
        if (off >= 0) { nd.ival = off; return; }
        if (glob_exists(name) == 1) { nd.extra = 1; return; }
        cerr();
        return;
    }
    if (k == 5) {
        if (nd.child2 != 0) { resolve(nd.child2); }
        nd.ival = sym_declare(nd.sval);
        return;
    }
    if (k == 6) {
        name = nd.sval;
        args = nd.child1;
        nargs = 0;
        a = args;
        while (a != 0) { nargs = nargs + 1; a = a.sibling; }
        bar = builtin_arity(name);
        if (bar >= 0) {
            if (nargs != bar) { cerr(); }
        } else if (func_exists(name) == 1) {
            if (func_nparams_of(name) != nargs) { cerr(); }
        } else {
            // Not a builtin, not a declared function -- an indirect call
            // through a function-pointer-valued variable, if `name` names
            // one. No arity check possible (see coff0.c for why). `extra`
            // (unused by CALL otherwise) encodes 0 = direct call (default),
            // 1 = indirect via a global, 2 = indirect via a local/param
            // (whose stack offset then lives in `ival`, same slot VAR
            // uses for the same purpose).
            off = sym_try_lookup(name);
            if (off >= 0) { nd.ival = off; nd.extra = 2; }
            else if (glob_exists(name) == 1) { nd.extra = 1; }
            else { cerr(); }
        }
        a = args;
        while (a != 0) { resolve(a); a = a.sibling; }
        return;
    }
    if (k >= 7 && k <= 16) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 23) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 24) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 17) { resolve(nd.child1); return; }
    if (k == 18) {
        resolve(nd.child1);
        resolve(nd.child2);
        if (nd.child3 != 0) { resolve(nd.child3); }
        return;
    }
    if (k == 19) {
        resolve(nd.child1);
        loop_depth = loop_depth + 1;
        resolve(nd.child2);
        loop_depth = loop_depth - 1;
        return;
    }
    if (k == 20) {
        if (current_fn_is_void == 1) { if (nd.child1 != 0) { cerr(); } }
        resolve(nd.child1);
        return;
    }
    if (k == 21) { resolve(nd.child1); return; }
    if (k == 22) {
        if (scope_depth >= 64) { cerr(); }
        store64(scope_marks + scope_depth * 8, sym_count);
        scope_depth = scope_depth + 1;
        a = nd.child1;
        while (a != 0) { resolve(a); a = a.sibling; }
        scope_depth = scope_depth - 1;
        sym_count = load64(scope_marks + scope_depth * 8);
        return;
    }
    if (k == 25) { if (loop_depth <= 0) { cerr(); } return; }
    if (k == 26) { if (loop_depth <= 0) { cerr(); } return; }
    if (k == 27) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 28) {
        resolve(nd.child1);
        resolve(nd.child2);
        resolve(nd.child3);
        return;
    }
    if (k == 30) {
        resolve(nd.child1);
        nd.ival = field_lookup(nd.sval);
        return;
    }
    if (k == 31) {
        resolve(nd.child1);
        resolve(nd.child2);
        nd.ival = field_lookup(nd.sval);
        return;
    }
    if (k == 32) {
        nd.ival = layout_lookup_size(nd.sval);
        nd.kind = 1; // rewrite to NUM, same in-place trick as FUNCREF
        return;
    }
    return;
}

// --- codegen: emit assembly byte-identical to coff0's own gen_expr/gen_stmt

void gen_block(int nd) {
    int s = nd.child1;
    while (s != 0) {
        gen_stmt(s);
        s = s.sibling;
    }
    return;
}

void gen_binop(int nd, int k) {
    gen_expr(nd.child1);
    if (raw_mode == 1) {
        raw_byte(0x50);  // push rax
        gen_expr(nd.child2);
        raw_byte(0x48); raw_byte(0x89); raw_byte(0xC1);  // mov rcx, rax
        raw_byte(0x58);  // pop rax
        if (k == 7)  { raw_byte(0x48); raw_byte(0x01); raw_byte(0xC8); return; }
        if (k == 8)  { raw_byte(0x48); raw_byte(0x29); raw_byte(0xC8); return; }
        if (k == 9)  { raw_byte(0x48); raw_byte(0x0F); raw_byte(0xAF); raw_byte(0xC1); return; }
        if (k == 10) {
            raw_byte(0x48); raw_byte(0x99);  // cqo
            raw_byte(0x48); raw_byte(0xF7); raw_byte(0xF9);  // idiv rcx
            return;
        }
        if (k == 11) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x94); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        if (k == 12) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x95); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        if (k == 13) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x9C); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        if (k == 14) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x9E); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        if (k == 15) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x9F); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        if (k == 16) { raw_byte(0x48); raw_byte(0x39); raw_byte(0xC8); raw_byte(0x0F); raw_byte(0x9D); raw_byte(0xC0); raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0xC0); return; }
        return;
    }
    emit("    push rax\n");
    gen_expr(nd.child2);
    emit("    mov rcx, rax\n");
    emit("    pop rax\n");
    if (k == 7) { emit("    add rax, rcx\n"); return; }
    if (k == 8) { emit("    sub rax, rcx\n"); return; }
    if (k == 9) { emit("    imul rax, rcx\n"); return; }
    if (k == 10) { emit("    cqo\n    idiv rcx\n"); return; }
    if (k == 11) { emit("    cmp rax, rcx\n    sete al\n    movzx rax, al\n"); return; }
    if (k == 12) { emit("    cmp rax, rcx\n    setne al\n    movzx rax, al\n"); return; }
    if (k == 13) { emit("    cmp rax, rcx\n    setl al\n    movzx rax, al\n"); return; }
    if (k == 14) { emit("    cmp rax, rcx\n    setle al\n    movzx rax, al\n"); return; }
    if (k == 15) { emit("    cmp rax, rcx\n    setg al\n    movzx rax, al\n"); return; }
    if (k == 16) { emit("    cmp rax, rcx\n    setge al\n    movzx rax, al\n"); return; }
    return;
}

void gen_call(int nd) {
    int name = nd.sval;
    int args = nd.child1;
    int l = 0;
    int i = 0;
    int nargs = 0;
    int a = 0;

    if (streq(name, "print") == 1) {
        l = label_count;
        // Uses two labels (l for .Lstrlen, l+1 for .Lstrlend).
        if (raw_mode == 1) { label_count = label_count + 2; }
        else { label_count = label_count + 1; }
        gen_expr(args);
        if (raw_mode == 1) {
            // rbx = rax (save string ptr), xor rcx, rcx
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC3);  // mov rbx, rax
            raw_byte(0x48); raw_byte(0x31); raw_byte(0xC9);  // xor rcx, rcx
            raw_label(l);  // .Lstrlen:
            raw_byte(0x80); raw_byte(0x3C); raw_byte(0x0B); raw_byte(0x00);  // cmp [rbx+rcx], 0
            raw_je(l + 1);  // je .Lstrlend
            raw_byte(0x48); raw_byte(0xFF); raw_byte(0xC1);  // inc rcx
            raw_jmp(l);  // jmp .Lstrlen
            raw_label(l + 1);  // .Lstrlend:
            if (elf_mode == 1) {
                // Moonshot SYS_DEBUG_PRINT(str, len)
                raw_byte(0x48); raw_byte(0x89); raw_byte(0xDF);  // mov rdi, rbx
                raw_byte(0x48); raw_byte(0x89); raw_byte(0xCE);  // mov rsi, rcx
                raw_byte(0xB8);  // mov eax, imm32
                raw_int32(1);     // SYS_DEBUG_PRINT
                raw_byte(0x0F); raw_byte(0x05);  // syscall
            } else {
                // Linux write(1, str, len)
                raw_byte(0x48); raw_byte(0x89); raw_byte(0xCA);  // mov rdx, rcx
                raw_byte(0x48); raw_byte(0x89); raw_byte(0xDE);  // mov rsi, rbx
                raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC7);  // mov rdi, 1
                raw_int32(1);
                raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 1
                raw_int32(1);
                raw_byte(0x0F); raw_byte(0x05);  // syscall
            }
        } else {
            emit("    mov rbx, rax\n");
            emit("    xor rcx, rcx\n");
            emit(".Lstrlen"); print_int(l); emit(":\n");
            emit("    cmp byte ptr [rbx + rcx], 0\n");
            emit("    je .Lstrlend"); print_int(l); emit("\n");
            emit("    inc rcx\n");
            emit("    jmp .Lstrlen"); print_int(l); emit("\n");
            emit(".Lstrlend"); print_int(l); emit(":\n");
            emit("    mov rdx, rcx\n");
            emit("    mov rsi, rbx\n");
            emit("    mov rdi, 1\n");
            emit("    mov rax, 1\n");
            emit("    syscall\n");
        }
        return;
    }
    if (streq(name, "alloc") == 1) {
        if (elf_mode == 1) {
            // SYS_ALLOC(n) (6): bump-allocate from this ring-3 process's
            // own private heap region, which the kernel sets up when it
            // loads the binary. Returns 0 on failure -- no free, matching
            // SYS_ALLOC's own bump-only design.
            gen_expr(args);
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC7);  // mov rdi, rax
            raw_byte(0xB8); raw_int32(6);                     // mov eax, 6
            raw_byte(0x0F); raw_byte(0x05);                   // syscall
            return;
        }
        if (raw_mode == 1) { cerr(); }  // --raw (Linux) alloc has no codegen path yet
        l = label_count; label_count = label_count + 1;
        gen_expr(args);
        emit("    push rax\n");
        emit("    mov rax, [.Lcurbrk]\n");
        emit("    test rax, rax\n");
        emit("    jnz .Lbrkok"); print_int(l); emit("\n");
        emit("    mov rdi, 0\n");
        emit("    mov rax, 12\n");
        emit("    syscall\n");
        emit(".Lbrkok"); print_int(l); emit(":\n");
        emit("    pop rdi\n");
        emit("    push rax\n");
        emit("    add rdi, rax\n");
        emit("    mov rax, 12\n");
        emit("    syscall\n");
        emit("    mov [.Lcurbrk], rax\n");
        emit("    pop rax\n");
        return;
    }
    if (streq(name, "load8") == 1) {
        gen_expr(args);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0x00);
        } else { emit("    movzx rax, byte ptr [rax]\n"); }
        return;
    }
    if (streq(name, "store8") == 1) {
        gen_expr(args);
        if (raw_mode == 1) {
            raw_byte(0x50);  // push rax
            gen_expr(args.sibling);
            raw_byte(0x5F);  // pop rdi
            raw_byte(0x88); raw_byte(0x07);  // mov [rdi], al
        } else {
            emit("    push rax\n");
            gen_expr(args.sibling);
            emit("    pop rdi\n");
            emit("    mov byte ptr [rdi], al\n");
        }
        return;
    }
    if (streq(name, "exit") == 1) {
        gen_expr(args);
        if (elf_mode == 1) {
            // Moonshot's SYS_EXIT is 0. This used to fall into the Linux
            // branch below and emit syscall 60, which Moonshot does not
            // implement -- so the kernel logged "unknown syscall 60",
            // returned -1, and the program CARRIED ON as if nothing had
            // happened. Every --elf program's exit() has been a no-op.
            //
            // It hid because `return` from main works fine (the entry stub
            // does the exit) and nothing exercised exit() itself: the demos
            // that call it on Esc were only ever checked for running, never
            // for stopping. Found when Infecteria printed its death message
            // 253 times and kept playing.
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC7);  // mov rdi, rax
            raw_byte(0xB8); raw_int32(0);                     // mov eax, 0
            raw_byte(0x0F); raw_byte(0x05);                   // syscall
        } else if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC7);  // mov rdi, rax
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 60
            raw_int32(60);
            raw_byte(0x0F); raw_byte(0x05);  // syscall
        } else {
            emit("    mov rdi, rax\n");
            emit("    mov rax, 60\n");
            emit("    syscall\n");
        }
        return;
    }
    // --- Moonshot ring-3 builtins (--elf mode only) --------------------
    if (streq(name, "win_info") == 1) {
        // SYS_WIN_INFO (2): returns packed (width<<16)|height in rax.
        if (elf_mode == 1) {
            raw_byte(0xB8); raw_int32(2);      // mov eax, 2
            raw_byte(0x0F); raw_byte(0x05);    // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "win_max") == 1) {
        // SYS_WIN_MAX (10): returns packed (width<<16)|height for the LARGEST
        // window this machine can ever hand out -- a fixed ceiling, not the
        // current size. A ring-3 program sizes its frame buffer from this once
        // and never resizes it, because alloc() is bump-only with no free: a
        // window growing from half the screen to all of it would need a second
        // buffer the heap has no room for. win_info() is what changes; this is
        // what you budget for.
        if (elf_mode == 1) {
            raw_byte(0xB8); raw_int32(10);     // mov eax, 10
            raw_byte(0x0F); raw_byte(0x05);    // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "key_poll") == 1) {
        // SYS_KEY_POLL (4): returns packed key event or -1 in rax.
        if (elf_mode == 1) {
            raw_byte(0xB8); raw_int32(4);      // mov eax, 4
            raw_byte(0x0F); raw_byte(0x05);    // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "ticks") == 1) {
        // SYS_TICKS (7): returns the kernel's monotonic ~100Hz tick count.
        if (elf_mode == 1) {
            raw_byte(0xB8); raw_int32(7);      // mov eax, 7
            raw_byte(0x0F); raw_byte(0x05);    // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "present") == 1) {
        // SYS_PRESENT(buf) (9): copy a whole window of pixels at once. One
        // arg, so nothing but rdi is involved.
        if (elf_mode == 1) {
            gen_expr(args);
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC7);  // mov rdi, rax
            raw_byte(0xB8); raw_int32(9);                     // mov eax, 9
            raw_byte(0x0F); raw_byte(0x05);                   // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "readfile") == 1) {
        // SYS_READFILE(name, buf, max) (8): reads a file from jakel into the
        // process's own memory. Three args, so all three go in the plain
        // SysV registers and none of the r10 business fill()/blit() need.
        //
        // With buf == 0 it returns the file's size without copying anything,
        // which is how a program sizes an alloc() before the real read --
        // there is no separate stat syscall and this costs nothing.
        if (elf_mode == 1) {
            int r = args;
            while (r != 0) {
                gen_expr(r);
                raw_byte(0x50);  // push rax
                r = r.sibling;
            }
            raw_byte(0x5A);                   // pop rdx (max)
            raw_byte(0x5E);                   // pop rsi (buf)
            raw_byte(0x5F);                   // pop rdi (name)
            raw_byte(0xB8); raw_int32(8);     // mov eax, 8
            raw_byte(0x0F); raw_byte(0x05);   // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "blit") == 1) {
        // SYS_BLIT(buf, x, y, w, h) (5): 5 args.
        if (elf_mode == 1) {
            int a = args;
            while (a != 0) {
                gen_expr(a);
                raw_byte(0x50);  // push rax
                a = a.sibling;
            }
            // SYSCALL ABI: arg4→r10 (not rcx — SYSCALL clobbers rcx with RIP)
            raw_byte(0x41); raw_byte(0x58);  // pop r8  (h)
            raw_byte(0x41); raw_byte(0x5A);  // pop r10 (w)
            raw_byte(0x5A);                   // pop rdx (y)
            raw_byte(0x5E);                   // pop rsi (x)
            raw_byte(0x5F);                   // pop rdi (buf)
            raw_byte(0xB8); raw_int32(5);     // mov eax, 5
            raw_byte(0x0F); raw_byte(0x05);   // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "fill") == 1) {
        // SYS_FILL(x, y, w, h, color) (3): 5 args. SYSCALL ABI.
        if (elf_mode == 1) {
            int a = args;
            while (a != 0) {
                gen_expr(a);
                raw_byte(0x50);  // push rax
                a = a.sibling;
            }
            // SYSCALL ABI: arg1=rdi, arg2=rsi, arg3=rdx, arg4=r10, arg5=r8
            raw_byte(0x41); raw_byte(0x58);  // pop r8  (color)
            raw_byte(0x41); raw_byte(0x5A);  // pop r10 (h)
            raw_byte(0x5A);                   // pop rdx (w)
            raw_byte(0x5E);                   // pop rsi (y)
            raw_byte(0x5F);                   // pop rdi (x)
            raw_byte(0xB8); raw_int32(3);     // mov eax, 3
            raw_byte(0x0F); raw_byte(0x05);   // syscall
        } else { cerr(); }
        return;
    }
    if (streq(name, "load64") == 1) {
        gen_expr(args);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x8B); raw_byte(0x00);  // mov rax, [rax]
        } else { emit("    mov rax, [rax]\n"); }
        return;
    }
    if (streq(name, "store64") == 1) {
        gen_expr(args);
        if (raw_mode == 1) {
            raw_byte(0x50);  // push rax
            gen_expr(args.sibling);
            raw_byte(0x5F);  // pop rdi
            raw_byte(0x48); raw_byte(0x89); raw_byte(0x07);  // mov [rdi], rax
        } else {
            emit("    push rax\n");
            gen_expr(args.sibling);
            emit("    pop rdi\n");
            emit("    mov [rdi], rax\n");
        }
        return;
    }
    if (streq(name, "argc") == 1) {
        emit("    mov rax, [.Largv0]\n");
        emit("    mov rax, [rax]\n");
        return;
    }
    if (streq(name, "argv") == 1) {
        gen_expr(args);
        emit("    mov rcx, rax\n");
        emit("    mov rax, [.Largv0]\n");
        emit("    mov rax, [rax + rcx*8 + 8]\n");
        return;
    }
    if (streq(name, "outb") == 1) {
        gen_expr(args);
        emit("    push rax\n");
        gen_expr(args.sibling);
        emit("    pop rdx\n");
        emit("    out dx, al\n");
        return;
    }
    if (streq(name, "inb") == 1) {
        gen_expr(args);
        emit("    mov rdx, rax\n");
        emit("    in al, dx\n");
        emit("    movzx rax, al\n");
        return;
    }
    if (streq(name, "outw") == 1) {
        gen_expr(args);
        emit("    push rax\n");
        gen_expr(args.sibling);
        emit("    pop rdx\n");
        emit("    out dx, ax\n");
        return;
    }
    if (streq(name, "inw") == 1) {
        gen_expr(args);
        emit("    mov rdx, rax\n");
        emit("    in ax, dx\n");
        emit("    movzx rax, ax\n");
        return;
    }

    a = args;
    while (a != 0) {
        gen_expr(a);
        if (raw_mode == 1) { raw_byte(0x50); }  // push rax
        else { emit("    push rax\n"); }
        a = a.sibling;
        nargs = nargs + 1;
    }
    if (raw_mode == 1) {
        // Pop args into registers.  For ≤6 args, pop in reverse order.
        if (nargs <= 6) {
            i = nargs - 1;
            while (i >= 0) {
                if (i == 0) { raw_byte(0x5F); }       // pop rdi
                else if (i == 1) { raw_byte(0x5E); }   // pop rsi
                else if (i == 2) { raw_byte(0x5A); }   // pop rdx
                else if (i == 3) { raw_byte(0x59); }   // pop rcx
                else if (i == 4) { raw_byte(0x41); raw_byte(0x58); }  // pop r8
                else { raw_byte(0x41); raw_byte(0x59); }  // pop r9
                i = i - 1;
            }
        }
        // Emit the call.
        if (nd.extra == 1 || nd.extra == 2) {
            // Indirect call — not supported in raw mode yet.
            cerr();
        } else {
            raw_call(name);
        }
        if (nargs > 6) { cerr(); }  // not supported yet
    } else {
        if (nargs <= 6) {
            i = nargs - 1;
            while (i >= 0) {
                emit("    pop "); emit(arg_reg(i)); emit("\n");
                i = i - 1;
            }
        } else {
            i = 0;
            while (i < 6) {
                emit("    mov "); emit(arg_reg(i)); emit(", [rsp + ");
                print_int((nargs - 1 - i) * 8); emit("]\n");
                i = i + 1;
            }
        }

        if (streq(name, "write") == 1) { emit("    mov rax, 1\n    syscall\n"); return; }
        if (streq(name, "read") == 1) { emit("    mov rax, 0\n    syscall\n"); return; }
        if (streq(name, "close") == 1) { emit("    mov rax, 3\n    syscall\n"); return; }
        if (streq(name, "open_read") == 1) {
            emit("    mov rsi, 0\n");
            emit("    mov rax, 2\n    syscall\n");
            return;
        }
        if (streq(name, "open_write") == 1) {
            emit("    mov rsi, 577\n");
            emit("    mov rdx, 420\n");
            emit("    mov rax, 2\n    syscall\n");
            return;
        }
        if (nd.extra == 1) {
            emit("    mov r10, [.G"); emit(name); emit("]\n");
            emit("    call r10\n");
        } else if (nd.extra == 2) {
            emit("    mov r10, [rbp - "); print_int(nd.ival); emit("]\n");
            emit("    call r10\n");
        } else {
            emit("    call "); emit(name); emit("\n");
        }
        if (nargs > 6) { emit("    add rsp, "); print_int(nargs * 8); emit("\n"); }
    }
    return;
}

void gen_expr(int nd) {
    int k = nd.kind;
    int l = 0;
    // --- literal ---
    if (k == 1) {
        if (raw_mode == 1) {
            // movabs rax, imm64 -- BOTH halves of the immediate. The high
            // word used to be hardcoded to 0, silently truncating every
            // literal to 32 bits: c0's int is 64-bit, so any constant above
            // 0xFFFFFFFF (and every negative one) lost its top half with no
            // error. Found via a ring-3 sprite whose pixel data is seeded by
            // store64 of 64-bit literals -- each one covers two pixels, so
            // exactly the odd-numbered pixels (the high half) came out zero
            // and the sprite rendered as vertical stripes.
            //
            // raw_int32 already masks to the low 32 bits of whatever it is
            // given, so the low word can pass ival straight through. The
            // high word needs FLOOR division, not c0's truncate-toward-zero
            // `/`, or negative literals land one short.
            int hi = nd.ival / (65536 * 65536);
            if (nd.ival < 0) {
                if (hi * (65536 * 65536) != nd.ival) { hi = hi - 1; }
            }
            raw_byte(0x48); raw_byte(0xB8);  // mov rax, imm64
            raw_int32(nd.ival);              // low 32 bits
            raw_int32(hi);                   // high 32 bits
        } else {
            emit("    mov rax, "); print_int(nd.ival); emit("\n");
        }
        return;
    }
    // --- string literal ---
    if (k == 2) {
        if (raw_mode == 1) {
            int str_idx = nd.extra;
            int str_ptr = load64(string_ptrs + str_idx * 8);
            int str_len = load64(string_lens + str_idx * 8);
            // jmp rel8 over string data (EB + offset)
            int jmp_pos = raw_pos;
            raw_byte(0xEB);
            raw_byte(str_len + 1);  // +1 for NUL
            // String bytes + NUL.
            int si = 0;
            while (si < str_len) {
                raw_byte(load8(str_ptr + si));
                si = si + 1;
            }
            raw_byte(0);  // NUL
            // lea rax, [rip + offset] — string starts right after jmp.
            raw_byte(0x48); raw_byte(0x8D); raw_byte(0x05);
            int str_start = jmp_pos + 2;
            int lea_end   = raw_pos + 4;  // +4 for the disp32 we are about to emit
            int off = str_start - lea_end;
            int u = off; if (u < 0) { u = u + 65536 * 65536; }
            raw_byte(u - (u / 256) * 256);
            raw_byte((u / 256) - (u / 65536) * 256);
            raw_byte((u / 65536) - (u / 16777216) * 256);
            raw_byte(u / 16777216);
            return;
        }
        emit("    lea rax, [.Lstr"); print_int(nd.extra); emit("]\n");
        return;
    }
    // --- variable read ---
    if (k == 3) {
        if (raw_mode == 1) {
            if (nd.extra == 1) {
                // Global: mov rax, [rip+...].  We need to know the global's
                // offset in the data section.  For the MVP, treat globals
                // as unsupported in raw mode and fall through.
                cerr();
            } else {
                // Local: mov rax, [rbp - offset]
                raw_byte(0x48); raw_byte(0x8B); raw_byte(0x85);
                raw_int32(0 - nd.ival);
            }
        } else {
            if (nd.extra == 1) {
                emit("    mov rax, [.G"); emit(nd.sval); emit("]\n");
            } else {
                emit("    mov rax, [rbp - "); print_int(nd.ival); emit("]\n");
            }
        }
        return;
    }
    // --- function reference ---
    if (k == 29) {
        if (raw_mode == 1) { cerr(); }
        emit("    lea rax, ["); emit(nd.sval); emit("]\n");
        return;
    }
    // --- unary neg ---
    if (k == 17) {
        gen_expr(nd.child1);
        if (raw_mode == 1) { raw_byte(0x48); raw_byte(0xF7); raw_byte(0xD8); }
        else { emit("    neg rax\n"); }
        return;
    }
    // --- array index (load8 offset) ---
    if (k == 27) {
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x50);  // push rax
            gen_expr(nd.child2);
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC1);  // mov rcx, rax
            raw_byte(0x58);  // pop rax
            raw_byte(0x48); raw_byte(0x01); raw_byte(0xC8);  // add rax, rcx
            raw_byte(0x48); raw_byte(0x0F); raw_byte(0xB6); raw_byte(0x00);  // movzx rax, byte [rax]
        } else {
            emit("    push rax\n");
            gen_expr(nd.child2);
            emit("    mov rcx, rax\n");
            emit("    pop rax\n");
            emit("    add rax, rcx\n");
            emit("    movzx rax, byte ptr [rax]\n");
        }
        return;
    }
    // --- field read (e.field, sugar over load64(base + offset)) ---
    if (k == 30) {
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x8B); raw_byte(0x80);  // mov rax, [rax+disp32]
            raw_int32(nd.ival);
        } else {
            emit("    mov rax, [rax + "); print_int(nd.ival); emit("]\n");
        }
        return;
    }
    // --- function call ---
    if (k == 6) { gen_call(nd); return; }
    // --- binary ops ---
    if (k >= 7 && k <= 16) { gen_binop(nd, k); return; }
    // --- AND short-circuit ---
    if (k == 23) {
        // Raw mode uses TWO labels (l = .Lfalse, l+1 = .Landend) out of one
        // flat numeric namespace, so both must be reserved. Text mode needs
        // only one id because its labels are distinct *names*
        // (.Lfalse7 / .Landend7 cannot collide). Reserving one here in raw
        // mode let the next construct reuse l+1 and silently redefine this
        // AND's own end label -- wrong branches taken, and (since string
        // literals are emitted inline in the code stream) jumps landing on
        // the wrong literal. Same two-label reservation print() already does.
        l = label_count;
        if (raw_mode == 1) { label_count = label_count + 2; }
        else { label_count = label_count + 1; }
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_je(l);  // je .Lfalse
            gen_expr(nd.child2);
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_je(l);
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 1
            raw_int32(1);
            raw_jmp(l + 1);  // jmp .Landend (l+1 is the "landend" label)
            raw_label(l);    // .Lfalse:
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 0
            raw_int32(0);
            raw_label(l + 1); // .Landend:
        } else {
            emit("    cmp rax, 0\n");
            emit("    je .Lfalse"); print_int(l); emit("\n");
            gen_expr(nd.child2);
            emit("    cmp rax, 0\n");
            emit("    je .Lfalse"); print_int(l); emit("\n");
            emit("    mov rax, 1\n");
            emit("    jmp .Landend"); print_int(l); emit("\n");
            emit(".Lfalse"); print_int(l); emit(":\n");
            emit("    mov rax, 0\n");
            emit(".Landend"); print_int(l); emit(":\n");
        }
        return;
    }
    // --- OR short-circuit ---
    if (k == 24) {
        // Two labels in raw mode (l = .Ltrue, l+1 = .Lorend) -- see the AND
        // case above for why reserving only one silently corrupts jumps.
        l = label_count;
        if (raw_mode == 1) { label_count = label_count + 2; }
        else { label_count = label_count + 1; }
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_jne(l);  // jne .Ltrue
            gen_expr(nd.child2);
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_jne(l);
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 0
            raw_int32(0);
            raw_jmp(l + 1);  // jmp .Lorend
            raw_label(l);    // .Ltrue:
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 1
            raw_int32(1);
            raw_label(l + 1); // .Lorend:
        } else {
            emit("    cmp rax, 0\n");
            emit("    jne .Ltrue"); print_int(l); emit("\n");
            gen_expr(nd.child2);
            emit("    cmp rax, 0\n");
            emit("    jne .Ltrue"); print_int(l); emit("\n");
            emit("    mov rax, 0\n");
            emit("    jmp .Lorend"); print_int(l); emit("\n");
            emit(".Ltrue"); print_int(l); emit(":\n");
            emit("    mov rax, 1\n");
            emit(".Lorend"); print_int(l); emit(":\n");
        }
        return;
    }
    cerr();
    return;
}

void gen_stmt(int nd) {
    int k = nd.kind;
    int l = 0;
    // --- var decl with init (k=5) ---
    if (k == 5) {
        if (nd.child2 != 0) { gen_expr(nd.child2); }
        else {
            if (raw_mode == 1) { raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0); raw_int32(0); }
            else { emit("    mov rax, 0\n"); }
        }
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x89); raw_byte(0x85);  // mov [rbp+disp32], rax
            raw_int32(0 - nd.ival);
        } else {
            emit("    mov [rbp - "); print_int(nd.ival); emit("], rax\n");
        }
        return;
    }
    // --- assignment (k=4) ---
    if (k == 4) {
        gen_expr(nd.child2);
        if (raw_mode == 1) {
            if (nd.extra == 1) { cerr(); }  // globals not yet
            else {
                raw_byte(0x48); raw_byte(0x89); raw_byte(0x85);  // mov [rbp+disp32], rax
                raw_int32(0 - nd.ival);
            }
        } else {
            if (nd.extra == 1) {
                emit("    mov [.G"); emit(nd.sval); emit("], rax\n");
            } else {
                emit("    mov [rbp - "); print_int(nd.ival); emit("], rax\n");
            }
        }
        return;
    }
    // --- array-index assignment (k=28) ---
    if (k == 28) {
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x50);  // push rax  (base)
            gen_expr(nd.child2);
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC1);  // mov rcx, rax  (index)
            raw_byte(0x58);  // pop rax
            raw_byte(0x48); raw_byte(0x01); raw_byte(0xC8);  // add rax, rcx
            raw_byte(0x50);  // push rax  (computed address)
            gen_expr(nd.child3);
            raw_byte(0x5F);  // pop rdi
            raw_byte(0x88); raw_byte(0x07);  // mov [rdi], al
        } else {
            emit("    push rax\n");
            gen_expr(nd.child2);
            emit("    pop rcx\n");
            emit("    add rcx, rax\n");
            emit("    push rcx\n");
            gen_expr(nd.child3);
            emit("    pop rdi\n");
            emit("    mov byte ptr [rdi], al\n");
        }
        return;
    }
    // --- field assignment (k=31, e.field = value) ---
    if (k == 31) {
        gen_expr(nd.child1);  // base
        if (raw_mode == 1) {
            raw_byte(0x50);  // push rax
            gen_expr(nd.child2);  // value
            raw_byte(0x5F);  // pop rdi
            raw_byte(0x48); raw_byte(0x89); raw_byte(0x87);  // mov [rdi+disp32], rax
            raw_int32(nd.ival);
        } else {
            emit("    push rax\n");
            gen_expr(nd.child2);  // value
            emit("    pop rdi\n");
            emit("    mov [rdi + "); print_int(nd.ival); emit("], rax\n");
        }
        return;
    }
    // --- expression statement (k=21) ---
    if (k == 21) { gen_expr(nd.child1); return; }
    // --- if/else (k=18) ---
    if (k == 18) {
        l = label_count;
        // Raw mode uses two labels (l for .Lelse, l+1 for .Lend); text
        // mode only uses one (l, with string prefixes).  If we only
        // increment by 1 in raw mode the next statement's .Lelse reuses
        // this statement's .Lend label id, producing jumps to the wrong
        // place.
        if (raw_mode == 1) { label_count = label_count + 2; }
        else { label_count = label_count + 1; }
        gen_expr(nd.child1);
        if (raw_mode == 1) {
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_je(l);  // je .Lelse
            gen_stmt(nd.child2);
            raw_jmp(l + 1);  // jmp .Lend
            raw_label(l);    // .Lelse:
            if (nd.child3 != 0) { gen_stmt(nd.child3); }
            raw_label(l + 1); // .Lend:
        } else {
            emit("    cmp rax, 0\n");
            emit("    je .Lelse"); print_int(l); emit("\n");
            gen_stmt(nd.child2);
            emit("    jmp .Lend"); print_int(l); emit("\n");
            emit(".Lelse"); print_int(l); emit(":\n");
            if (nd.child3 != 0) { gen_stmt(nd.child3); }
            emit(".Lend"); print_int(l); emit(":\n");
        }
        return;
    }
    // --- while (k=19) ---
    if (k == 19) {
        l = label_count;
        // Same two-label issue as if/else above.
        if (raw_mode == 1) { label_count = label_count + 2; }
        else { label_count = label_count + 1; }
        if (raw_mode == 1) {
            raw_label(l);  // .Lstart:
            gen_expr(nd.child1);
            raw_byte(0x48); raw_byte(0x83); raw_byte(0xF8); raw_byte(0x00);  // cmp rax, 0
            raw_je(l + 1);  // je .Lend
            if (gen_loop_depth >= 64) { cerr(); }
            store64(loop_labels + gen_loop_depth * 8, l);
            gen_loop_depth = gen_loop_depth + 1;
            gen_stmt(nd.child2);
            gen_loop_depth = gen_loop_depth - 1;
            raw_jmp(l);     // jmp .Lstart
            raw_label(l + 1); // .Lend:
        } else {
            emit(".Lstart"); print_int(l); emit(":\n");
            gen_expr(nd.child1);
            emit("    cmp rax, 0\n");
            emit("    je .Lend"); print_int(l); emit("\n");
            if (gen_loop_depth >= 64) { cerr(); }
            store64(loop_labels + gen_loop_depth * 8, l);
            gen_loop_depth = gen_loop_depth + 1;
            gen_stmt(nd.child2);
            gen_loop_depth = gen_loop_depth - 1;
            emit("    jmp .Lstart"); print_int(l); emit("\n");
            emit(".Lend"); print_int(l); emit(":\n");
        }
        return;
    }
    // --- return (k=20) ---
    if (k == 20) {
        if (nd.child1 != 0) { gen_expr(nd.child1); }
        if (raw_mode == 1) { raw_jmp(current_ret_label); }
        else { emit("    jmp .Lret"); print_int(current_ret_label); emit("\n"); }
        return;
    }
    // --- break (k=25) ---
    if (k == 25) {
        if (raw_mode == 1) {
            raw_jmp(load64(loop_labels + (gen_loop_depth - 1) * 8) + 1);
        } else {
            emit("    jmp .Lend"); print_int(load64(loop_labels + (gen_loop_depth - 1) * 8)); emit("\n");
        }
        return;
    }
    // --- continue (k=26) ---
    if (k == 26) {
        if (raw_mode == 1) {
            raw_jmp(load64(loop_labels + (gen_loop_depth - 1) * 8));
        } else {
            emit("    jmp .Lstart"); print_int(load64(loop_labels + (gen_loop_depth - 1) * 8)); emit("\n");
        }
        return;
    }
    // --- block (k=22) ---
    if (k == 22) { gen_block(nd); return; }
    cerr();
    return;
}

void gen_function(int f) {
    int frame = f.stack_size;
    int nparams = f.nparams;
    int i = 0;
    int rem = frame - (frame / 16) * 16;
    if (rem != 0) { frame = frame + (16 - rem); }

    current_ret_label = label_count;
    label_count = label_count + 1;

    if (raw_mode == 1) {
        // Record this function's position for call patching.
        raw_func_def(f.name);
        // Prologue: push rbp; mov rbp, rsp; sub rsp, frame
        raw_byte(0x55);  // push rbp
        raw_byte(0x48); raw_byte(0x89); raw_byte(0xE5);  // mov rbp, rsp
        if (frame > 0) {
            raw_byte(0x48); raw_byte(0x81); raw_byte(0xEC);  // sub rsp, imm32
            raw_int32(frame);
        }
        // Parameter shadowing: mov [rbp - (i+1)*8], arg_reg(i)
        while (i < nparams) {
            if (i < 6) {
                // mov rax, arg_reg(i) then mov [rbp-off], rax
                if (i == 0) { raw_byte(0x48); raw_byte(0x89); raw_byte(0xF8); }
                else if (i == 1) { raw_byte(0x48); raw_byte(0x89); raw_byte(0xF0); }
                else if (i == 2) { raw_byte(0x48); raw_byte(0x89); raw_byte(0xD0); }
                else if (i == 3) { raw_byte(0x48); raw_byte(0x89); raw_byte(0xC8); }
                // r8/r9 are the EXTENDED registers, so the REX prefix that
                // reaches them differs from the four above: 0x4C sets REX.R
                // (the reg field, i.e. the SOURCE of a 0x89 store), while 0x49
                // sets REX.B (the rm field, the destination). Both encode to
                // the same C0/C8 modrm byte, so getting it backwards assembles
                // cleanly and silently -- these two lines used to emit
                // `mov r8, rax` / `mov r9, rax`, writing rax INTO the argument
                // register instead of reading it out. Parameters 5 and 6 came
                // out holding parameter 4's value.
                else if (i == 4) { raw_byte(0x4C); raw_byte(0x89); raw_byte(0xC0); }
                else { raw_byte(0x4C); raw_byte(0x89); raw_byte(0xC8); }
                raw_byte(0x48); raw_byte(0x89); raw_byte(0x85);  // mov [rbp+disp32], rax
                raw_int32(0 - (i + 1) * 8);
            } else {
                raw_byte(0x48); raw_byte(0x8B); raw_byte(0x85);  // mov rax, [rbp+disp32]
                raw_int32(16 + (nparams - 1 - i) * 8);
                raw_byte(0x48); raw_byte(0x89); raw_byte(0x85);  // mov [rbp+disp32], rax
                raw_int32(0 - (i + 1) * 8);
            }
            i = i + 1;
        }
        gen_block(f.body);
        // Epilogue.
        raw_label(current_ret_label);
        raw_byte(0x48); raw_byte(0x89); raw_byte(0xEC);  // mov rsp, rbp
        raw_byte(0x5D);  // pop rbp
        raw_byte(0xC3);  // ret
        return;
    }

    emit(f.name); emit(":\n");
    emit("    push rbp\n");
    emit("    mov rbp, rsp\n");
    if (frame > 0) { emit("    sub rsp, "); print_int(frame); emit("\n"); }

    while (i < nparams) {
        if (i < 6) {
            emit("    mov [rbp - "); print_int((i + 1) * 8); emit("], "); emit(arg_reg(i)); emit("\n");
        } else {
            emit("    mov rax, [rbp + "); print_int(16 + (nparams - 1 - i) * 8); emit("]\n");
            emit("    mov [rbp - "); print_int((i + 1) * 8); emit("], rax\n");
        }
        i = i + 1;
    }

    gen_block(f.body);

    emit(".Lret"); print_int(current_ret_label); emit(":\n");
    emit("    mov rsp, rbp\n");
    emit("    pop rbp\n");
    emit("    ret\n");
    return;
}

// --- main: read stdin, lex, parse, resolve, emit assembly ------------------

int main() {
    int buf = 0;
    int n = 0;
    int got = 0;
    int name = 0;
    int gtail = 0;
    int ftail = 0;
    int g = 0;
    int g2 = 0;
    int e = 0;
    int f = 0;
    int f2 = 0;
    int np = 0;
    int sign = 0;
    int i = 0;
    int j = 0;
    int found_main = 0;
    int p = 0;
    int len = 0;
    int infd = 0;
    int is_void = 0;
    int extra_head = 0;
    int extra_tail = 0;
    int pnode = 0;
    int l = 0;
    int fld_head = 0;
    int fld_tail = 0;
    int fld = 0;

    sym_names = alloc(4096 * 8);
    sym_offsets = alloc(4096 * 8);
    string_ptrs = alloc(4096 * 8);
    string_lens = alloc(4096 * 8);
    loop_labels = alloc(64 * 8);
    scope_marks = alloc(64 * 8);
    field_names = alloc(4096 * 8);
    field_offsets = alloc(4096 * 8);
    layout_names = alloc(256 * 8);
    layout_sizes = alloc(256 * 8);

    // CLI: `coff input.c0 output.s` or `coff --raw input.c0 output.bin` or
    // `coff --elf input.c0 output.elf`.
    // With no arguments, stdin/stdout works (differential-test harness).
    int cli_input = 1;
    int cli_output = 2;
    if (argc() == 4) {
        if (streq(argv(1), "--raw") == 1) {
            raw_mode = 1;
        } else if (streq(argv(1), "--elf") == 1) {
            raw_mode = 1;
            elf_mode = 1;
        } else { cerr(); }
        raw_init();
        cli_input = 2;
        cli_output = 3;
    } else if (argc() == 3) {
        // normal text mode
    } else if (argc() != 1) {
        cerr();
    }
    if (argc() >= 3) {
        infd = open_read(argv(cli_input));
        if (infd < 0) { cerr(); }
        outfd = open_write(argv(cli_output));
        if (outfd < 0) { cerr(); }
    }

    // Real path known (the normal CLI form with input/output files) ->
    // expand include directives, resolving relative paths against
    // the input file's own directory.
    if (argc() >= 3) {
        expand_buf = alloc(EXPAND_CAP);
        expand_len = 0;
        include_stack = alloc(INCLUDE_MAX_DEPTH * 8);
        expand_file(argv(cli_input));
        buf = expand_buf;
        n = expand_len;
    } else {
        // 1048576 (1MB), not 65536 -- a real 65536-byte cap silently
        // truncated the largest source file in my OS kernel (past 72000
        // bytes and still growing, discovered when switching that build
        // from coff0 to this self-hosted compiler) mid-file, producing a
        // confusing
        // "PARSEERROR" with no hint the actual problem was "ran out of
        // buffer," not a real syntax issue. 1MB is generous headroom past
        // any c0 source file size on the horizon. coff0.c has no
        // equivalent limit (plain C, reads via a realloc'd buffer), which
        // is exactly why this went unnoticed until a real, large, growing
        // file (not a small test corpus entry) hit it.
        buf = alloc(1048576);
        got = read(infd, buf, 1048576);
        while (got > 0) {
            n = n + got;
            got = read(infd, buf + n, 1048576 - n);
        }
    }

    lex_all(buf, n);
    tpos = 0;

    while (tok_kind(tpos) != 26) {
        is_void = 0;
        if (tok_kind(tpos) == 34) {
            tpos = tpos + 1;
            expect(21);  // int
            if (tok_kind(tpos) != 2) { perr(); }
            name = tok_name(tpos);
            tpos = tpos + 1;
            expect(19);  // ;
            e = alloc(sizeof(Global));  // externs are Global-shaped: name + (unused) init + next
            e.name = name;
            e.init = 0;
            if (ehead == 0) { ehead = e; etail = e; }
            else { etail.next = e; etail = e; }
            continue;
        }
        if (tok_kind(tpos) == 36) {
            tpos = tpos + 1;
            if (tok_kind(tpos) != 2) { perr(); }
            l = alloc(sizeof(Layout));
            l.name = tok_name(tpos);
            tpos = tpos + 1;
            expect(17);
            fld_head = 0;
            fld_tail = 0;
            while (tok_kind(tpos) != 18) {
                expect(21);
                if (tok_kind(tpos) != 2) { perr(); }
                fld = alloc(sizeof(LayoutField));
                fld.name = tok_name(tpos);
                tpos = tpos + 1;
                expect(19);
                if (fld_head == 0) { fld_head = fld; fld_tail = fld; }
                else { fld_tail.next = fld; fld_tail = fld; }
            }
            expect(18);
            l.fields = fld_head;
            if (lhead == 0) { lhead = l; ltail = l; }
            else { ltail.next = l; ltail = l; }
            continue;
        }
        if (tok_kind(tpos) == 33) { is_void = 1; tpos = tpos + 1; }
        else { expect(21); }
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos = tpos + 1;
        if (tok_kind(tpos) == 15) {
            f = alloc(sizeof(Function));
            f.name = name;
            f.is_void = is_void;
            tpos = tpos + 1;
            np = 0;
            extra_head = 0;
            extra_tail = 0;
            if (tok_kind(tpos) != 16) {
                while (1) {
                    expect(21);
                    if (tok_kind(tpos) != 2) { perr(); }
                    if (np >= 16) { cerr(); }
                    if (np < 6) {
                        store64(f + 56 + np * 8, tok_name(tpos));
                    } else {
                        pnode = alloc(sizeof(ExtraParam));
                        pnode.name = tok_name(tpos);
                        if (extra_head == 0) { extra_head = pnode; extra_tail = pnode; }
                        else { extra_tail.next = pnode; extra_tail = pnode; }
                    }
                    np = np + 1;
                    tpos = tpos + 1;
                    if (tok_kind(tpos) == 20) { tpos = tpos + 1; }
                    else { break; }
                }
            }
            expect(16);
            f.nparams = np;
            f.extra_params = extra_head;
            f.body = p_block();
            if (fhead == 0) { fhead = f; ftail = f; }
            else { ftail.fnext = f; ftail = f; }
        } else {
            if (is_void == 1) { cerr(); }
            g = alloc(sizeof(Global));
            g.name = name;
            if (tok_kind(tpos) == 8) {
                tpos = tpos + 1;
                sign = 1;
                if (tok_kind(tpos) == 5) { tpos = tpos + 1; sign = 0 - 1; }
                if (tok_kind(tpos) != 1) { perr(); }
                g.init = sign * tok_ival(tpos);
                tpos = tpos + 1;
            }
            expect(19);
            if (ghead == 0) { ghead = g; gtail = g; }
            else { gtail.next = g; gtail = g; }
        }
    }

    // Pass A: function signatures — no builtin-name clash, exactly one main
    // taking no parameters, no duplicate function names.
    f = fhead;
    while (f != 0) {
        if (is_builtin(f.name) == 1) { cerr(); }
        if (streq(f.name, "main") == 1) {
            if (f.nparams != 0) { cerr(); }
            if (f.is_void == 1) { cerr(); }
            found_main = 1;
        }
        f = f.fnext;
    }
    if (found_main == 0) { cerr(); }
    f = fhead;
    while (f != 0) {
        f2 = f.fnext;
        while (f2 != 0) {
            if (streq(f.name, f2.name) == 1) { cerr(); }
            f2 = f2.fnext;
        }
        f = f.fnext;
    }

    // Pass B: globals — no builtin-name clash, no function-name clash, no
    // duplicate global names.
    g = ghead;
    while (g != 0) {
        if (is_builtin(g.name) == 1) { cerr(); }
        f = fhead;
        while (f != 0) {
            if (streq(f.name, g.name) == 1) { cerr(); }
            f = f.fnext;
        }
        g = g.next;
    }
    g = ghead;
    while (g != 0) {
        g2 = g.next;
        while (g2 != 0) {
            if (streq(g.name, g2.name) == 1) { cerr(); }
            g2 = g2.next;
        }
        g = g.next;
    }

    // Pass B2: externs — no builtin-name clash,
    // no global-name clash, no duplicate extern names.
    // (Function-name clash is allowed: extern int func; resolves to FUNCREF
    // same as a bare function reference, which is the intended use.)
    e = ehead;
    while (e != 0) {
        if (is_builtin(e.name) == 1) { cerr(); }
        g = ghead;
        while (g != 0) {
            if (streq(g.name, e.name) == 1) { cerr(); }
            g = g.next;
        }
        e = e.next;
    }
    e = ehead;
    while (e != 0) {
        int e2 = e.next;
        while (e2 != 0) {
            if (streq(e.name, e2.name) == 1) { cerr(); }
            e2 = e2.next;
        }
        e = e.next;
    }

    // Pass B3: layouts -- register field offsets (erroring on cross-layout
    // conflicts) and each layout's size, before any function body gets
    // resolved (field/sizeof references inside those bodies depend on it).
    l = lhead;
    while (l != 0) {
        layout_declare(l);
        l = l.next;
    }

    // Pass C: resolve every function body, assigning stack offsets.
    f = fhead;
    while (f != 0) {
        sym_count = 0;
        stack_size = 0;
        scope_depth = 0;
        current_fn_is_void = f.is_void;
        np = f.nparams;
        i = 0;
        while (i < np) {
            sym_declare(param_name_at(f, i));
            i = i + 1;
        }
        resolve(f.body);
        f.stack_size = stack_size;
        f = f.fnext;
    }

    // Pass D: emit code.
    if (raw_mode == 1) {
        // Raw binary entry point (_start).
        // Find main's name pointer by scanning the function list.
        int main_name = 0;
        int sf = fhead;
        while (sf != 0) {
            if (streq(sf.name, "main") == 1) {
                main_name = sf.name;
                break;
            }
            sf = sf.fnext;
        }
        if (main_name == 0) { cerr(); }
        raw_call(main_name);  // call main (forward ref, patched later)
        if (elf_mode == 1) {
            // Moonshot SYS_EXIT: edi = exit code, eax = 0
            raw_byte(0x89); raw_byte(0xC7);  // mov edi, eax
            raw_byte(0xB8);                  // mov eax, imm32
            raw_int32(0);                    // SYS_EXIT
        } else {
            // Linux exit_group: rdi = code, rax = 60
            raw_byte(0x48); raw_byte(0x89); raw_byte(0xC7);  // mov rdi, rax
            raw_byte(0x48); raw_byte(0xC7); raw_byte(0xC0);  // mov rax, 60
            raw_int32(60);
        }
        raw_byte(0x0F); raw_byte(0x05);  // syscall

        f = fhead;
        while (f != 0) {
            gen_function(f);
            f = f.fnext;
        }

        // Resolve all forward references.
        raw_patch_all();
        // Write the ELF header (before the code) when targeting Moonshot.
        if (elf_mode == 1) {
            elf_emit_header();
        }
        // Write the binary.
        raw_flush();
        if (outfd != 1) { close(outfd); }
        return 0;
    }

    emit(".intel_syntax noprefix\n");
    emit(".global _start\n");
    emit("_start:\n");
    emit("    mov [.Largv0], rsp\n");
    emit("    call main\n");
    emit("    mov rdi, rax\n");
    emit("    mov rax, 60\n");
    emit("    syscall\n");

    f = fhead;
    while (f != 0) {
        gen_function(f);
        f = f.fnext;
    }

    if (string_count > 0) {
        emit("\n.section .rodata\n");
        i = 0;
        while (i < string_count) {
            emit(".Lstr"); print_int(i); emit(":\n");
            emit("    .byte");
            p = load64(string_ptrs + i * 8);
            len = load64(string_lens + i * 8);
            j = 0;
            while (j < len) {
                emit(" "); print_int(p[j]); emit(",");
                j = j + 1;
            }
            emit(" 0\n");
            i = i + 1;
        }
    }

    emit("\n.section .data\n");
    emit(".Lcurbrk:\n    .quad 0\n");
    emit(".Largv0:\n    .quad 0\n");
    g = ghead;
    while (g != 0) {
        emit(".G"); emit(g.name); emit(":\n    .quad ");
        print_int(g.init);
        emit("\n");
        g = g.next;
    }

    if (outfd != 1) { close(outfd); }
    return 0;
}
