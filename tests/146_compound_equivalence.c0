// expect: 42
//
// tests/146_compound_equivalence.c0 - T OP= E computes what T = T OP E computes
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
// T OP= E computes exactly what T = T OP E computes, for every compound
// operator, every target form (a local in a register, a local on the stack,
// a global, buf[i] and a field) and every kind of right side (a 32-bit and a
// 64-bit immediate, a local in a register, a global and a call). main runs
// each over the values in vals, and over the counts in counts for the
// shifts, skipping only the divisions idiv traps on. Then a few byte
// targets are checked against constants. Each mismatch adds one to bad.
layout F { int fa; int fb; int fc; }

int bad = 0;
int ge = 0;
int gt = 0;
int gu = 0;
int gb = 0;
int gp = 0;
int gq = 0;

int id(int x) { return x; }

int tr_add(int v, int r) {
    int x = 0;
    int y = 0;
    ge = r;
    x = v; y = v; x += 3; y = y + 3; if (x != y) { bad += 1; }
    x = v; y = v; x += -7; y = y + -7; if (x != y) { bad += 1; }
    x = v; y = v; x += 0x123456789ABCDEF; y = y + 0x123456789ABCDEF; if (x != y) { bad += 1; }
    x = v; y = v; x += r; y = y + r; if (x != y) { bad += 1; }
    x = v; y = v; x += ge; y = y + ge; if (x != y) { bad += 1; }
    x = v; y = v; x += id(r); y = y + id(r); if (x != y) { bad += 1; }
    return 0;
}

