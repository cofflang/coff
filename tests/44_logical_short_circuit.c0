// expect: 42
//
// tests/44_logical_short_circuit.c0 - && and || short-circuit for real, side effects must not run
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
int calls = 0;

int mark() {
    calls = calls + 1;
    return 1;
}

int main() {
    int r;
    r = 0 && mark();
    if (calls != 0) { return 50; }
    r = 1 || mark();
    if (calls != 0) { return 51; }
    r = 1 && mark();
    if (calls != 1) { return 52; }
    r = 0 || mark();
    if (calls != 2) { return 53; }
    if (1 && 1 && 0) { return 54; }
    if (0 || 0 || 1) { r = r; } else { return 55; }
    return 42;
}
