// expect: 15
//
// tests/137_string_escapes.c0 - the escapes in a string literal keep their own values
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
// Every escape a string literal knows, checked byte by byte. A tab must be
// byte 9, not a space, and the other escapes keep their own values. Each
// check that holds adds a bit.
int main() {
    int ok = 0;
    int s = "a\tb\nc\\d\"e";
    if (load8(s + 1) == 9) { ok = ok + 1; }
    if (load8(s + 3) == 10) { ok = ok + 2; }
    if (load8(s + 5) == 92) { ok = ok + 4; }
    if (load8(s + 7) == 34 && load8(s + 8) == 'e') { ok = ok + 8; }
    return ok;
}
