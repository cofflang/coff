// This is the first piece of the self-hosted compiler, kept as a
// standalone differential test stage. Reads c0 source from stdin (or an
// optional file argument, see main) and prints one token per line in
// exactly the format of `coff0 -t` -- that format is the contract the
// lexdiff loop in run_tests.sh checks, byte for byte. On a lex error it
// prints LEXERROR and exits 1; coff0 -t aborts with no stdout at all in
// that case, so error files are excluded from the diff.
//
// It uses only a small part of c0. Loops end through flags rather than
// break/continue, and most state is threaded through locals; the only
// globals are the include-expansion state below.

// The chain of currently-open includes, for cycle detection -- see
// expand_file.
int INCLUDE_MAX_DEPTH = 32;
int include_stack = 0; // alloc'd once, INCLUDE_MAX_DEPTH * 8 bytes
int include_depth = 0;
int MAX_INCLUDED = 256;
int included = 0; // alloc'd once, every file ever spliced (include-once)
int n_included = 0;
// Growing output buffer for expand_file's textual substitution -- see
// coff0.c's resolve_includes for the full rationale (this mirrors it
// exactly, differentially verified). A fixed generous size rather than
// real dynamic growth.
int EXPAND_CAP = 4194304; // 4MB
int expand_buf = 0;
int expand_len = 0;

int is_digit(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

int is_hex_digit(int c) {
    if (is_digit(c) == 1) { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int hex_value(int c) {
    if (is_digit(c) == 1) { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

int is_ident_start(int c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

int is_ident_char(int c) {
    if (is_digit(c) == 1) { return 1; }
    return is_ident_start(c);
}

void print_char(int c) {
    int tmp = alloc(2);
    store8(tmp, c);
    print(tmp);
    return;
}

void print_int(int v) {
    int tmp = alloc(32);
    if (!v) { print("0"); return; }
    int neg = 0;
    if (v < 0) { neg = 1; v = 0 - v; }
    int i = 31;
    while (v > 0) {
        i -= 1;
        store8(tmp + i, '0' + (v % 10));
        v /= 10;
    }
    if (neg == 1) { i -= 1; store8(tmp + i, '-'); }
    print(tmp + i);
    return;
}

// Does the word at buf[start..start+len) equal the null-terminated
// keyword at kw?
int word_is(int buf, int start, int len, int kw) {
    int i = 0;
    for (i = 0; i < len; i += 1) {
        int k = load8(kw + i);
        if (!k) { return 0; }
        if (load8(buf + start + i) != k) { return 0; }
    }
    if (load8(kw + len) != 0) { return 0; }
    return 1;
}

// -------------------------------------------------------------- includes
//
// `include "path.c0";` is pure textual substitution, resolved entirely
// before real lexing starts -- mirrors coff0.c's resolve_includes exactly
// (differentially verified against it), see that comment for the full
// design rationale. The one difference is that lex.c0 reads stdin unless
// main() is given an optional file argument. Includes are only expanded
// with that argument, since a relative include path has nothing to
// resolve against otherwise.

int slen(int s) {
    int i = 0;
    while (load8(s + i) != 0) {
        i += 1;
    }
    return i;
}

int streq_(int a, int b) {
    int i = 0;
    int going = 1;
    int result = 0;
    while (going == 1) {
        int ca = load8(a + i);
        int cb = load8(b + i);
        if (ca != cb) { going = 0; }
        else if (!ca) { going = 0; result = 1; }
        else { i += 1; }
    }
    return result;
}

// Directory portion of `path` (a null-terminated string), trailing slash
// included so callers can concatenate directly, or a fresh empty string
// if `path` has no slash (same-directory relative resolution).
int dirname_with_slash(int path) {
    int len = slen(path);
    int i = 0;
    for (i = len - 1; i >= 0; i -= 1) {
        if (load8(path + i) == '/') {
            int out = alloc(i + 2);
            int k = 0;
            for (k = 0; k <= i; k += 1) {
                store8(out + k, load8(path + k));
            }
            store8(out + i + 1, 0);
            return out;
        }
    }
    int empty = alloc(1);
    store8(empty, 0);
    return empty;
}

int join_path(int dir, int rel) {
    int dl = slen(dir);
    int rl = slen(rel);
    int out = alloc(dl + rl + 1);
    int i = 0;
    for (i = 0; i < dl; i += 1) {
        store8(out + i, load8(dir + i));
    }
    int j = 0;
    for (j = 0; j < rl; j += 1) {
        store8(out + dl + j, load8(rel + j));
    }
    store8(out + dl + rl, 0);
    return out;
}

void expand_putc(int c) {
    if (expand_len >= EXPAND_CAP) {
        print("LEXERROR\n");
        exit(1);
    }
    store8(expand_buf + expand_len, c);
    expand_len += 1;
    return;
}

// Reads `path`, scans its raw text for `include "X";` directives (copying
// everything else through unchanged, including string literals and //
// comments verbatim so neither can trigger a false match), and recursively
// expands each include in place -- appending the result into the shared
// expand_buf/expand_len globals. include_stack/include_depth guard against
// a file including itself, directly or transitively.
void expand_file(int path) {
    int i = 0;
    for (i = 0; i < include_depth; i += 1) {
        if (streq_(load64(include_stack + i * 8), path) == 1) {
            print("LEXERROR\n");
            exit(1);
        }
    }
    if (include_depth >= INCLUDE_MAX_DEPTH) {
        print("LEXERROR\n");
        exit(1);
    }
    // Include-once, so a file reached a second time (a diamond) is skipped.
    i = 0;
    for (i = 0; i < n_included; i += 1) {
        if (streq_(load64(included + i * 8), path) == 1) { return; }
    }
    if (n_included >= MAX_INCLUDED) {
        print("LEXERROR\n");
        exit(1);
    }
    store64(included + n_included * 8, path);
    n_included += 1;
    store64(include_stack + include_depth * 8, path);
    include_depth += 1;

    int fd = open_read(path);
    if (fd < 0) {
        print("LEXERROR\n");
        exit(1);
    }
    int src = alloc(1048576);
    int n = 0;
    int got = read(fd, src, 1048576);
    while (got > 0) {
        n += got;
        got = read(fd, src + n, 1048576 - n);
    }
    close(fd);

    int dir = dirname_with_slash(path);
    int p = 0;
    while (p < n) {
        int c = load8(src + p);
        if (c == '"') {
            expand_putc(c);
            p += 1;
            int scanning = 1;
            while (scanning == 1) {
                if (p >= n || load8(src + p) == '"') { scanning = 0; }
                else {
                    int sc = load8(src + p);
                    if (sc == '\\' && p + 1 < n) {
                        expand_putc(sc);
                        p += 1;
                        expand_putc(load8(src + p));
                        p += 1;
                    } else {
                        expand_putc(sc);
                        p += 1;
                    }
                }
            }
            if (p < n) { expand_putc('"'); p += 1; }
        } else if (c == '\'') {
            // Char literals ('x', including quote characters like '"' or
            // '\'') need the same verbatim-copy treatment as strings --
            // without this case, the scanner has no notion of "inside a
            // char literal" at all, so a literal like '"' would make it
            // wrongly enter STRING mode at that bare `"` instead, scanning
            // forward to whatever `"` happens to appear next in the file.
            // This function's own source contains `!= '"'`.
            expand_putc(c);
            p += 1;
            if (p < n && load8(src + p) == '\\' && p + 1 < n) {
                expand_putc(load8(src + p));
                p += 1;
                expand_putc(load8(src + p));
                p += 1;
            } else if (p < n) {
                expand_putc(load8(src + p));
                p += 1;
            }
            if (p < n && load8(src + p) == '\'') {
                expand_putc('\'');
                p += 1;
            }
        } else if (c == '/' && p + 1 < n && load8(src + p + 1) == '/') {
            while (p < n && load8(src + p) != '\n') {
                expand_putc(load8(src + p));
                p += 1;
            }
        } else if (is_ident_start(c) == 1) {
            int start = p;
            while (p < n && is_ident_char(load8(src + p)) == 1) {
                p += 1;
            }
            int wlen = p - start;
            if (wlen == 7 && word_is(src, start, 7, "include") == 1) {
                int q = p;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != '"') { print("LEXERROR\n"); exit(1); }
                q += 1;
                int pstart = q;
                while (q < n && load8(src + q) != '"') { q += 1; }
                if (q >= n) { print("LEXERROR\n"); exit(1); }
                int rel = alloc(q - pstart + 1);
                int ri = 0;
                for (ri = 0; ri < q - pstart; ri += 1) {
                    store8(rel + ri, load8(src + pstart + ri));
                }
                store8(rel + (q - pstart), 0);
                q += 1;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != ';') { print("LEXERROR\n"); exit(1); }
                q += 1;
                expand_file(join_path(dir, rel));
                p = q;
            } else {
                int k = 0;
                for (k = start; k < p; k += 1) {
                    expand_putc(load8(src + k));
                }
            }
        } else {
            expand_putc(c);
            p += 1;
        }
    }

    include_depth -= 1;
    return;
}

int main() {
    int buf = 0;
    int n = 0;

    // An optional file argument (`lex1 file.c0`) is what makes include
    // resolution possible at all -- a relative include path needs a real
    // file to resolve relative to, which piped stdin content alone cannot
    // provide. With no argument, stdin is lexed as it is and includes are
    // not expanded.
    if (argc() == 2) {
        expand_buf = alloc(EXPAND_CAP);
        expand_len = 0;
        include_stack = alloc(INCLUDE_MAX_DEPTH * 8);
        included = alloc(MAX_INCLUDED * 8);
        expand_file(argv(1));
        buf = expand_buf;
        n = expand_len;
    } else {
        // A fixed 1MB buffer, generous headroom past any c0 source file.
        // Input beyond 1MB is cut off, which would surface as a confusing
        // parse error rather than a message about the buffer.
        buf = alloc(1048576);
        int got = read(0, buf, 1048576);
        while (got > 0) {
            n += got;
            got = read(0, buf + n, 1048576 - n);
        }
    }

    int pos = 0;
    int c = 0;
    int nxt = 0;
    int going = 0;
    int v = 0;
    int d = 0;
    int start = 0;
    int len = 0;
    int i = 0;
    int s = 0;
    int e = 0;
    int q = 0;
    int base = 0;
    int is_hex = 0;
    while (pos < n) {
        c = load8(buf + pos);

        if (c == ' ') { pos += 1; }
        else if (c == '\n') { pos += 1; }
        else if (c == '\t') { pos += 1; }
        else if (c == 13) { pos += 1; }

        else if (c == '/') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '/') {
                going = 1;
                while (going == 1) {
                    if (pos < n) {
                        if (load8(buf + pos) != '\n') { pos += 1; }
                        else { going = 0; }
                    } else { going = 0; }
                }
            } else if (nxt == '=') {
                print("SLASHEQ\n");
                pos += 2;
            } else {
                print("SLASH\n");
                pos += 1;
            }
        }

        else if (is_digit(c) == 1) {
            v = 0;
            base = 10;
            is_hex = 0;
            if (c == '0' && pos + 2 < n) {
                nxt = load8(buf + pos + 1);
                if ((nxt == 'x' || nxt == 'X') && is_hex_digit(load8(buf + pos + 2)) == 1) {
                    is_hex = 1;
                }
            }
            if (is_hex == 1) { pos += 2; base = 16; }
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    d = load8(buf + pos);
                    if (base == 16) {
                        if (is_hex_digit(d) == 1) {
                            v = v * 16 + hex_value(d);
                            pos += 1;
                        } else { going = 0; }
                    } else if (is_digit(d) == 1) {
                        v = v * 10 + (d - '0');
                        pos += 1;
                    } else { going = 0; }
                } else { going = 0; }
            }
            print("NUM ");
            print_int(v);
            print("\n");
        }

        else if (is_ident_start(c) == 1) {
            start = pos;
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    if (is_ident_char(load8(buf + pos)) == 1) { pos += 1; }
                    else { going = 0; }
                } else { going = 0; }
            }
            len = pos - start;
            if (word_is(buf, start, len, "int") == 1) { print("INT\n"); }
            else if (word_is(buf, start, len, "if") == 1) { print("IF\n"); }
            else if (word_is(buf, start, len, "else") == 1) { print("ELSE\n"); }
            else if (word_is(buf, start, len, "while") == 1) { print("WHILE\n"); }
            else if (word_is(buf, start, len, "for") == 1) { print("FOR\n"); }
            else if (word_is(buf, start, len, "defer") == 1) { print("DEFER\n"); }
            else if (word_is(buf, start, len, "return") == 1) { print("RETURN\n"); }
            else if (word_is(buf, start, len, "break") == 1) { print("BREAK\n"); }
            else if (word_is(buf, start, len, "continue") == 1) { print("CONTINUE\n"); }
            else if (word_is(buf, start, len, "void") == 1) { print("VOID\n"); }
            else if (word_is(buf, start, len, "extern") == 1) { print("EXTERN\n"); }
            else if (word_is(buf, start, len, "layout") == 1) { print("LAYOUT\n"); }
            else if (word_is(buf, start, len, "sizeof") == 1) { print("SIZEOF\n"); }
            else {
                print("IDENT ");
                for (i = start; i < pos; i += 1) {
                    print_char(load8(buf + i));
                }
                print("\n");
            }
        }

        else if (c == '"') {
            pos += 1;
            print("STR");
            going = 1;
            while (going == 1) {
                if (pos >= n) { print("\nLEXERROR\n"); return 1; }
                s = load8(buf + pos);
                if (s == '"') {
                    going = 0;
                    pos += 1;
                } else if (s == '\\') {
                    pos += 1;
                    if (pos >= n) { print("\nLEXERROR\n"); return 1; }
                    e = load8(buf + pos);
                    v = 0 - 1;
                    if (e == 'n') { v = '\n'; }
                    if (e == 't') { v = '\t'; }
                    if (e == '\\') { v = '\\'; }
                    if (e == '"') { v = '"'; }
                    if (v < 0) { print("\nLEXERROR\n"); return 1; }
                    print(" ");
                    print_int(v);
                    pos += 1;
                } else {
                    print(" ");
                    print_int(s);
                    pos += 1;
                }
            }
            print("\n");
        }

        else if (c == '\'') {
            pos += 1;
            if (pos >= n) { print("LEXERROR\n"); return 1; }
            v = 0 - 1;
            e = load8(buf + pos);
            if (e == '\\') {
                pos += 1;
                if (pos >= n) { print("LEXERROR\n"); return 1; }
                q = load8(buf + pos);
                if (q == 'n') { v = '\n'; }
                if (q == 't') { v = '\t'; }
                if (q == '\\') { v = '\\'; }
                if (q == '\'') { v = '\''; }
                if (q == '0') { v = 0; }
                if (v < 0) {
                    if (q != '0') { print("LEXERROR\n"); return 1; }
                }
                pos += 1;
            } else {
                if (e == '\'') { print("LEXERROR\n"); return 1; }
                v = e;
                pos += 1;
            }
            if (pos >= n) { print("LEXERROR\n"); return 1; }
            if (load8(buf + pos) != '\'') { print("LEXERROR\n"); return 1; }
            pos += 1;
            print("NUM ");
            print_int(v);
            print("\n");
        }

        else if (c == '=') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("EQ\n"); pos += 2; }
            else { print("ASSIGN\n"); pos += 1; }
        }
        else if (c == '!') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("NE\n"); pos += 2; }
            else { print("NOT\n"); pos += 1; }
        }
        else if (c == '<') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("LE\n"); pos += 2; }
            else if (nxt == '<') { print("SHL\n"); pos += 2; }
            else { print("LT\n"); pos += 1; }
        }
        else if (c == '>') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("GE\n"); pos += 2; }
            else if (nxt == '>') { print("SHR\n"); pos += 2; }
            else { print("GT\n"); pos += 1; }
        }
        else if (c == '&') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '&') { print("AND\n"); pos += 2; }
            else { print("AMP\n"); pos += 1; }
        }
        else if (c == '|') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '|') { print("OR\n"); pos += 2; }
            else { print("PIPE\n"); pos += 1; }
        }
        else if (c == '+') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("PLUSEQ\n"); pos += 2; }
            else { print("PLUS\n"); pos += 1; }
        }
        else if (c == '-') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("MINUSEQ\n"); pos += 2; }
            else { print("MINUS\n"); pos += 1; }
        }
        else if (c == '*') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("STAREQ\n"); pos += 2; }
            else { print("STAR\n"); pos += 1; }
        }
        else if (c == '%') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { print("PERCENTEQ\n"); pos += 2; }
            else { print("PERCENT\n"); pos += 1; }
        }
        else if (c == '^') { print("CARET\n"); pos += 1; }
        else if (c == '~') { print("TILDE\n"); pos += 1; }
        else if (c == '(') { print("LPAREN\n"); pos += 1; }
        else if (c == ')') { print("RPAREN\n"); pos += 1; }
        else if (c == '{') { print("LBRACE\n"); pos += 1; }
        else if (c == '}') { print("RBRACE\n"); pos += 1; }
        else if (c == ';') { print("SEMI\n"); pos += 1; }
        else if (c == ',') { print("COMMA\n"); pos += 1; }
        else if (c == '[') { print("LBRACKET\n"); pos += 1; }
        else if (c == ']') { print("RBRACKET\n"); pos += 1; }
        else if (c == '.') { print("DOT\n"); pos += 1; }
        else { print("LEXERROR\n"); return 1; }
    }

    print("EOF\n");
    return 0;
}
