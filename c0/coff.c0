// This file IS the compiler. Lexer, parser, resolver and code generator
// in one file; the binary built from it is called coff1. Called as
// `coff1 [--elf] [-I dir]... input.c0 output.s` it reads and writes real
// files; with no file arguments it reads stdin and writes stdout (the form
// the differential test harness uses).
//
// The output is byte-for-byte identical to what coff0 produces for the
// same input, and so are the error messages. On any lex, parse or resolve
// error it prints the same message coff0 would and exits 1, same rule as
// coff0, so nothing is emitted until the whole program is known to be
// valid.
//
// coff0 compiling coff.c0 (stage 1) and coff.c0 compiling itself (stage
// 2) produce identical assembly, and stage 2 compiling coff.c0 again
// (stage 3) matches stage 2, which makes it a real bootstrap fixpoint. See
// the fixpoint checks in run_tests.sh.
//
// The records the compiler works with (Token, Node, Function, Global,
// Layout and the rest) are declared as `layout` blocks below, so the
// feature is exercised by the compiler that implements it.
// Token kinds are 1 NUM, 2 IDENT, 3 STR, 4 PLUS, 5 MINUS, 6 STAR, 7 SLASH,
//   8 ASSIGN, 9 EQ, 10 NE, 11 LT, 12 LE, 13 GT, 14 GE, 15 LPAREN,
//   16 RPAREN, 17 LBRACE, 18 RBRACE, 19 SEMI, 20 COMMA, 21 INT, 22 IF,
//   23 ELSE, 24 WHILE, 25 RETURN, 26 EOF, 27 AND, 28 OR, 29 BREAK, 30 CONTINUE,
//   31 LBRACKET, 32 RBRACKET, 33 VOID, 34 EXTERN, 35 DOT, 36 LAYOUT,
//   37 SIZEOF, 38 PERCENT, 39 AMP, 40 PIPE, 41 CARET, 42 TILDE, 43 SHL,
//   44 SHR, 45 NOT, 46 PLUSEQ, 47 MINUSEQ, 48 STAREQ, 49 SLASHEQ,
//   50 PERCENTEQ, 51 FOR, 52 DEFER.
//
// Node kinds use the same numbering as parse.c0 (1 NUM .. 22 BLOCK), plus
//   23 AND, 24 OR (both short-circuiting; precedence between equality and
//   the statement grammar, || loosest of the two), 25 BREAK, 26 CONTINUE
//   (both only valid inside a loop, which resolve() enforces),
//   27 INDEX (child1=base, child2=index; buf[i] sugar over load8(buf+i)),
//   28 INDEXASSIGN (child1=base, child2=index, child3=value),
//   29 FUNCREF (a VAR node (kind 3) whose name turned out to be a declared
//   function rather than a variable/global -- resolve() rewrites its kind
//   in place; evaluates to the function's address via `lea`). A CALL node
//   (kind 6) uses its `extra` field to say whether `name` is a variable
//   holding a function-reference value rather than a declared function, so
//   gen_call must call *through* its value instead of calling `name`
//   directly (indirect call). 30 FIELD, 31 FIELDASSIGN and 32 SIZEOF are
//   as in parse.c0, and 33 MOD is child1 % child2, same shape as DIV.
//   34 BITAND, 35 BITOR, 36 BITXOR, 37 SHL and 38 SHR are binary like DIV,
//   39 BITNOT is unary like NEG.
//   40 FORLOOP is child1=cond, child2=body, child3=step. `for` parses to a
//   BLOCK holding the init statement then a FORLOOP, so `continue` runs the
//   step (it jumps to .Lstep, not the condition).
//   41 MULTIASSIGN is `a, b = f(...)`, with child1=the two-value call,
//   child2=target1 VAR, child3=target2 VAR. The call leaves value1 in rax
//   and value2 in rdx.
//   42 DEFER is `defer <stmt>;` with child1=the statement. It emits nothing
//   where it stands, and gen_function runs every collected child1 at .Lret
//   in reverse order.
//
// The field order of Layout and LayoutField (name, next, ...) is
// deliberate, not alphabetical. Both declare `name` first and `next`
// second, so the two agree on `next`'s position (offset 8) although their
// later fields differ -- the shared-field-offset-table rule (see
// field_declare_or_check below) would otherwise reject two record shapes
// that disagree on where their own `next` pointer lives.

layout LayoutField {
    int name;
    int next;
    int lffile;
    int lfline;
}

layout Layout {
    int name;
    int next;
    int fields;
    int lfile;
    int lline;
}

// Token's third field is named `sval` rather than `name` -- it holds an
// identifier's text or a decoded string literal's bytes, a different role
// than Layout/LayoutField/Global/Function's own first-field `name`, which
// already claims offset 0 in the shared field table. `kind`/`ival`/`len`
// are used by no other layout at a different offset.
layout Token {
    int kind;
    int ival;
    int sval;
    int len;
    int tfile;  // where the token starts, mapped back through include
    int tline;  // expansion (see loc_at)
}

// `next` comes before `init` (not the order name/init/next one would
// naively expect) so it lands at offset 8, matching Layout/LayoutField's
// own `next` -- same field-table-conflict reasoning as those two.
layout Global {
    int name;
    int next;
    int init;
    int gfile;  // the name's location, for error messages
    int gline;
    int gtype;  // the layout it was declared with (`Point origin;`), or 0 for int
    int gembed; // name_size of the n-th embed, as n + 1; 0 for an ordinary global
}

// `embed name "file";` -- mirrors coff0.c's Embed, the file's bytes as data
// (.incbin), `name` their address, `name_size` their length worked out by
// the assembler. The compiler never opens the file.
layout Embed {
    int name;
    int epath;      // as written
    int eresolved;  // joined with the source file's directory
    int enext;
    int efile;
    int eline;
}

int embhead = 0;
int embtail = 0;

// The inline 6-slot register-param array is indexed at runtime by
// param_name_at, and `layout` has no notion of an array-shaped field, so
// it is spelled out as p0..p5 and read as f+56+i*8. It comes after every
// field that is read by name. `fnext` (not `next`) since Function's own
// list-link falls at offset 24 here, not 8 -- forcing it to 8 would mean
// moving `nparams` (read far more often) out of its natural early position
// for no real benefit.
layout Function {
    int name;
    int nparams;
    int body;
    int fnext;
    int stack_size;
    int is_void;
    int extra_params;
    int p0;
    int p1;
    int p2;
    int p3;
    int p4;
    int p5;
    int ffile;  // the name's location, for error messages
    int fline;
    int ptypes; // alloc'd 16 * 8, each parameter's layout type, or 0 for int
    int two_ret; // declared "(int, int)" -- returns two values, in rax and rdx
}

// The 7th-parameter-onward linked list. Same (name, next) shape as
// LayoutField -- declared separately anyway, purely for self-documentation
// at each use site, not because the field table treats it any differently.
layout ExtraParam {
    int name;
    int next;
}

// AST node. `sval`/`len` match Token's own field names (offsets 16/24) on
// purpose -- both hold "an identifier's or string's text/length," the
// same role in both records, so there is no reason to invent different
// names for them. `child1`/`child2`/`child3`
// stay generic (not `lhs`/`rhs`/`cond`/`then`) because a single flat node
// shape serves every node kind -- child1 means lhs for a binary op, cond
// for an if, the args-list head for a call, depending on `kind`; a more
// "specific"-looking name would be accurate for some kinds and misleading
// for others. `sibling` (not `next`) since offset 56 does not match
// Layout/LayoutField/Global's `next`=8. `extra` is reused per-kind (VAR/ASSIGN
// is_global flag, STR string-table index assigned at parse time so the
// numbering matches coff0's, CALL's direct/indirect-call marker).
layout Node {
    int kind;
    int ival;
    int sval;
    int len;
    int child1;
    int child2;
    int child3;
    int sibling;
    int extra;
    int nfile;  // where the node came from, for error messages
    int nline;
}

// Field names are one namespace across every layout and a name keeps one
// offset everywhere, which is why each record above spells its location
// fields differently (tfile, ffile, gfile ...) instead of sharing `file`.

int toks = 0;
int tpos = 0;
int src_name = 0; // the input path, for diagnostics; set in main()

int fhead = 0;
int ghead = 0;
int ehead = 0;
int etail = 0;
int lhead = 0;
int ltail = 0;

int sym_names = 0;
int sym_offsets = 0;
int sym_types = 0;   // alloc'd 4096 * 8, a variable's layout type, or 0 for int
int sym_count = 0;
int stack_size = 0;
int loop_depth = 0;
int current_fn_is_void = 0;
int current_fn_two_ret = 0;
int resolving_multi_call = 0;
int in_defer = 0;   // set while resolving a deferred statement; it may not return, break, continue or defer

int scope_marks = 0;
int scope_depth = 0;

int string_ptrs = 0;
int string_lens = 0;
int string_count = 0;

int label_count = 0;
int current_ret_label = 0;

int loop_labels = 0;
int loop_is_for = 0;
int gen_loop_depth = 0;

int defers = 0;     // alloc'd 64 * 8, deferred statements collected while generating a function body
int n_defers = 0;   // reset per function; emitted in reverse at .Lret

int outfd = 1;

// --- --elf, the Moonshot ring-3 target -------------------------------------
// The same assembly backend, aimed at Moonshot instead of Linux. The entry
// stub and the builtins that reach the operating system (print, exit,
// alloc, and the ring-3 syscalls win_info/fill/...) emit Moonshot's syscall
// numbers, everything else is identical. smed assembles the result into the
// ELF image Moonshot loads into ring 3 (`smed --base 0x80000000`).
//
// There is deliberately no second backend for this. Ring-3 programs go
// through the one backend that is checked against coff0.c on every test
// run, and through smed, which is checked against GNU as. The mode is a
// handful of emit() lines that differ in a syscall number.
int elf_mode = 0;

// Include-expansion state -- see the "includes" section below (right
// after copy_bytes/streq) for the real logic; these are just the shared
// globals it needs across recursive calls.
int INCLUDE_MAX_DEPTH = 32;
int include_stack = 0; // alloc'd once, INCLUDE_MAX_DEPTH * 8 bytes
int include_depth = 0;
// Every file ever spliced, by resolved path, so a diamond (two files both
// including a third) splices it once and skips it after. A true cycle is
// still caught by include_stack before this. Mirrors coff0.c's `included`.
int MAX_INCLUDED = 256;
int included = 0; // alloc'd once, MAX_INCLUDED * 8 bytes
int n_included = 0;
int EXPAND_CAP = 4194304; // 4MB
int expand_buf = 0;
int expand_len = 0;

// --- shared helpers (same as parse.c0) -------------------------------------

int strlen_(int s) {
    int i = 0;
    while (s[i] != 0) { i += 1; }
    return i;
}

// All generated-assembly output goes through emit() rather than the print()
// builtin, since print() always targets stdout — emit() targets outfd, which
// main() points at the output file when one is given (see the CLI handling
// at the top of main), or stdout otherwise.
void emit(int s) {
    write(outfd, s, strlen_(s));
    return;
}

int is_digit(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

int is_hex_digit(int c) {
    if (is_digit(c) == 1) { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int hex_value(int c) {
    if (is_digit(c) == 1) { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

int is_ident_start(int c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

int is_ident_char(int c) {
    if (is_digit(c) == 1) { return 1; }
    return is_ident_start(c);
}

void print_int(int v) {
    int tmp = alloc(32);
    int neg = 0;
    int i = 31;
    if (!v) { emit("0"); return; }
    if (v < 0) { neg = 1; v = 0 - v; }
    while (v > 0) {
        i -= 1;
        tmp[i] = '0' + (v % 10);
        v /= 10;
    }
    if (neg == 1) { i -= 1; tmp[i] = '-'; }
    emit(tmp + i);
    return;
}

int word_is(int buf, int start, int len, int kw) {
    int k = 0;
    int i = 0;
    for (i = 0; i < len; i += 1) {
        k = kw[i];
        if (!k) { return 0; }
        if (buf[start + i] != k) { return 0; }
    }
    if (kw[len] != 0) { return 0; }
    return 1;
}

int copy_bytes(int buf, int start, int len) {
    int p = alloc(len + 1);
    int i = 0;
    for (i = 0; i < len; i += 1) {
        p[i] = buf[start + i];
    }
    return p;
}

// Both sides are null-terminated byte pointers (identifiers and string
// literals are always alloc'd fresh, hence zero-terminated).
int streq(int a, int b) {
    int i = 0;
    int going = 1;
    int result = 0;
    int ca = 0;
    int cb = 0;
    while (going == 1) {
        ca = a[i];
        cb = b[i];
        if (ca != cb) { going = 0; }
        else if (!ca) { going = 0; result = 1; }
        else { i += 1; }
    }
    return result;
}

// -------------------------------------------------------------- includes
//
// `include "path.c0";` is pure textual substitution, resolved entirely
// before real lexing starts -- mirrors coff0.c's resolve_includes exactly
// (differentially verified against it, and against lex.c0/parse.c0's own
// identical mirrors), see coff0.c for the full design rationale. This is
// the copy that matters most, since coff.c0 is what coff1 is.

// -I directories, each with a trailing slash so join_path can use it like an
// including file's own directory. An include is looked for next to the file
// that includes it first, and only when it is not there, in these, in order.
// That is what lets programs in different directories (and in different
// places in the dev and release trees) share one library by name. Mirrors
// coff0.c's inc_dirs.
int MAX_INC_DIRS = 8;
int inc_dirs = 0;
int n_inc_dirs = 0;

// Directory portion of `path` (a null-terminated string), trailing slash
// included so callers can concatenate directly, or a fresh empty string
// if `path` has no slash (same-directory relative resolution).
int dirname_with_slash(int path) {
    int len = strlen_(path);
    int i = 0;
    for (i = len - 1; i >= 0; i -= 1) {
        if (load8(path + i) == '/') {
            return copy_bytes(path, 0, i + 1);
        }
    }
    int empty = alloc(1);
    store8(empty, 0);
    return empty;
}

int join_path(int dir, int rel) {
    int dl = strlen_(dir);
    int rl = strlen_(rel);
    int out = alloc(dl + rl + 1);
    int i = 0;
    for (i = 0; i < dl; i += 1) {
        store8(out + i, load8(dir + i));
    }
    int j = 0;
    for (j = 0; j < rl; j += 1) {
        store8(out + dl + j, load8(rel + j));
    }
    store8(out + dl + rl, 0);
    return out;
}

void expand_putc(int c) {
    if (expand_len >= EXPAND_CAP) {
        // coff0 has no such cap (it grows its buffer), so this message is
        // coff1's own.
        eput("include: source with includes expanded is over ");
        eput_int(EXPAND_CAP);
        eput(" bytes");
        efail();
    }
    store8(expand_buf + expand_len, c);
    expand_len += 1;
    return;
}

// Reads `path`, scans its raw text for `include "X";` directives (copying
// everything else through unchanged, including string literals, char
// literals, and // comments verbatim so none of them can trigger a false
// match), and recursively expands each include in place -- appending the
// result into the shared expand_buf/expand_len globals. include_stack/
// include_depth guard against a file including itself, directly or
// transitively. Char literals get the SAME verbatim-copy treatment as
// strings deliberately. Without it, a literal like '"' makes the scanner
// wrongly enter STRING mode at that bare `"` instead, scanning forward to
// whatever `"` happens to appear next in the file (this function itself
// contains `!= '"'`).

// Reads everything fd has into a buffer that doubles whenever it fills, and
// leaves the length in read_all_len. A fixed buffer would silently cut off
// a large source file, and coff0.c reads into a growing buffer, so this
// does too and the two compilers agree on any file.
int read_all_len = 0;
int read_all(int fd) {
    int cap = 1048576;
    int buf = alloc(cap);
    int n = 0;
    int got = read(fd, buf, cap);
    while (got > 0) {
        n += got;
        if (n == cap) {
            int bigger = alloc(cap * 2);
            int k = 0;
            for (k = 0; k < n; k += 8) { store64(bigger + k, load64(buf + k)); }
            buf = bigger;
            cap *= 2;
        }
        got = read(fd, buf + n, cap - n);
    }
    read_all_len = n;
    return buf;
}

void expand_file(int path) {
    int i = 0;
    for (i = 0; i < n_included; i += 1) {
        if (streq(load64(included + i * 8), path) == 1) { return; }
    }
    if (n_included >= MAX_INCLUDED) { die("include: too many distinct files"); }
    store64(included + n_included * 8, path);
    n_included += 1;
    store64(include_stack + include_depth * 8, path);
    include_depth += 1;

    int fd = open_read(path);
    if (fd < 0) { die_open(path, fd); }
    int src = read_all(fd);
    int n = read_all_len;
    close(fd);

    int dir = dirname_with_slash(path);
    int p = 0;
    add_seg(expand_len, path, 1);
    while (p < n) {
        int c = load8(src + p);
        if (c == '"') {
            expand_putc(c);
            p += 1;
            int scanning = 1;
            while (scanning == 1) {
                if (p >= n || load8(src + p) == '"') { scanning = 0; }
                else {
                    int sc = load8(src + p);
                    if (sc == '\\' && p + 1 < n) {
                        expand_putc(sc);
                        p += 1;
                        expand_putc(load8(src + p));
                        p += 1;
                    } else {
                        expand_putc(sc);
                        p += 1;
                    }
                }
            }
            if (p < n) { expand_putc('"'); p += 1; }
        } else if (c == '\'') {
            expand_putc(c);
            p += 1;
            if (p < n && load8(src + p) == '\\' && p + 1 < n) {
                expand_putc(load8(src + p));
                p += 1;
                expand_putc(load8(src + p));
                p += 1;
            } else if (p < n) {
                expand_putc(load8(src + p));
                p += 1;
            }
            if (p < n && load8(src + p) == '\'') {
                expand_putc('\'');
                p += 1;
            }
        } else if (c == '/' && p + 1 < n && load8(src + p + 1) == '/') {
            while (p < n && load8(src + p) != '\n') {
                expand_putc(load8(src + p));
                p += 1;
            }
        } else if (is_ident_start(c) == 1) {
            int start = p;
            while (p < n && is_ident_char(load8(src + p)) == 1) {
                p += 1;
            }
            int wlen = p - start;
            if (wlen == 7 && word_is(src, start, 7, "include") == 1) {
                // Every problem with a directive is reported at the directive.
                err_file = path;
                err_line = line_in(src, src + start);
                int q = p;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != '"') { die("include: expected a string after 'include'"); }
                q += 1;
                int pstart = q;
                while (q < n && load8(src + q) != '"') { q += 1; }
                if (q >= n) { die("include: unterminated path string"); }
                int rel = copy_bytes(src, pstart, q - pstart);
                q += 1;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != ';') { die("include: expected ';' after the include path"); }
                q += 1;
                int inc_path = join_path(dir, rel);
                // Not next to the including file, so try each -I directory
                // in order (see inc_dirs).
                int found = open_read(inc_path);
                if (found >= 0) { close(found); }
                if (found < 0 && load8(rel) != '/') {
                    int k = 0;
                    while (k < n_inc_dirs) {
                        int cand = join_path(load64(inc_dirs + k * 8), rel);
                        int fd = open_read(cand);
                        if (fd >= 0) { close(fd); inc_path = cand; k = n_inc_dirs; }
                        k += 1;
                    }
                }
                i = 0;
                for (i = 0; i < include_depth; i += 1) {
                    if (streq(load64(include_stack + i * 8), inc_path) == 1) {
                        die3("include: circular include of ", inc_path, "");
                    }
                }
                if (include_depth >= INCLUDE_MAX_DEPTH) {
                    eopen();
                    eput("include: nested more than ");
                    eput_int(INCLUDE_MAX_DEPTH);
                    eput(" files deep");
                    efail();
                }
                int probe = open_read(inc_path);
                if (probe < 0) { die3("include: cannot open ", inc_path, ""); }
                close(probe);
                expand_file(inc_path);
                // back in this file, at the line the directive ended on
                add_seg(expand_len, path, line_in(src, src + q));
                p = q;
            } else {
                int k = 0;
                for (k = start; k < p; k += 1) {
                    expand_putc(load8(src + k));
                }
            }
        } else {
            expand_putc(c);
            p += 1;
        }
    }

    include_depth -= 1;
    return;
}

// --- diagnostics
//
// Every error coff1 can report says the same thing coff0 says for the same
// input, in the same shape (`coff1: <file>: <message>` on stderr, exit 1).
// run_tests.sh diffs the two compilers' messages over every compile-error
// test. Messages are built from pieces because c0 has no printf. eopen()
// writes the prefix, eput()/eput_int()/eput_char() add to the line and
// efail() ends it and exits. die()/die3() cover the common shapes.

void eput(int s) {
    write(2, s, strlen_(s));
    return;
}

void eput_int(int v) {
    int tmp = alloc(32);
    int neg = 0;
    int i = 31;
    if (!v) { eput("0"); return; }
    if (v < 0) { neg = 1; v = 0 - v; }
    while (v > 0) {
        i -= 1;
        tmp[i] = '0' + (v % 10);
        v /= 10;
    }
    if (neg == 1) { i -= 1; tmp[i] = '-'; }
    eput(tmp + i);
    return;
}

void eput_char(int c) {
    int b = alloc(1);
    store8(b, c);
    write(2, b, 1);
    return;
}

// Where the next error points, kept current by every phase exactly as in
// coff0.c. The lexer sets it at each token's start, the parser at the last token
// read, resolve and codegen at their node, the declaration checks at the
// declaration's name. Line 0 means the whole file.
int err_file = 0;
int err_line = 0;

void eopen() {
    eput("coff1: ");
    if (err_line > 0) {
        eput(err_file);
        eput(":");
        eput_int(err_line);
    } else {
        eput(src_name);
    }
    eput(": ");
    return;
}

// Include expansion flattens every file into one buffer. The expander
// records a segment (buffer offset, file, line) each time it starts copying
// from a file, and loc_at() walks them forward to turn a buffer offset back
// into a file and line. Same scheme as coff0.c's add_seg/loc_at.
int SEG_CAP = 4096;
int seg_off = 0;
int seg_file = 0;
int seg_line = 0;
int nseg = 0;
int loc_seg = 0;
int loc_off = 0;
int loc_line = 1;

void add_seg(int off, int file, int line) {
    if (!seg_off) {
        seg_off = alloc(SEG_CAP * 8);
        seg_file = alloc(SEG_CAP * 8);
        seg_line = alloc(SEG_CAP * 8);
    }
    if (nseg >= SEG_CAP) { die("too many include segments (max 4096)"); }
    store64(seg_off + nseg * 8, off);
    store64(seg_file + nseg * 8, file);
    store64(seg_line + nseg * 8, line);
    nseg += 1;
    return;
}

// Moves the cursor to byte `off` of buf and leaves the answer in
// err_file/err_line. Offsets only ever increase, as the lexer moves forward.
void loc_at(int buf, int off) {
    while (loc_seg + 1 < nseg && load64(seg_off + (loc_seg + 1) * 8) <= off) {
        loc_seg += 1;
        loc_off = load64(seg_off + loc_seg * 8);
        loc_line = load64(seg_line + loc_seg * 8);
    }
    while (loc_off < off) {
        if (load8(buf + loc_off) == '\n') { loc_line += 1; }
        loc_off += 1;
    }
    err_file = load64(seg_file + loc_seg * 8);
    err_line = loc_line;
    return;
}

// The line `at` is on, counting from `src`.
int line_in(int src, int at) {
    int line = 1;
    int c = 0;
    for (c = src; c < at; c += 1) {
        if (load8(c) == '\n') { line += 1; }
    }
    return line;
}

// Points the next error at the last token the parser read.
void at_prev() {
    int i = 0;
    if (tpos > 0) { i = tpos - 1; }
    err_file = (toks + i * sizeof(Token)).tfile;
    err_line = (toks + i * sizeof(Token)).tline;
    return;
}

void efail() {
    eput("\n");
    exit(1);
    return;
}

void die(int msg) {
    eopen();
    eput(msg);
    efail();
    return;
}

void die3(int a, int b, int c) {
    eopen();
    eput(a);
    eput(b);
    eput(c);
    efail();
    return;
}

void die_char(int msg, int c) {
    eopen();
    eput(msg);
    eput_char(c);
    eput("'");
    efail();
    return;
}

// A file that will not open. coff0 uses perror(), so the common cases are
// spelled the way libc spells them; open() hands back -errno.
void die_open(int path, int err) {
    eput(path);
    if (err == 0 - 2) { eput(": No such file or directory"); }
    else if (err == 0 - 13) { eput(": Permission denied"); }
    else { eput(": cannot open (error "); eput_int(0 - err); eput(")"); }
    efail();
    return;
}


void tok_put(int i, int kind, int ival, int name, int len) {
    int p = toks + i * sizeof(Token);
    p.kind = kind;
    p.ival = ival;
    p.sval = name;
    p.len = len;
    p.tfile = err_file;  // lex_all keeps these at the token's start
    p.tline = err_line;
    return;
}

int tok_kind(int i) { return (toks + i * sizeof(Token)).kind; }
int tok_ival(int i) { return (toks + i * sizeof(Token)).ival; }
int tok_name(int i) { return (toks + i * sizeof(Token)).sval; }
int tok_len(int i)  { return (toks + i * sizeof(Token)).len; }

// Lex all of buf[0..n) into the global token array; appends an EOF token.
void lex_all(int buf, int n) {
    int pos = 0;
    int t = 0;
    int c = 0;
    int nxt = 0;
    int going = 0;
    int v = 0;
    int d = 0;
    int start = 0;
    int len = 0;
    int s = 0;
    int e = 0;
    int q = 0;
    int name = 0;
    int sbuf = 0;
    int slen = 0;
    int base = 0;
    int is_hex = 0;

    toks = alloc((n + 2) * sizeof(Token));
    if (!nseg) { add_seg(0, src_name, 1); }
    loc_seg = 0;
    loc_off = 0;
    loc_line = load64(seg_line);

    while (pos < n) {
        loc_at(buf, pos);
        c = load8(buf + pos);

        if (c == ' ') { pos += 1; }
        else if (c == '\n') { pos += 1; }
        else if (c == '\t') { pos += 1; }
        else if (c == 13) { pos += 1; }

        else if (c == '/') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '/') {
                going = 1;
                while (going == 1) {
                    if (pos < n) {
                        if (load8(buf + pos) != '\n') { pos += 1; }
                        else { going = 0; }
                    } else { going = 0; }
                }
            } else if (nxt == '=') {
                tok_put(t, 49, 0, 0, 0);
                t += 1;
                pos += 2;
            } else {
                tok_put(t, 7, 0, 0, 0);
                t += 1;
                pos += 1;
            }
        }

        else if (is_digit(c) == 1) {
            v = 0;
            base = 10;
            is_hex = 0;
            if (c == '0' && pos + 2 < n) {
                nxt = load8(buf + pos + 1);
                if ((nxt == 'x' || nxt == 'X') && is_hex_digit(load8(buf + pos + 2)) == 1) {
                    is_hex = 1;
                }
            }
            if (is_hex == 1) { pos += 2; base = 16; }
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    d = load8(buf + pos);
                    if (base == 16) {
                        if (is_hex_digit(d) == 1) {
                            v = v * 16 + hex_value(d);
                            pos += 1;
                        } else { going = 0; }
                    } else if (is_digit(d) == 1) {
                        v = v * 10 + (d - '0');
                        pos += 1;
                    } else { going = 0; }
                } else { going = 0; }
            }
            tok_put(t, 1, v, 0, 0);
            t += 1;
        }

        else if (is_ident_start(c) == 1) {
            start = pos;
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    if (is_ident_char(load8(buf + pos)) == 1) { pos += 1; }
                    else { going = 0; }
                } else { going = 0; }
            }
            len = pos - start;
            if (word_is(buf, start, len, "int") == 1) { tok_put(t, 21, 0, 0, 0); }
            else if (word_is(buf, start, len, "if") == 1) { tok_put(t, 22, 0, 0, 0); }
            else if (word_is(buf, start, len, "else") == 1) { tok_put(t, 23, 0, 0, 0); }
            else if (word_is(buf, start, len, "while") == 1) { tok_put(t, 24, 0, 0, 0); }
            else if (word_is(buf, start, len, "for") == 1) { tok_put(t, 51, 0, 0, 0); }
            else if (word_is(buf, start, len, "defer") == 1) { tok_put(t, 52, 0, 0, 0); }
            else if (word_is(buf, start, len, "return") == 1) { tok_put(t, 25, 0, 0, 0); }
            else if (word_is(buf, start, len, "break") == 1) { tok_put(t, 29, 0, 0, 0); }
            else if (word_is(buf, start, len, "continue") == 1) { tok_put(t, 30, 0, 0, 0); }
            else if (word_is(buf, start, len, "void") == 1) { tok_put(t, 33, 0, 0, 0); }
            else if (word_is(buf, start, len, "extern") == 1) { tok_put(t, 34, 0, 0, 0); }
            else if (word_is(buf, start, len, "layout") == 1) { tok_put(t, 36, 0, 0, 0); }
            else if (word_is(buf, start, len, "sizeof") == 1) { tok_put(t, 37, 0, 0, 0); }
            else {
                name = copy_bytes(buf, start, len);
                tok_put(t, 2, 0, name, len);
            }
            t += 1;
        }

        else if (c == '"') {
            pos += 1;
            sbuf = alloc(n + 1);
            slen = 0;
            going = 1;
            while (going == 1) {
                if (pos >= n) { die("unterminated string literal"); }
                s = load8(buf + pos);
                if (s == '"') {
                    going = 0;
                    pos += 1;
                } else if (s == '\\') {
                    pos += 1;
                    if (pos >= n) { die("unterminated string literal"); }
                    e = load8(buf + pos);
                    v = 0 - 1;
                    if (e == 'n') { v = '\n'; }
                    if (e == 't') { v = '\t'; }
                    if (e == '\\') { v = '\\'; }
                    if (e == '"') { v = '"'; }
                    if (v < 0) { die_char("unknown escape sequence '\\", e); }
                    store8(sbuf + slen, v);
                    slen += 1;
                    pos += 1;
                } else {
                    store8(sbuf + slen, s);
                    slen += 1;
                    pos += 1;
                }
            }
            tok_put(t, 3, 0, sbuf, slen);
            t += 1;
        }

        else if (c == '\'') {
            pos += 1;
            if (pos >= n) { die("empty or unterminated character literal"); }
            v = 0 - 1;
            e = load8(buf + pos);
            if (e == '\\') {
                pos += 1;
                if (pos >= n) { die("unterminated character literal"); }
                q = load8(buf + pos);
                if (q == 'n') { v = '\n'; }
                if (q == 't') { v = '\t'; }
                if (q == '\\') { v = '\\'; }
                if (q == '\'') { v = '\''; }
                if (q == '0') { v = 0; }
                if (v < 0) {
                    if (q != '0') { die_char("unknown escape in character literal '\\", q); }
                }
                pos += 1;
            } else {
                if (e == '\'') { die("empty or unterminated character literal"); }
                v = e;
                pos += 1;
            }
            if (pos >= n) { die("unterminated character literal"); }
            if (load8(buf + pos) != '\'') { die("unterminated character literal"); }
            pos += 1;
            tok_put(t, 1, v, 0, 0);
            t += 1;
        }

        else if (c == '=') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 9, 0, 0, 0); pos += 2; }
            else { tok_put(t, 8, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '!') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 10, 0, 0, 0); pos += 2; t += 1; }
            else { tok_put(t, 45, 0, 0, 0); pos += 1; t += 1; }
        }
        else if (c == '<') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 12, 0, 0, 0); pos += 2; }
            else if (nxt == '<') { tok_put(t, 43, 0, 0, 0); pos += 2; }
            else { tok_put(t, 11, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '>') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 14, 0, 0, 0); pos += 2; }
            else if (nxt == '>') { tok_put(t, 44, 0, 0, 0); pos += 2; }
            else { tok_put(t, 13, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '+') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 46, 0, 0, 0); pos += 2; }
            else { tok_put(t, 4, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '-') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 47, 0, 0, 0); pos += 2; }
            else { tok_put(t, 5, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '*') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 48, 0, 0, 0); pos += 2; }
            else { tok_put(t, 6, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '%') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 50, 0, 0, 0); pos += 2; }
            else { tok_put(t, 38, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '^') { tok_put(t, 41, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '~') { tok_put(t, 42, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '(') { tok_put(t, 15, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ')') { tok_put(t, 16, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '{') { tok_put(t, 17, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '}') { tok_put(t, 18, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ';') { tok_put(t, 19, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ',') { tok_put(t, 20, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '&') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '&') { tok_put(t, 27, 0, 0, 0); pos += 2; }
            else { tok_put(t, 39, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '|') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '|') { tok_put(t, 28, 0, 0, 0); pos += 2; }
            else { tok_put(t, 40, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '[') { tok_put(t, 31, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ']') { tok_put(t, 32, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '.') { tok_put(t, 35, 0, 0, 0); t += 1; pos += 1; }
        else { die_char("unexpected character '", c); }
    }

    loc_at(buf, n);
    tok_put(t, 26, 0, 0, 0);
    return;
}

// Name of the i'th declared parameter (0-indexed), regardless of whether it
// lives in the inline register-param slots (p0..p5, offset 56 onward -- no
// per-index field name exists for a runtime-variable i, so this part stays
// raw pointer arithmetic) or the extra_params list.
int param_name_at(int f, int i) {
    int p = 0;
    int k = 0;
    if (i < 6) { return load64(f + 56 + i * 8); }
    p = f.extra_params;
    for (k = i - 6; k > 0; k -= 1) {
        p = p.next;
    }
    return p.name;
}

// --- parser (builds Node records; registers string literals as it goes) ---

// A node is placed at the last token read when it is made, which is the
// operator, keyword or name it stands for.
int new_node(int kind) {
    int p = alloc(sizeof(Node));
    int i = 0;
    p.kind = kind;
    if (tpos > 0) { i = tpos - 1; }
    p.nfile = (toks + i * sizeof(Token)).tfile;
    p.nline = (toks + i * sizeof(Token)).tline;
    return p;
}

// `what` is coff0's wording for the token, so the messages match.
void want(int k, int what) {
    if (tok_kind(tpos) != k) { at_prev(); die3("expected ", what, ""); }
    return;
}

void expect(int k, int what) {
    want(k, what);
    tpos += 1;
    return;
}

int p_primary() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int head = 0;
    int tail = 0;
    int a = 0;
    k = tok_kind(tpos);
    if (k == 15) {
        tpos += 1;
        nd = p_expr();
        expect(16, "')'");
        return nd;
    }
    if (k == 1) {
        nd = new_node(1);
        nd.ival = tok_ival(tpos);
        tpos += 1;
        return nd;
    }
    if (k == 3) {
        nd = new_node(2);
        nd.sval = tok_name(tpos);
        nd.len = tok_len(tpos);
        if (string_count >= 4096) { at_prev(); die("too many string literals (max 4096)"); }
        store64(string_ptrs + string_count * 8, tok_name(tpos));
        store64(string_lens + string_count * 8, tok_len(tpos));
        nd.extra = string_count;
        string_count += 1;
        tpos += 1;
        return nd;
    }
    if (k == 2) {
        name = tok_name(tpos);
        tpos += 1;
        if (tok_kind(tpos) == 15) {
            tpos += 1;
            nd = new_node(6);
            nd.sval = name;
            head = 0;
            tail = 0;
            if (tok_kind(tpos) != 16) {
                a = p_expr();
                head = a;
                tail = a;
                while (tok_kind(tpos) == 20) {
                    tpos += 1;
                    a = p_expr();
                    tail.sibling = a;
                    tail = a;
                }
            }
            expect(16, "')'");
            nd.child1 = head;
            return nd;
        }
        nd = new_node(3);
        nd.sval = name;
        return nd;
    }
    if (k == 37) {
        tpos += 1;
        expect(15, "'('");
        want(2, "a layout name");
        nd = new_node(32);
        nd.sval = tok_name(tpos);
        tpos += 1;
        expect(16, "')'");
        return nd;
    }
    at_prev();
    die("expected an expression");
    return 0;
}

int p_postfix() {
    int nd = 0;
    int idx = 0;
    int fld = 0;
    int going = 1;
    nd = p_primary();
    while (going == 1) {
        if (tok_kind(tpos) == 31) {
            tpos += 1;
            idx = new_node(27);
            idx.child1 = nd;
            idx.child2 = p_expr();
            expect(32, "']'");
            nd = idx;
        } else if (tok_kind(tpos) == 35) {
            tpos += 1;
            want(2, "a field name");
            fld = new_node(30);
            fld.child1 = nd;
            fld.sval = tok_name(tpos);
            tpos += 1;
            nd = fld;
        } else { going = 0; }
    }
    return nd;
}

int p_unary() {
    int nd = 0;
    int zero = 0;
    if (tok_kind(tpos) == 5) {
        tpos += 1;
        nd = new_node(17);
        nd.child1 = p_unary();
        return nd;
    }
    if (tok_kind(tpos) == 42) {
        tpos += 1;
        nd = new_node(39);
        nd.child1 = p_unary();
        return nd;
    }
    // !E is sugar for (E == 0), so no new node kind or codegen is needed.
    if (tok_kind(tpos) == 45) {
        tpos += 1;
        nd = new_node(11);
        nd.child1 = p_unary();
        zero = new_node(1);
        zero.ival = 0;
        nd.child2 = zero;
        return nd;
    }
    return p_postfix();
}

int p_term() {
    int left = 0;
    int nd = 0;
    int op = 0;
    left = p_unary();
    while (1) {
        op = tok_kind(tpos);
        if (op == 6) {
            tpos += 1;
            nd = new_node(9);
            nd.child1 = left;
            nd.child2 = p_unary();
            left = nd;
        } else if (op == 7) {
            tpos += 1;
            nd = new_node(10);
            nd.child1 = left;
            nd.child2 = p_unary();
            left = nd;
        } else if (op == 38) {
            tpos += 1;
            nd = new_node(33);
            nd.child1 = left;
            nd.child2 = p_unary();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_add() {
    int left = 0;
    int nd = 0;
    int op = 0;
    left = p_term();
    while (1) {
        op = tok_kind(tpos);
        if (op == 4) {
            tpos += 1;
            nd = new_node(7);
            nd.child1 = left;
            nd.child2 = p_term();
            left = nd;
        } else if (op == 5) {
            tpos += 1;
            nd = new_node(8);
            nd.child1 = left;
            nd.child2 = p_term();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_rel() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    left = p_shift();
    while (1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 11) { kind = 13; }
        if (op == 12) { kind = 14; }
        if (op == 13) { kind = 15; }
        if (op == 14) { kind = 16; }
        if (kind > 0) {
            tpos += 1;
            nd = new_node(kind);
            nd.child1 = left;
            nd.child2 = p_shift();
            left = nd;
        } else { break; }
    }
    return left;
}

int p_equality() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    left = p_rel();
    while (1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 9) { kind = 11; }
        if (op == 10) { kind = 12; }
        if (kind > 0) {
            tpos += 1;
            nd = new_node(kind);
            nd.child1 = left;
            nd.child2 = p_rel();
            left = nd;
        } else { break; }
    }
    return left;
}

// The bitwise operators sit at C's precedence levels, including & ^ |
// binding more loosely than == and != (see coff0.c's parse_shift).
int p_shift() {
    int left = 0;
    int nd = 0;
    left = p_add();
    while (tok_kind(tpos) == 43 || tok_kind(tpos) == 44) {
        if (tok_kind(tpos) == 43) { nd = new_node(37); }
        else { nd = new_node(38); }
        tpos += 1;
        nd.child1 = left;
        nd.child2 = p_add();
        left = nd;
    }
    return left;
}

int p_bitand() {
    int left = 0;
    int nd = 0;
    left = p_equality();
    while (tok_kind(tpos) == 39) {
        nd = new_node(34);
        tpos += 1;
        nd.child1 = left;
        nd.child2 = p_equality();
        left = nd;
    }
    return left;
}

int p_bitxor() {
    int left = 0;
    int nd = 0;
    left = p_bitand();
    while (tok_kind(tpos) == 41) {
        nd = new_node(36);
        tpos += 1;
        nd.child1 = left;
        nd.child2 = p_bitand();
        left = nd;
    }
    return left;
}

int p_bitor() {
    int left = 0;
    int nd = 0;
    left = p_bitxor();
    while (tok_kind(tpos) == 40) {
        nd = new_node(35);
        tpos += 1;
        nd.child1 = left;
        nd.child2 = p_bitxor();
        left = nd;
    }
    return left;
}

int p_logic_and() {
    int left = 0;
    int nd = 0;
    left = p_bitor();
    while (tok_kind(tpos) == 27) {
        tpos += 1;
        nd = new_node(23);
        nd.child1 = left;
        nd.child2 = p_bitor();
        left = nd;
    }
    return left;
}

int p_logic_or() {
    int left = 0;
    int nd = 0;
    left = p_logic_and();
    while (tok_kind(tpos) == 28) {
        tpos += 1;
        nd = new_node(24);
        nd.child1 = left;
        nd.child2 = p_logic_and();
        left = nd;
    }
    return left;
}

int p_expr() {
    return p_logic_or();
}

// A global's initializer is folded at compile time, so it may be any
// constant expression, meaning numbers and character literals joined by unary - and
// ~ and the arithmetic and bitwise operators. The operators below compile to
// the same instructions the program's own code would use (idiv, shl, sar),
// so the folded value is what the expression would compute at run time.
// Mirrors coff0.c's const_fold, including its messages.
int const_fold(int nd) {
    int k = nd.kind;
    if (k == 1) { return nd.ival; }
    if (k == 17) { return 0 - const_fold(nd.child1); }
    if (k == 39) { return ~const_fold(nd.child1); }
    if (k == 7 || k == 8 || k == 9 || k == 10 || k == 33
        || k == 34 || k == 35 || k == 36 || k == 37 || k == 38) {
        int a = const_fold(nd.child1);
        int b = const_fold(nd.child2);
        if (k == 7) { return a + b; }
        if (k == 8) { return a - b; }
        if (k == 9) { return a * b; }
        if (k == 10 || k == 33) {
            if (!b) { at_prev(); die("division by zero in a global initializer"); }
            if (b == 0 - 1 && a == 1 << 63) { at_prev(); die("division overflow in a global initializer"); }
            if (k == 10) { return a / b; }
            return a % b;
        }
        if (k == 34) { return a & b; }
        if (k == 35) { return a | b; }
        if (k == 36) { return a ^ b; }
        if (k == 37) { return a << (b & 63); }
        return a >> (b & 63);
    }
    at_prev();
    die("a global initializer must be a constant: numbers, characters and operators");
    return 0;
}


// A layout name used as a type, as in `Point p`. Two identifiers in a row can
// only be that, since no expression starts with two names.
int at_typed_decl() {
    if (tok_kind(tpos) == 2 && tok_kind(tpos + 1) == 2) { return 1; }
    return 0;
}

// A plain assignment (VAR '=' expr), an indexed assignment (buf[i] '=' expr),
// a field assignment (p.f '=' expr), a compound assignment (lhs OP= expr), or
// -- if no assignment follows -- an expression statement. Needs arbitrary
// lookahead (buf[i] can be any length). want_semi is 0 for a for-loop step,
// which has ')' after it instead of ';'.
int p_simple(int want_semi) {
    int e = 0;
    int out = 0;
    int name = 0;
    int ck = 0;
    int bk = 0;
    int bin = 0;
    e = p_expr();
    // q, r = f(...) -- a two-value assignment from a call that returns two.
    if (tok_kind(tpos) == 20) {
        int t2 = 0;
        int call = 0;
        if (e.kind != 3) { at_prev(); die("left of ',' in a two-value assignment must be a variable"); }
        tpos += 1;
        t2 = p_expr();
        if (t2.kind != 3) { at_prev(); die("both targets of a two-value assignment must be variables"); }
        expect(8, "'='");
        call = p_expr();
        if (call.kind != 6) { at_prev(); die("a two-value assignment needs a function call on the right"); }
        out = new_node(41);
        out.child1 = call;
        out.child2 = e;
        out.child3 = t2;
        if (want_semi == 1) { expect(19, "';'"); }
        return out;
    }
    if (tok_kind(tpos) == 8) {
        tpos += 1;
        if (e.kind == 3) {
            name = e.sval;
            out = new_node(4);
            out.sval = name;
            out.child2 = p_expr();
            if (want_semi == 1) { expect(19, "';'"); }
            return out;
        }
        if (e.kind == 27) {
            out = new_node(28);
            out.child1 = e.child1;
            out.child2 = e.child2;
            out.child3 = p_expr();
            if (want_semi == 1) { expect(19, "';'"); }
            return out;
        }
        if (e.kind == 30) {
            out = new_node(31);
            out.sval = e.sval;
            out.child1 = e.child1;
            out.child2 = p_expr();
            if (want_semi == 1) { expect(19, "';'"); }
            return out;
        }
        at_prev();
        die("invalid assignment target");
    }
    // A compound assignment lhs OP= rhs is sugar for lhs = (lhs OP rhs), which
    // builds the same AST a hand-written lhs = lhs OP rhs would.
    if (tok_kind(tpos) >= 46 && tok_kind(tpos) <= 50) {
        ck = tok_kind(tpos);
        bk = 7;
        if (ck == 47) { bk = 8; }
        if (ck == 48) { bk = 9; }
        if (ck == 49) { bk = 10; }
        if (ck == 50) { bk = 33; }
        tpos += 1;
        bin = new_node(bk);
        bin.child1 = e;
        bin.child2 = p_expr();
        if (e.kind == 3) {
            out = new_node(4);
            out.sval = e.sval;
            out.child2 = bin;
        } else if (e.kind == 27) {
            out = new_node(28);
            out.child1 = e.child1;
            out.child2 = e.child2;
            out.child3 = bin;
        } else if (e.kind == 30) {
            out = new_node(31);
            out.sval = e.sval;
            out.child1 = e.child1;
            out.child2 = bin;
        } else {
            at_prev();
            die("invalid assignment target");
        }
        if (want_semi == 1) { expect(19, "';'"); }
        return out;
    }
    out = new_node(21);
    out.child1 = e;
    if (want_semi == 1) { expect(19, "';'"); }
    return out;
}

int p_stmt() {
    int nd = 0;
    int name = 0;
    int k = 0;
    k = tok_kind(tpos);
    if (k == 17) { return p_block(); }
    if (k == 21 || at_typed_decl() == 1) {
        int dtype = 0;
        if (k == 2) { dtype = tok_name(tpos); }
        tpos += 1;
        want(2, "an identifier");
        name = tok_name(tpos);
        tpos += 1;
        nd = new_node(5);
        nd.sval = name;
        nd.extra = dtype;
        if (tok_kind(tpos) == 8) {
            tpos += 1;
            nd.child2 = p_expr();
        }
        expect(19, "';'");
        return nd;
    }
    if (k == 22) {
        tpos += 1;
        expect(15, "'('");
        nd = new_node(18);
        nd.child1 = p_expr();
        expect(16, "')'");
        nd.child2 = p_stmt();
        if (tok_kind(tpos) == 23) {
            tpos += 1;
            nd.child3 = p_stmt();
        }
        return nd;
    }
    if (k == 24) {
        tpos += 1;
        expect(15, "'('");
        nd = new_node(19);
        nd.child1 = p_expr();
        expect(16, "')'");
        nd.child2 = p_stmt();
        return nd;
    }
    if (k == 25) {
        tpos += 1;
        nd = new_node(20);
        if (tok_kind(tpos) != 19) {
            nd.child1 = p_expr();
            // return a, b; -- two-value return (child2 set marks it)
            if (tok_kind(tpos) == 20) { tpos += 1; nd.child2 = p_expr(); }
        }
        expect(19, "';'");
        return nd;
    }
    if (k == 29) {
        tpos += 1;
        expect(19, "';'");
        return new_node(25);
    }
    if (k == 30) {
        tpos += 1;
        expect(19, "';'");
        return new_node(26);
    }
    // for (init; cond; step) body parses to a BLOCK holding the init statement
    // then a FORLOOP node, so init's declarations are scoped to the loop and
    // `continue` runs the step. The step reuses p_simple with no trailing ';'.
    if (k == 51) {
        int finit = 0;
        int fcond = 0;
        int fstep = 0;
        int fbody = 0;
        int floop = 0;
        int fblk = 0;
        tpos += 1;
        expect(15, "'('");
        finit = p_stmt();
        fcond = p_expr();
        expect(19, "';'");
        fstep = p_simple(0);
        expect(16, "')'");
        fbody = p_stmt();
        floop = new_node(40);
        floop.child1 = fcond;
        floop.child2 = fbody;
        floop.child3 = fstep;
        fblk = new_node(22);
        finit.sibling = floop;
        fblk.child1 = finit;
        return fblk;
    }
    if (k == 52) {
        tpos += 1;
        nd = new_node(42);
        nd.child1 = p_stmt();
        return nd;
    }
    return p_simple(1);
}

int p_block() {
    int nd = 0;
    int head = 0;
    int tail = 0;
    int s = 0;
    expect(17, "'{'");
    nd = new_node(22);
    while (tok_kind(tpos) != 18) {
        s = p_stmt();
        if (!head) { head = s; tail = s; }
        else { tail.sibling = s; tail = s; }
    }
    expect(18, "'}'");
    nd.child1 = head;
    return nd;
}

// --- builtins table ---------------------------------------------------------

int builtin_arity(int name) {
    if (streq(name, "print") == 1) { return 1; }
    if (streq(name, "write") == 1) { return 3; }
    if (streq(name, "read") == 1) { return 3; }
    if (streq(name, "open_read") == 1) { return 1; }
    if (streq(name, "open_write") == 1) { return 1; }
    if (streq(name, "close") == 1) { return 1; }
    if (streq(name, "alloc") == 1) { return 1; }
    if (streq(name, "load8") == 1) { return 1; }
    if (streq(name, "store8") == 1) { return 2; }
    if (streq(name, "load32") == 1) { return 1; }
    if (streq(name, "store32") == 1) { return 2; }
    if (streq(name, "load64") == 1) { return 1; }
    if (streq(name, "store64") == 1) { return 2; }
    if (streq(name, "exit") == 1) { return 1; }
    if (streq(name, "win_info") == 1) { return 0; }
    if (streq(name, "win_max") == 1) { return 0; }
    if (streq(name, "fill") == 1) { return 5; }
    if (streq(name, "blit") == 1) { return 5; }
    if (streq(name, "key_poll") == 1) { return 0; }
    if (streq(name, "ticks") == 1) { return 0; }
    if (streq(name, "readfile") == 1) { return 3; }
    if (streq(name, "present") == 1) { return 1; }
    if (streq(name, "mouse_poll") == 1) { return 0; }
    if (streq(name, "glyph") == 1) { return 2; }
    if (streq(name, "dealloc") == 1) { return 1; }
    if (streq(name, "sound") == 1) { return 2; }
    if (streq(name, "writefile") == 1) { return 3; }
    if (streq(name, "syscall") == 1) { return 6; }
    if (streq(name, "argc") == 1) { return 0; }
    if (streq(name, "argv") == 1) { return 1; }
    if (streq(name, "outb") == 1) { return 2; }
    if (streq(name, "inb") == 1) { return 1; }
    if (streq(name, "outw") == 1) { return 2; }
    if (streq(name, "inw") == 1) { return 1; }
    return 0 - 1;
}

// Functions, externs and embeds become assembler symbols under their own
// names, so one named like a register would be read as the register. Same
// list and message as coff0.c's REGISTER_NAMES / check_symbol_name.
int is_register_name(int n) {
    int regs = " rax rbx rcx rdx rsi rdi rbp rsp r8 r9 r10 r11 r12 r13 r14 r15 eax ebx ecx edx esi edi ebp esp r8d r9d r10d r11d r12d r13d r14d r15d ax bx cx dx si di bp sp r8w r9w r10w r11w r12w r13w r14w r15w al bl cl dl ah bh ch dh sil dil bpl spl r8b r9b r10b r11b r12b r13b r14b r15b rip eip cs ds es fs gs ss cr0 cr2 cr3 cr4 cr8 ";
    int nl = strlen_(n);
    int i = 0;
    for (i = 0; load8(regs + i) != 0; i += 1) {
        if (load8(regs + i) == ' ' && load8(regs + i + nl + 1) == ' ') {
            int k = 0;
            while (k < nl && load8(regs + i + 1 + k) == load8(n + k)) { k += 1; }
            if (k == nl) { return 1; }
        }
    }
    return 0;
}

void check_symbol_name(int name, int what) {
    if (is_register_name(name) == 1) {
        eopen();
        eput("'"); eput(name); eput("' is a register name and cannot name "); eput(what);
        efail();
    }
    return;
}

int is_builtin(int name) {
    if (builtin_arity(name) >= 0) { return 1; }
    return 0;
}

int arg_reg(int i) {
    if (!i) { return "rdi"; }
    if (i == 1) { return "rsi"; }
    if (i == 2) { return "rdx"; }
    if (i == 3) { return "rcx"; }
    if (i == 4) { return "r8"; }
    return "r9";
}

// --- resolve assigns stack offsets to locals, marks global VAR/ASSIGN uses -

int func_nparams_of(int name) {
    int f = fhead;
    while (f != 0) {
        if (streq(f.name, name) == 1) { return f.nparams; }
        f = f.fnext;
    }
    die3("call to undeclared function '", name, "'");
    return 0;
}

int func_two_ret_of(int name) {
    int f = fhead;
    while (f != 0) {
        if (streq(f.name, name) == 1) { return f.two_ret; }
        f = f.fnext;
    }
    return 0;
}

int func_exists(int name) {
    int f = fhead;
    while (f != 0) {
        if (streq(f.name, name) == 1) { return 1; }
        f = f.fnext;
    }
    return 0;
}

int glob_exists(int name) {
    int g = ghead;
    while (g != 0) {
        if (streq(g.name, name) == 1) { return 1; }
        g = g.next;
    }
    return 0;
}

int extern_exists(int name) {
    int e = ehead;
    while (e != 0) {
        if (streq(e.name, name) == 1) { return 1; }
        e = e.next;
    }
    return 0;
}

// --- layouts, a single flat field-name -> offset table shared across every
// `layout` declaration, plus a layout-name -> size table for sizeof(...).
// See coff0.c's field_declare_or_check/layout_declare for the full
// rationale (differentially verified against this).
int field_names = 0;   // alloc'd 4096 * 8
int field_offsets = 0; // alloc'd 4096 * 8
int field_ambiguous = 0; // alloc'd 4096 * 8, layouts disagree on its offset
int field_count = 0;

int layout_names = 0;  // alloc'd 256 * 8
int layout_sizes = 0;  // alloc'd 256 * 8
int layout_count = 0;

// The offset of `name` for a base whose layout is not known (an untyped
// variable or an expression). Mirrors coff0.c's field_lookup.
int field_lookup(int name) {
    int i = 0;
    for (i = 0; i < field_count; i += 1) {
        if (streq(load64(field_names + i * 8), name) == 1) {
            if (load64(field_ambiguous + i * 8) == 1) {
                eopen();
                eput("field '"); eput(name);
                eput("' is at different offsets in different layouts; declare the variable with its layout, e.g. 'Point p'");
                efail();
            }
            return load64(field_offsets + i * 8);
        }
    }
    die3("unknown field '", name, "' (not declared in any layout)");
    return 0;
}

void field_declare_or_check(int name, int offset) {
    int i = 0;
    for (i = 0; i < field_count; i += 1) {
        if (streq(load64(field_names + i * 8), name) == 1) {
            if (load64(field_offsets + i * 8) != offset) { store64(field_ambiguous + i * 8, 1); }
            return;
        }
    }
    if (field_count >= 4096) { die("too many distinct field names (max 4096)"); }
    store64(field_names + field_count * 8, name);
    store64(field_offsets + field_count * 8, offset);
    store64(field_ambiguous + field_count * 8, 0);
    field_count += 1;
    return;
}

int layout_exists(int name) {
    int i = 0;
    for (i = 0; i < layout_count; i += 1) {
        if (streq(load64(layout_names + i * 8), name) == 1) { return 1; }
    }
    return 0;
}

// The offset of `field` in layout `lname`, for a base declared with that
// layout. Mirrors coff0.c's layout_field_offset.
int layout_field_offset(int lname, int field) {
    int l = lhead;
    while (l != 0) {
        if (streq(l.name, lname) == 1) {
            int off = 0;
            int f = l.fields;
            while (f != 0) {
                if (streq(f.name, field) == 1) { return off; }
                off += 8;
                f = f.next;
            }
            eopen();
            eput("layout '"); eput(lname); eput("' has no field '"); eput(field); eput("'");
            efail();
        }
        l = l.next;
    }
    die3("unknown layout '", lname, "'");
    return 0;
}

void check_type(int type) {
    if (type != 0 && layout_exists(type) == 0) {
        die3("unknown type '", type, "' (a type is int or a layout name)");
    }
    return;
}

// The layout a variable was declared with, or 0. Locals are searched
// innermost first, then globals.
int var_type(int name) {
    int i = 0;
    for (i = sym_count - 1; i >= 0; i -= 1) {
        if (streq(load64(sym_names + i * 8), name) == 1) { return load64(sym_types + i * 8); }
    }
    int g = ghead;
    while (g != 0) {
        if (streq(g.name, name) == 1) { return g.gtype; }
        g = g.next;
    }
    return 0;
}

int layout_lookup_size(int name) {
    int i = 0;
    for (i = 0; i < layout_count; i += 1) {
        if (streq(load64(layout_names + i * 8), name) == 1) { return load64(layout_sizes + i * 8); }
    }
    die3("unknown layout '", name, "' in sizeof(...)");
    return 0;
}

// Validates one `layout` declaration (a Layout record, see the layout
// blocks near the top of this file). It checks for duplicate field names
// within the layout and for cross-layout offset conflicts via
// field_declare_or_check, and records the layout's own size (nfields * 8)
// for sizeof(...).
void layout_declare(int l) {
    int i = 0;
    int offset = 0;
    int f = 0;
    int g = 0;
    err_file = l.lfile;
    err_line = l.lline;
    while (i < layout_count) {
        if (streq(load64(layout_names + i * 8), l.name) == 1) { die3("redefinition of layout '", l.name, "'"); }
        i += 1;
    }
    if (layout_count >= 256) { die("too many layouts (max 256)"); }
    f = l.fields;
    while (f != 0) {
        err_file = f.lffile;
        err_line = f.lfline;
        g = l.fields;
        while (g != f) {
            if (streq(g.name, f.name) == 1) {
                eopen();
                eput("duplicate field '"); eput(f.name);
                eput("' in layout '"); eput(l.name); eput("'");
                efail();
            }
            g = g.next;
        }
        field_declare_or_check(f.name, offset);
        offset += 8;
        f = f.next;
    }
    store64(layout_names + layout_count * 8, l.name);
    store64(layout_sizes + layout_count * 8, offset);
    layout_count += 1;
    return;
}

// Scans innermost-declared-first (highest index first) so an inner scope's
// variable correctly shadows an outer one of the same name.
int sym_try_lookup(int name) {
    int i = 0;
    for (i = sym_count - 1; i >= 0; i -= 1) {
        if (streq(load64(sym_names + i * 8), name) == 1) { return load64(sym_offsets + i * 8); }
    }
    return 0 - 1;
}

int sym_declared_in_scope(int name) {
    int scope_start = 0;
    int i = 0;
    if (scope_depth > 0) { scope_start = load64(scope_marks + (scope_depth - 1) * 8); }
    for (i = scope_start; i < sym_count; i += 1) {
        if (streq(load64(sym_names + i * 8), name) == 1) { return 1; }
    }
    return 0;
}

int sym_declare(int name) {
    int off = 0;
    if (sym_declared_in_scope(name) == 1) { die3("redeclaration of '", name, "'"); }
    if (sym_count >= 4096) { die("too many variables (max 4096)"); }
    off = (sym_count + 1) * 8;
    store64(sym_names + sym_count * 8, name);
    store64(sym_offsets + sym_count * 8, off);
    store64(sym_types + sym_count * 8, 0);
    sym_count += 1;
    if (off > stack_size) { stack_size = off; }
    return off;
}

// Points errors at nd while it is resolved and back at its parent after,
// so a check the parent makes after resolving a child reports the parent.
void resolve(int nd) {
    int saved_file = err_file;
    int saved_line = err_line;
    if (!nd) { return; }
    err_file = nd.nfile;
    err_line = nd.nline;
    resolve_node(nd);
    err_file = saved_file;
    err_line = saved_line;
    return;
}

void resolve_node(int nd) {
    int k = 0;
    int name = 0;
    int off = 0;
    int args = 0;
    int a = 0;
    int nargs = 0;
    int bar = 0;
    int saved = 0;
    if (!nd) { return; }
    k = nd.kind;
    if (k == 1) { return; }
    if (k == 2) { return; }
    if (k == 3) {
        name = nd.sval;
        off = sym_try_lookup(name);
        if (off >= 0) { nd.ival = off; return; }
        if (glob_exists(name) == 1) { nd.extra = 1; return; }
        if (extern_exists(name) == 1) { nd.kind = 29; return; }
        if (func_exists(name) == 1) { nd.kind = 29; return; }
        die3("undeclared variable '", name, "'");
        return;
    }
    if (k == 29) { return; } // only ever reached already-resolved, via k==3 above
    if (k == 4) {
        resolve(nd.child2);
        name = nd.sval;
        off = sym_try_lookup(name);
        if (off >= 0) { nd.ival = off; return; }
        if (glob_exists(name) == 1) { nd.extra = 1; return; }
        die3("undeclared variable '", name, "'");
        return;
    }
    if (k == 5) {
        if (nd.child2 != 0) { resolve(nd.child2); }
        check_type(nd.extra);
        nd.ival = sym_declare(nd.sval);
        store64(sym_types + (sym_count - 1) * 8, nd.extra);
        return;
    }
    if (k == 6) {
        name = nd.sval;
        args = nd.child1;
        nargs = 0;
        a = args;
        while (a != 0) { nargs += 1; a = a.sibling; }
        bar = builtin_arity(name);
        if (bar >= 0) {
            if (nargs != bar) {
                eopen();
                eput("builtin '"); eput(name);
                eput("' takes exactly "); eput_int(bar);
                eput(" argument(s), got "); eput_int(nargs);
                efail();
            }
        } else if (func_exists(name) == 1) {
            if (func_nparams_of(name) != nargs) {
                eopen();
                eput("'"); eput(name);
                eput("' takes "); eput_int(func_nparams_of(name));
                eput(" argument(s), got "); eput_int(nargs);
                efail();
            }
            if (func_two_ret_of(name) == 1 && resolving_multi_call == 0) {
                eopen();
                eput("'"); eput(name);
                eput("' returns two values; call it as 'a, b = "); eput(name); eput("(...)'");
                efail();
            }
        } else {
            // Not a builtin, not a declared function -- an indirect call
            // through a function-pointer-valued variable, if `name` names
            // one. No arity check possible (see coff0.c for why). `extra`
            // (unused by CALL otherwise) encodes 0 = direct call (default),
            // 1 = indirect via a global, 2 = indirect via a local/param
            // (whose stack offset then lives in `ival`, same slot VAR
            // uses for the same purpose).
            off = sym_try_lookup(name);
            if (off >= 0) { nd.ival = off; nd.extra = 2; }
            else if (glob_exists(name) == 1) { nd.extra = 1; }
            else { die3("call to undeclared function '", name, "'"); }
        }
        a = args;
        while (a != 0) { resolve(a); a = a.sibling; }
        return;
    }
    if ((k >= 7 && k <= 16) || (k >= 33 && k <= 38)) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 23) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 24) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 17 || k == 39) { resolve(nd.child1); return; }
    if (k == 18) {
        resolve(nd.child1);
        resolve(nd.child2);
        if (nd.child3 != 0) { resolve(nd.child3); }
        return;
    }
    if (k == 19) {
        resolve(nd.child1);
        loop_depth += 1;
        resolve(nd.child2);
        loop_depth -= 1;
        return;
    }
    if (k == 40) {
        resolve(nd.child1);
        loop_depth += 1;
        resolve(nd.child2);
        loop_depth -= 1;
        resolve(nd.child3);
        return;
    }
    if (k == 20) {
        if (in_defer == 1) { die("'return' inside a defer"); }
        if (current_fn_is_void == 1) { if (nd.child1 != 0) { die("'void' function cannot return a value"); } }
        if (current_fn_two_ret == 1 && nd.child2 == 0) { die("a two-value function must 'return a, b'"); }
        if (current_fn_two_ret == 0 && nd.child2 != 0) { die("only a '(int, int)' function may return two values"); }
        resolve(nd.child1);
        resolve(nd.child2);
        return;
    }
    // The deferred statement runs at .Lret, outside every loop, so it is
    // resolved with loop_depth 0 and may not jump out of the epilogue.
    if (k == 42) {
        if (in_defer == 1) { die("'defer' inside a defer"); }
        saved = loop_depth;
        loop_depth = 0;
        in_defer = 1;
        resolve(nd.child1);
        in_defer = 0;
        loop_depth = saved;
        return;
    }
    if (k == 41) {
        resolving_multi_call = 1;
        resolve(nd.child1);
        resolving_multi_call = 0;
        if (nd.child1.kind != 6 || func_two_ret_of(nd.child1.sval) == 0) {
            die("the right of a two-value assignment must call an '(int, int)' function");
        }
        resolve(nd.child2);
        resolve(nd.child3);
        if (nd.child2.kind != 3 || nd.child3.kind != 3) {
            die("two-value assignment targets must be variables");
        }
        return;
    }
    if (k == 21) { resolve(nd.child1); return; }
    if (k == 22) {
        if (scope_depth >= 64) { die("blocks nested too deeply (max 64)"); }
        store64(scope_marks + scope_depth * 8, sym_count);
        scope_depth += 1;
        a = nd.child1;
        while (a != 0) { resolve(a); a = a.sibling; }
        scope_depth -= 1;
        sym_count = load64(scope_marks + scope_depth * 8);
        return;
    }
    if (k == 25) {
        if (loop_depth <= 0 && in_defer == 1) { die("'break' inside a defer"); }
        if (loop_depth <= 0) { die("'break' outside of a loop"); }
        return;
    }
    if (k == 26) {
        if (loop_depth <= 0 && in_defer == 1) { die("'continue' inside a defer"); }
        if (loop_depth <= 0) { die("'continue' outside of a loop"); }
        return;
    }
    if (k == 27) { resolve(nd.child1); resolve(nd.child2); return; }
    if (k == 28) {
        resolve(nd.child1);
        resolve(nd.child2);
        resolve(nd.child3);
        return;
    }
    if (k == 30 || k == 31) {
        // A base that is a variable declared with a layout looks the field
        // up in that layout; anything else uses the shared table.
        int ftype = 0;
        int base = nd.child1;
        if (base.kind == 3) { ftype = var_type(base.sval); }
        resolve(nd.child1);
        if (k == 31) { resolve(nd.child2); }
        if (ftype != 0) { nd.ival = layout_field_offset(ftype, nd.sval); }
        else { nd.ival = field_lookup(nd.sval); }
        return;
    }
    if (k == 32) {
        nd.ival = layout_lookup_size(nd.sval);
        nd.kind = 1; // rewrite to NUM, same in-place trick as FUNCREF
        return;
    }
    return;
}

// --- codegen emits assembly byte-identical to coff0's own gen_expr/gen_stmt

void gen_block(int nd) {
    int s = nd.child1;
    while (s != 0) {
        gen_stmt(s);
        s = s.sibling;
    }
    return;
}

// A leaf operand is a number or a variable. Loading one has no side effect
// and touches no other register, so a binary operator can load it straight
// into rcx instead of saving rax on the stack around it.
int is_leaf(int nd) {
    return nd.kind == 1 || nd.kind == 3;
}

// Leaves lhs in rax and rhs in rcx, the operand layout of every binary
// operator.
void gen_operands(int lhs, int rhs) {
    gen_expr(lhs);
    if (is_leaf(rhs) == 1) {
        if (rhs.kind == 1) { emit("    mov rcx, "); print_int(rhs.ival); emit("\n"); }
        else if (rhs.extra == 1) { emit("    mov rcx, [.G"); emit(rhs.sval); emit("]\n"); }
        else { emit("    mov rcx, [rbp - "); print_int(rhs.ival); emit("]\n"); }
        return;
    }
    emit("    push rax\n");
    gen_expr(rhs);
    emit("    mov rcx, rax\n");
    emit("    pop rax\n");
    return;
}

// add, sub, imul, and, or, xor and cmp take a sign-extended 32-bit
// immediate, so a number in that range on their right needs no register at
// all.
int is_imm32(int nd) {
    return nd.kind == 1 && nd.ival >= 0 - 2147483647 - 1 && nd.ival <= 2147483647;
}

// Leaves lhs in rax and returns 1 when rhs can be an immediate, otherwise
// loads both operands as gen_operands does and returns 0.
int gen_operands_imm(int lhs, int rhs) {
    if (is_imm32(rhs) == 1) {
        gen_expr(lhs);
        return 1;
    }
    gen_operands(lhs, rhs);
    return 0;
}

// The right operand of an instruction, after gen_operands_imm.
void emit_rhs(int imm, int rhs) {
    if (imm == 1) { print_int(rhs.ival); emit("\n"); }
    else { emit("rcx\n"); }
    return;
}

// A number or a local can trade places with the other operand of a
// commutative operator. A global cannot, since a call on the other side may
// write it, and c0 has no way to take a local's address.
int is_stable_leaf(int nd) {
    return nd.kind == 1 || (nd.kind == 3 && nd.extra != 1);
}

// The jump taken when a comparison of rax against the right operand holds
// (sense 1) or fails (sense 0), or 0 for a node that is not a comparison.
int cmp_jump(int k, int sense) {
    if (k == 11) { if (sense == 1) { return "je"; } return "jne"; }
    if (k == 12) { if (sense == 1) { return "jne"; } return "je"; }
    if (k == 13) { if (sense == 1) { return "jl"; } return "jge"; }
    if (k == 14) { if (sense == 1) { return "jle"; } return "jg"; }
    if (k == 15) { if (sense == 1) { return "jg"; } return "jle"; }
    if (k == 16) { if (sense == 1) { return "jge"; } return "jl"; }
    return 0;
}

// Jumps to .<label><l> when cond is (sense 1) or is not (sense 0) true. A
// comparison branches on the flags directly instead of turning them into 0
// or 1 and comparing that against 0, and && and || become chains of such
// branches.
void gen_jump(int cond, int sense, int label, int l) {
    int k = cond.kind;
    int jcc = cmp_jump(k, sense);
    int imm = 0;
    int skip = 0;
    if (jcc != 0) {
        imm = gen_operands_imm(cond.child1, cond.child2);
        emit("    cmp rax, ");
        emit_rhs(imm, cond.child2);
        emit("    "); emit(jcc); emit(" ."); emit(label); print_int(l); emit("\n");
        return;
    }
    // (a && b) is false when either is false, (a || b) is true when either is
    // true. The other two cases skip to .Lskip when the left side decides.
    if ((k == 23 && sense == 0) || (k == 24 && sense == 1)) {
        gen_jump(cond.child1, sense, label, l);
        gen_jump(cond.child2, sense, label, l);
        return;
    }
    if (k == 23 || k == 24) {
        skip = label_count;
        label_count += 1;
        gen_jump(cond.child1, k == 24, "Lskip", skip);
        gen_jump(cond.child2, sense, label, l);
        emit(".Lskip"); print_int(skip); emit(":\n");
        return;
    }
    gen_expr(cond);
    emit("    cmp rax, 0\n");
    if (sense == 1) { emit("    jne ."); } else { emit("    je ."); }
    emit(label); print_int(l); emit("\n");
    return;
}

void gen_jump_if_false(int cond, int label, int l) {
    gen_jump(cond, 0, label, l);
    return;
}

// Leaves an address in rdi and a value in rax, evaluated in that order. A
// leaf value loads into rax without disturbing rdi, so the address need not
// wait on the stack.
void gen_addr_value(int addr, int value) {
    gen_expr(addr);
    if (is_leaf(value) == 1) {
        emit("    mov rdi, rax\n");
        gen_expr(value);
        return;
    }
    emit("    push rax\n");
    gen_expr(value);
    emit("    pop rdi\n");
    return;
}

// A number, a local or a string literal, loaded straight into an argument
// register. Nothing an argument expression does can change one, so it may
// be loaded after the others.
int is_stable_arg(int nd) {
    return is_stable_leaf(nd) == 1 || nd.kind == 2;
}

int nth_arg(int args, int i) {
    while (i > 0) {
        args = args.sibling;
        i -= 1;
    }
    return args;
}

void gen_stable_arg(int nd, int reg) {
    if (nd.kind == 1) { emit("    mov "); emit(reg); emit(", "); print_int(nd.ival); emit("\n"); return; }
    if (nd.kind == 2) { emit("    lea "); emit(reg); emit(", [.Lstr"); print_int(nd.extra); emit("]\n"); return; }
    emit("    mov "); emit(reg); emit(", [rbp - "); print_int(nd.ival); emit("]\n");
    return;
}

void gen_binop(int nd, int k) {
    int imm = 0;
    int lhs = nd.child1;
    int rhs = nd.child2;
    int commutes = k == 7 || k == 9 || k == 34 || k == 35 || k == 36;
    // With the leaf on the right, it loads straight into place instead of
    // rax being saved around the other operand.
    if (commutes && is_stable_leaf(lhs) == 1 && is_leaf(rhs) == 0) { lhs = nd.child2; rhs = nd.child1; }
    if (commutes || k == 8 || (k >= 11 && k <= 16)) { imm = gen_operands_imm(lhs, rhs); }
    else { gen_operands(lhs, rhs); }
    if (k >= 11 && k <= 16) {
        emit("    cmp rax, ");
        emit_rhs(imm, rhs);
    }
    if (k == 7) { emit("    add rax, "); emit_rhs(imm, rhs); return; }
    if (k == 8) { emit("    sub rax, "); emit_rhs(imm, rhs); return; }
    if (k == 9) {
        if (imm == 1) { emit("    imul rax, rax, "); print_int(rhs.ival); emit("\n"); }
        else { emit("    imul rax, rcx\n"); }
        return;
    }
    if (k == 10) { emit("    cqo\n    idiv rcx\n"); return; }
    // idiv leaves the remainder in rdx, with the sign of the dividend.
    if (k == 33) { emit("    cqo\n    idiv rcx\n    mov rax, rdx\n"); return; }
    if (k == 34) { emit("    and rax, "); emit_rhs(imm, rhs); return; }
    if (k == 35) { emit("    or rax, "); emit_rhs(imm, rhs); return; }
    if (k == 36) { emit("    xor rax, "); emit_rhs(imm, rhs); return; }
    // The count is in cl, x86 masks it to its low six bits. >> is arithmetic.
    if (k == 37) { emit("    shl rax, cl\n"); return; }
    if (k == 38) { emit("    sar rax, cl\n"); return; }
    if (k == 11) { emit("    sete al\n    movzx rax, al\n"); return; }
    if (k == 12) { emit("    setne al\n    movzx rax, al\n"); return; }
    if (k == 13) { emit("    setl al\n    movzx rax, al\n"); return; }
    if (k == 14) { emit("    setle al\n    movzx rax, al\n"); return; }
    if (k == 15) { emit("    setg al\n    movzx rax, al\n"); return; }
    if (k == 16) { emit("    setge al\n    movzx rax, al\n"); return; }
    return;
}

void gen_call(int nd) {
    int name = nd.sval;
    int args = nd.child1;
    int l = 0;
    int i = 0;
    int nargs = 0;
    int a = 0;
    int last = 0 - 1;

    if (streq(name, "print") == 1) {
        l = label_count;
        // One label id serves both .Lstrlen and .Lstrlend, which differ by
        // name.
        label_count += 1;
        // rsi and rcx, not rbx, because the ABI has a function preserve
        // rbx.
        gen_expr(args);
        emit("    mov rsi, rax\n");
        emit("    xor rcx, rcx\n");
        emit(".Lstrlen"); print_int(l); emit(":\n");
        emit("    cmp byte ptr [rsi + rcx], 0\n");
        emit("    je .Lstrlend"); print_int(l); emit("\n");
        emit("    inc rcx\n");
        emit("    jmp .Lstrlen"); print_int(l); emit("\n");
        emit(".Lstrlend"); print_int(l); emit(":\n");
        if (elf_mode == 1) {
            // Moonshot SYS_DEBUG_PRINT(str, len) is 1.
            emit("    mov rdi, rsi\n");
            emit("    mov rsi, rcx\n");
            emit("    mov rax, 1\n");
            emit("    syscall\n");
        } else {
            // Linux write(1, str, len).
            emit("    mov rdx, rcx\n");
            emit("    mov rdi, 1\n");
            emit("    mov rax, 1\n");
            emit("    syscall\n");
        }
        return;
    }
    if (streq(name, "alloc") == 1) {
        if (elf_mode == 1) {
            // SYS_ALLOC(n) (6) returns n zeroed bytes from this ring-3 process's
            // own heap (Moonshot's lager.c0), which dealloc() can give
            // back. Returns 0 on failure.
            gen_expr(args);
            emit("    mov rdi, rax\n");
            emit("    mov rax, 6\n");
            emit("    syscall\n");
            return;
        }
        l = label_count; label_count += 1;
        gen_expr(args);
        emit("    push rax\n");
        emit("    mov rax, [.Lcurbrk]\n");
        emit("    test rax, rax\n");
        emit("    jnz .Lbrkok"); print_int(l); emit("\n");
        emit("    mov rdi, 0\n");
        emit("    mov rax, 12\n");
        emit("    syscall\n");
        emit(".Lbrkok"); print_int(l); emit(":\n");
        emit("    pop rdi\n");
        emit("    push rax\n");
        emit("    add rdi, rax\n");
        emit("    mov rax, 12\n");
        emit("    syscall\n");
        emit("    mov [.Lcurbrk], rax\n");
        emit("    pop rax\n");
        return;
    }
    if (streq(name, "load8") == 1) {
        gen_expr(args);
 emit("    movzx rax, byte ptr [rax]\n"); 
        return;
    }
    if (streq(name, "store8") == 1) {
        gen_addr_value(args, args.sibling);
        emit("    mov byte ptr [rdi], al\n");
    
        return;
    }
    if (streq(name, "exit") == 1) {
        gen_expr(args);
        emit("    mov rdi, rax\n");
        if (elf_mode == 1) {
            // Moonshot's SYS_EXIT is 0. The Linux number, 60, is not a
            // Moonshot syscall, so it would return -1 and the program would
            // carry on after exit().
            emit("    mov rax, 0\n");
        } else {
            emit("    mov rax, 60\n");
        }
        emit("    syscall\n");
        return;
    }
    // --- Moonshot ring-3 builtins (--elf only) ------------------------
    // Each is one Moonshot syscall. Arguments follow the SYSCALL ABI, in rdi,
    // rsi, rdx, r10, r8 -- r10 for the fourth, not rcx, because the
    // SYSCALL instruction clobbers rcx with the return RIP. Every argument
    // is evaluated left to right onto the stack first, then popped into its
    // register in reverse, so an argument expression may itself call.
    if (!elf_mode) {
        if (streq(name, "win_info") == 1 || streq(name, "win_max") == 1
            || streq(name, "key_poll") == 1 || streq(name, "ticks") == 1
            || streq(name, "present") == 1 || streq(name, "readfile") == 1
            || streq(name, "blit") == 1 || streq(name, "fill") == 1
            || streq(name, "mouse_poll") == 1
            || streq(name, "glyph") == 1 || streq(name, "dealloc") == 1
            || streq(name, "sound") == 1 || streq(name, "writefile") == 1
            || streq(name, "syscall") == 1) {
            die3("'", name, "' exists only for the Moonshot target (--elf)");
        }
    } else {
        // The Linux-only builtins have no meaning in ring 3 on Moonshot,
        // where there are no file descriptors and no port I/O. argc and argv do
        // exist there, as syscalls (see below).
        if (streq(name, "write") == 1 || streq(name, "read") == 1
            || streq(name, "open_read") == 1 || streq(name, "open_write") == 1
            || streq(name, "close") == 1 || streq(name, "outb") == 1
            || streq(name, "inb") == 1 || streq(name, "outw") == 1
            || streq(name, "inw") == 1) {
            die3("'", name, "' has no meaning in ring 3 on Moonshot");
        }
    }
    if (streq(name, "win_info") == 1) {
        // SYS_WIN_INFO (2) returns packed (width<<16)|height in rax.
        emit("    mov rax, 2\n    syscall\n");
        return;
    }
    if (streq(name, "win_max") == 1) {
        // SYS_WIN_MAX (10) returns packed (width<<16)|height for the LARGEST
        // window this machine can ever hand out -- a fixed ceiling, not the
        // current size. A ring-3 program sizes its frame buffer from this once
        // and never resizes it, so a window growing from half the screen to
        // all of it never needs a second buffer. win_info() is what changes;
        // this is what you budget for.
        emit("    mov rax, 10\n    syscall\n");
        return;
    }
    if (streq(name, "key_poll") == 1) {
        // SYS_KEY_POLL (4) returns a packed key event or -1 in rax.
        emit("    mov rax, 4\n    syscall\n");
        return;
    }
    if (streq(name, "ticks") == 1) {
        // SYS_TICKS (7) returns the kernel's monotonic ~100Hz tick count.
        emit("    mov rax, 7\n    syscall\n");
        return;
    }
    if (streq(name, "mouse_poll") == 1) {
        // SYS_MOUSE_POLL (11) returns the pointer relative to this task's
        // window as (x * 1024 + y) * 8 + buttons, or -1 when it is not over the window.
        emit("    mov rax, 11\n    syscall\n");
        return;
    }
    if (streq(name, "dealloc") == 1) {
        // SYS_DEALLOC(ptr) (13) gives back a block alloc() returned. Returns
        // 0, or -1 if ptr is not the start of a live block (see lager.c0).
        gen_expr(args);
        emit("    mov rdi, rax\n");
        emit("    mov rax, 13\n");
        emit("    syscall\n");
        return;
    }
    if (streq(name, "sound") == 1) {
        // SYS_SOUND(buf, len) (14) queues len bytes of 8-bit mono PCM for
        // oljud, Moonshot's Sound Blaster 16 driver, and returns how many
        // fit. buf == 0 returns how many bytes are still waiting to be played.
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop rsi\n    pop rdi\n");
        emit("    mov rax, 14\n    syscall\n");
        return;
    }
    if (streq(name, "glyph") == 1) {
        // SYS_GLYPH(ch, buf) (12) copies one character's font bitmap -- the
        // kernel's own font, the one kakel draws with -- into the caller's
        // memory, FONT_H bytes, row 0 first, each byte's bit 7 the leftmost
        // pixel. Returns the cell size packed width * 65536 + height, so a
        // program never hardcodes 8x8; with buf == 0 it returns that size and
        // copies nothing, the way readfile()'s buf == 0 returns a file size.
        //
        // A bitmap rather than a draw call on purpose. Ring-3 programs
        // composite a whole frame and present() it in one syscall, because a
        // multi-syscall draw sequence gets torn by the scheduler. Text has to
        // go through the same compositing as everything else, so the kernel
        // hands over the glyph and draws nothing.
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop rsi\n    pop rdi\n");
        emit("    mov rax, 12\n    syscall\n");
        return;
    }
    if (streq(name, "present") == 1) {
        // SYS_PRESENT(buf) (9) copies a whole window of pixels at once.
        gen_expr(args);
        emit("    mov rdi, rax\n");
        emit("    mov rax, 9\n    syscall\n");
        return;
    }
    if (streq(name, "writefile") == 1) {
        // SYS_WRITEFILE(name, buf, len) (15) makes the jakel file hold
        // exactly those len bytes, creating it (in an existing directory) if
        // it is not there. Returns len, or -1. readfile()'s counterpart, so
        // a ring-3 program can save.
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop rdx\n    pop rsi\n    pop rdi\n");
        emit("    mov rax, 15\n    syscall\n");
        return;
    }
    if (streq(name, "readfile") == 1) {
        // SYS_READFILE(name, buf, max) (8) reads a file from jakel into the
        // process's own memory. With buf == 0 it returns the file's size
        // without copying anything, which is how a program sizes an alloc()
        // before the real read -- there is no separate stat syscall.
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop rdx\n    pop rsi\n    pop rdi\n");
        emit("    mov rax, 8\n    syscall\n");
        return;
    }
    if (streq(name, "blit") == 1) {
        // SYS_BLIT(buf, x, y, w, h) (5).
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop r8\n    pop r10\n    pop rdx\n    pop rsi\n    pop rdi\n");
        emit("    mov rax, 5\n    syscall\n");
        return;
    }
    if (streq(name, "fill") == 1) {
        // SYS_FILL(x, y, w, h, color) (3).
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop r8\n    pop r10\n    pop rdx\n    pop rsi\n    pop rdi\n");
        emit("    mov rax, 3\n    syscall\n");
        return;
    }
    if (streq(name, "load32") == 1) {
        // A 32-bit load clears the upper half of rax by itself.
        gen_expr(args);
        emit("    mov eax, dword ptr [rax]\n");
        return;
    }
    if (streq(name, "store32") == 1) {
        gen_addr_value(args, args.sibling);
        emit("    mov dword ptr [rdi], eax\n");
        return;
    }
    if (streq(name, "load64") == 1) {
        gen_expr(args);
 emit("    mov rax, [rax]\n"); 
        return;
    }
    if (streq(name, "store64") == 1) {
        gen_addr_value(args, args.sibling);
        emit("    mov [rdi], rax\n");
    
        return;
    }
    if (streq(name, "syscall") == 1) {
        // syscall(n, a, b, c, d, e) (--elf) makes any Moonshot syscall by number,
        // so a new one needs a kernel change and a library wrapper, not a
        // compiler change. Arguments in rdi, rsi, rdx, r10, r8; the number
        // in rax. Unused arguments are passed as 0.
        a = args;
        while (a != 0) { gen_expr(a); emit("    push rax\n"); a = a.sibling; }
        emit("    pop r8\n    pop r10\n    pop rdx\n    pop rsi\n    pop rdi\n    pop rax\n");
        emit("    syscall\n");
        return;
    }
    if (elf_mode == 1 && streq(name, "argc") == 1) {
        // SYS_ARGC (17) returns how many arguments the program was started with,
        // its own name included, as on Linux.
        emit("    mov rax, 17\n    syscall\n");
        return;
    }
    if (elf_mode == 1 && streq(name, "argv") == 1) {
        // SYS_ARGV(i) (18) returns argument i, a NUL-terminated string in the
        // program's own memory, or 0 past the end.
        gen_expr(args);
        emit("    mov rdi, rax\n    mov rax, 18\n    syscall\n");
        return;
    }
    if (streq(name, "argc") == 1) {
        emit("    mov rax, [.Largv0]\n");
        emit("    mov rax, [rax]\n");
        return;
    }
    if (streq(name, "argv") == 1) {
        gen_expr(args);
        emit("    mov rcx, rax\n");
        emit("    mov rax, [.Largv0]\n");
        emit("    mov rax, [rax + rcx*8 + 8]\n");
        return;
    }
    if (streq(name, "outb") == 1) {
        gen_expr(args);
        emit("    push rax\n");
        gen_expr(args.sibling);
        emit("    pop rdx\n");
        emit("    out dx, al\n");
        return;
    }
    if (streq(name, "inb") == 1) {
        gen_expr(args);
        emit("    mov rdx, rax\n");
        emit("    in al, dx\n");
        emit("    movzx rax, al\n");
        return;
    }
    if (streq(name, "outw") == 1) {
        gen_expr(args);
        emit("    push rax\n");
        gen_expr(args.sibling);
        emit("    pop rdx\n");
        emit("    out dx, ax\n");
        return;
    }
    if (streq(name, "inw") == 1) {
        gen_expr(args);
        emit("    mov rdx, rax\n");
        emit("    in ax, dx\n");
        emit("    movzx rax, ax\n");
        return;
    }

    a = args;
    while (a != 0) {
        if (is_stable_arg(a) == 0) { last = nargs; }
        a = a.sibling;
        nargs += 1;
    }
    if (nargs <= 6) {
        // The other arguments are evaluated left to right as usual. The last
        // of them goes straight to its register, the rest wait on the stack,
        // and the stable ones are loaded last, directly into place.
        a = args;
        i = 0;
        while (a != 0) {
            if (is_stable_arg(a) == 0) {
                gen_expr(a);
                if (i == last) { emit("    mov "); emit(arg_reg(i)); emit(", rax\n"); }
                else { emit("    push rax\n"); }
            }
            a = a.sibling;
            i += 1;
        }
        for (i = nargs - 1; i >= 0; i -= 1) {
            if (is_stable_arg(nth_arg(args, i)) == 0 && i != last) {
                emit("    pop "); emit(arg_reg(i)); emit("\n");
            }
        }
        for (i = 0; i < nargs; i += 1) {
            a = nth_arg(args, i);
            if (is_stable_arg(a) == 1) { gen_stable_arg(a, arg_reg(i)); }
        }
    } else {
        a = args;
        while (a != 0) {
            gen_expr(a);
            emit("    push rax\n");
            a = a.sibling;
        }
        i = 0;
        for (i = 0; i < 6; i += 1) {
            emit("    mov "); emit(arg_reg(i)); emit(", [rsp + ");
            print_int((nargs - 1 - i) * 8); emit("]\n");
        }
    }

    if (streq(name, "write") == 1) { emit("    mov rax, 1\n    syscall\n"); return; }
    if (streq(name, "read") == 1) { emit("    mov rax, 0\n    syscall\n"); return; }
    if (streq(name, "close") == 1) { emit("    mov rax, 3\n    syscall\n"); return; }
    if (streq(name, "open_read") == 1) {
        emit("    mov rsi, 0\n");
        emit("    mov rax, 2\n    syscall\n");
        return;
    }
    if (streq(name, "open_write") == 1) {
        emit("    mov rsi, 577\n");
        emit("    mov rdx, 420\n");
        emit("    mov rax, 2\n    syscall\n");
        return;
    }
    if (nd.extra == 1) {
        emit("    mov r10, [.G"); emit(name); emit("]\n");
        emit("    call r10\n");
    } else if (nd.extra == 2) {
        emit("    mov r10, [rbp - "); print_int(nd.ival); emit("]\n");
        emit("    call r10\n");
    } else {
        emit("    call "); emit(name); emit("\n");
    }
    if (nargs > 6) { emit("    add rsp, "); print_int(nargs * 8); emit("\n"); }

    return;
}

// Codegen errors point at the node, same as resolve().
void gen_expr(int nd) {
    int saved_file = err_file;
    int saved_line = err_line;
    if (nd != 0) { err_file = nd.nfile; err_line = nd.nline; }
    gen_expr_node(nd);
    err_file = saved_file;
    err_line = saved_line;
    return;
}

void gen_expr_node(int nd) {
    int k = nd.kind;
    int l = 0;
    // --- literal ---
    if (k == 1) {
        emit("    mov rax, "); print_int(nd.ival); emit("\n");
    
        return;
    }
    // --- string literal ---
    if (k == 2) {
        emit("    lea rax, [.Lstr"); print_int(nd.extra); emit("]\n");
        return;
    }
    // --- variable read ---
    if (k == 3) {
        if (nd.extra == 1) {
            emit("    mov rax, [.G"); emit(nd.sval); emit("]\n");
        } else {
            emit("    mov rax, [rbp - "); print_int(nd.ival); emit("]\n");
        }
    
        return;
    }
    // --- function reference ---
    if (k == 29) {
        emit("    lea rax, ["); emit(nd.sval); emit("]\n");
        return;
    }
    // --- unary ~ ---
    if (k == 39) {
        gen_expr(nd.child1);
        emit("    not rax\n");
        return;
    }
    // --- unary neg ---
    if (k == 17) {
        gen_expr(nd.child1);
        emit("    neg rax\n");
        return;
    }
    // --- array index (load8 offset) ---
    if (k == 27) {
        // base + index, so the operands may trade places like ADD's.
        if (is_stable_leaf(nd.child1) == 1 && is_leaf(nd.child2) == 0) { gen_operands(nd.child2, nd.child1); }
        else { gen_operands(nd.child1, nd.child2); }
        emit("    add rax, rcx\n");
        emit("    movzx rax, byte ptr [rax]\n");
    
        return;
    }
    // --- field read (e.field, sugar over load64(base + offset)) ---
    if (k == 30) {
        gen_expr(nd.child1);
        emit("    mov rax, [rax + "); print_int(nd.ival); emit("]\n");
    
        return;
    }
    // --- function call ---
    if (k == 6) { gen_call(nd); return; }
    // --- binary ops ---
    if ((k >= 7 && k <= 16) || (k >= 33 && k <= 38)) { gen_binop(nd, k); return; }
    // --- AND short-circuit ---
    if (k == 23) {
        // One label id serves both .Lfalse and .Landend, since the labels
        // are distinct names (.Lfalse7 / .Landend7 cannot collide).
        l = label_count;
        label_count += 1;
        gen_jump(nd, 0, "Lfalse", l);
        emit("    mov rax, 1\n");
        emit("    jmp .Landend"); print_int(l); emit("\n");
        emit(".Lfalse"); print_int(l); emit(":\n");
        emit("    mov rax, 0\n");
        emit(".Landend"); print_int(l); emit(":\n");
    
        return;
    }
    // --- OR short-circuit ---
    if (k == 24) {
        // One label id for .Ltrue and .Lorend, as in the AND case above.
        l = label_count;
        label_count += 1;
        gen_jump(nd, 1, "Ltrue", l);
        emit("    mov rax, 0\n");
        emit("    jmp .Lorend"); print_int(l); emit("\n");
        emit(".Ltrue"); print_int(l); emit(":\n");
        emit("    mov rax, 1\n");
        emit(".Lorend"); print_int(l); emit(":\n");
    
        return;
    }
    die("internal error: not an expression node");
    return;
}

void gen_stmt(int nd) {
    int saved_file = err_file;
    int saved_line = err_line;
    if (nd != 0) { err_file = nd.nfile; err_line = nd.nline; }
    gen_stmt_node(nd);
    err_file = saved_file;
    err_line = saved_line;
    return;
}

void gen_stmt_node(int nd) {
    int k = nd.kind;
    int l = 0;
    // --- var decl with init (k=5) ---
    if (k == 5) {
        if (nd.child2 != 0) { gen_expr(nd.child2); }
        else {
            emit("    mov rax, 0\n");
        }
        emit("    mov [rbp - "); print_int(nd.ival); emit("], rax\n");
    
        return;
    }
    // --- assignment (k=4) ---
    if (k == 4) {
        gen_expr(nd.child2);
        if (nd.extra == 1) {
            emit("    mov [.G"); emit(nd.sval); emit("], rax\n");
        } else {
            emit("    mov [rbp - "); print_int(nd.ival); emit("], rax\n");
        }
    
        return;
    }
    // --- array-index assignment (k=28) ---
    if (k == 28) {
        // base + index, then the value, as for store8.
        if (is_stable_leaf(nd.child1) == 1 && is_leaf(nd.child2) == 0) { gen_operands(nd.child2, nd.child1); }
        else { gen_operands(nd.child1, nd.child2); }
        emit("    add rax, rcx\n");
        if (is_leaf(nd.child3) == 1) {
            emit("    mov rdi, rax\n");
            gen_expr(nd.child3);
        } else {
            emit("    push rax\n");
            gen_expr(nd.child3);
            emit("    pop rdi\n");
        }
        emit("    mov byte ptr [rdi], al\n");
    
        return;
    }
    // --- field assignment (k=31, e.field = value) ---
    if (k == 31) {
        gen_addr_value(nd.child1, nd.child2);
        emit("    mov [rdi + "); print_int(nd.ival); emit("], rax\n");
    
        return;
    }
    // --- expression statement (k=21) ---
    if (k == 21) { gen_expr(nd.child1); return; }
    // --- if/else (k=18) ---
    if (k == 18) {
        l = label_count;
        // One label id for .Lelse and .Lend, told apart by name.
        label_count += 1;
        gen_jump_if_false(nd.child1, "Lelse", l);
        gen_stmt(nd.child2);
        // Without an else, .Lend follows .Lelse directly, so the jump would
        // land on the next instruction.
        if (nd.child3 != 0) { emit("    jmp .Lend"); print_int(l); emit("\n"); }
        emit(".Lelse"); print_int(l); emit(":\n");
        if (nd.child3 != 0) { gen_stmt(nd.child3); }
        emit(".Lend"); print_int(l); emit(":\n");
    
        return;
    }
    // --- while (k=19) ---
    if (k == 19) {
        l = label_count;
        // One label id for .Lstart and .Lend, as in if/else above.
        label_count += 1;
        emit(".Lstart"); print_int(l); emit(":\n");
        gen_jump_if_false(nd.child1, "Lend", l);
        if (gen_loop_depth >= 64) { die("loops nested too deeply (max 64)"); }
        store64(loop_labels + gen_loop_depth * 8, l);
        store64(loop_is_for + gen_loop_depth * 8, 0);
        gen_loop_depth += 1;
        gen_stmt(nd.child2);
        gen_loop_depth -= 1;
        emit("    jmp .Lstart"); print_int(l); emit("\n");
        emit(".Lend"); print_int(l); emit(":\n");

        return;
    }
    // --- for loop (k=40), child1 cond, child2 body, child3 step. continue
    // jumps to .Lstep so the step always runs, matching C. ---
    if (k == 40) {
        l = label_count;
        label_count += 1;
        emit(".Lstart"); print_int(l); emit(":\n");
        gen_jump_if_false(nd.child1, "Lend", l);
        if (gen_loop_depth >= 64) { die("loops nested too deeply (max 64)"); }
        store64(loop_labels + gen_loop_depth * 8, l);
        store64(loop_is_for + gen_loop_depth * 8, 1);
        gen_loop_depth += 1;
        gen_stmt(nd.child2);
        gen_loop_depth -= 1;
        emit(".Lstep"); print_int(l); emit(":\n");
        gen_stmt(nd.child3);
        emit("    jmp .Lstart"); print_int(l); emit("\n");
        emit(".Lend"); print_int(l); emit(":\n");
        return;
    }
    // --- return (k=20) ---
    if (k == 20) {
        if (nd.child2 != 0) {
            // return a, b; -- first value in rax, second in rdx.
            gen_expr(nd.child1);
            emit("    push rax\n");
            gen_expr(nd.child2);
            emit("    mov rdx, rax\n");
            emit("    pop rax\n");
        } else if (nd.child1 != 0) {
            gen_expr(nd.child1);
        }
        emit("    jmp .Lret"); print_int(current_ret_label); emit("\n");
        return;
    }
    // --- two-value assignment a, b = f(...) (k=41) ---
    if (k == 41) {
        gen_expr(nd.child1);
        if (nd.child2.extra == 1) { emit("    mov [.G"); emit(nd.child2.sval); emit("], rax\n"); }
        else { emit("    mov [rbp - "); print_int(nd.child2.ival); emit("], rax\n"); }
        if (nd.child3.extra == 1) { emit("    mov [.G"); emit(nd.child3.sval); emit("], rdx\n"); }
        else { emit("    mov [rbp - "); print_int(nd.child3.ival); emit("], rdx\n"); }
        return;
    }
    // --- defer (k=42) is collected now and emitted, reversed, at .Lret ---
    if (k == 42) {
        if (n_defers >= 64) { die("too many defers in one function (max 64)"); }
        store64(defers + n_defers * 8, nd.child1);
        n_defers += 1;
        return;
    }
    // --- break (k=25) ---
    if (k == 25) {
        emit("    jmp .Lend"); print_int(load64(loop_labels + (gen_loop_depth - 1) * 8)); emit("\n");
    
        return;
    }
    // --- continue (k=26) ---
    if (k == 26) {
        if (load64(loop_is_for + (gen_loop_depth - 1) * 8) == 1) {
            emit("    jmp .Lstep"); print_int(load64(loop_labels + (gen_loop_depth - 1) * 8)); emit("\n");
        } else {
            emit("    jmp .Lstart"); print_int(load64(loop_labels + (gen_loop_depth - 1) * 8)); emit("\n");
        }
        return;
    }
    // --- block (k=22) ---
    if (k == 22) { gen_block(nd); return; }
    die("internal error: not a statement node");
    return;
}

void gen_function(int f) {
    int frame = f.stack_size;
    int nparams = f.nparams;
    int i = 0;
    int rem = frame % 16;
    if (rem != 0) { frame += 16 - rem; }

    current_ret_label = label_count;
    label_count += 1;


    emit(f.name); emit(":\n");
    emit("    push rbp\n");
    emit("    mov rbp, rsp\n");
    if (frame > 0) { emit("    sub rsp, "); print_int(frame); emit("\n"); }

    while (i < nparams) {
        if (i < 6) {
            emit("    mov [rbp - "); print_int((i + 1) * 8); emit("], "); emit(arg_reg(i)); emit("\n");
        } else {
            emit("    mov rax, [rbp + "); print_int(16 + (nparams - 1 - i) * 8); emit("]\n");
            emit("    mov [rbp - "); print_int((i + 1) * 8); emit("], rax\n");
        }
        i += 1;
    }

    n_defers = 0;
    gen_block(f.body);

    emit(".Lret"); print_int(current_ret_label); emit(":\n");
    // Deferred statements run here, before the frame is torn down, in reverse
    // order. rax and rdx are saved so a cleanup call cannot clobber the return
    // value(s). Nothing is emitted when a function has no defers.
    if (n_defers > 0) {
        emit("    push rax\n");
        emit("    push rdx\n");
        for (i = n_defers - 1; i >= 0; i -= 1) {
            gen_stmt(load64(defers + i * 8));
        }
        emit("    pop rdx\n");
        emit("    pop rax\n");
    }
    emit("    mov rsp, rbp\n");
    emit("    pop rbp\n");
    emit("    ret\n");
    return;
}

// --- main reads the input, lexes, parses, resolves and emits assembly -----

int main() {
    int buf = 0;
    int n = 0;
    int got = 0;
    int name = 0;
    int gtail = 0;
    int ftail = 0;
    int g = 0;
    int g2 = 0;
    int e = 0;
    int f = 0;
    int f2 = 0;
    int np = 0;
    int i = 0;
    int j = 0;
    int found_main = 0;
    int p = 0;
    int len = 0;
    int infd = 0;
    int is_void = 0;
    int extra_head = 0;
    int extra_tail = 0;
    int pnode = 0;
    int l = 0;
    int fld_head = 0;
    int fld_tail = 0;
    int fld = 0;
    int decl_file = 0;
    int decl_line = 0;

    sym_names = alloc(4096 * 8);
    sym_offsets = alloc(4096 * 8);
    sym_types = alloc(4096 * 8);
    string_ptrs = alloc(4096 * 8);
    string_lens = alloc(4096 * 8);
    loop_labels = alloc(64 * 8);
    loop_is_for = alloc(64 * 8);
    defers = alloc(64 * 8);
    scope_marks = alloc(64 * 8);
    field_names = alloc(4096 * 8);
    field_offsets = alloc(4096 * 8);
    field_ambiguous = alloc(4096 * 8);
    layout_names = alloc(256 * 8);
    layout_sizes = alloc(256 * 8);

    // The CLI is `coff input.c0 output.s`, or `coff --elf input.c0 output.s` for
    // the Moonshot ring-3 target (still assembly; smed makes the ELF).
    // With no arguments, stdin/stdout works (differential-test harness),
    // and `coff --elf` alone is the same with the Moonshot target.
    // Arguments come in any order, --elf, -I <dir> (any number, up to
    // MAX_INC_DIRS), and either no files (stdin to stdout) or two.
    int cli_input = 0;
    int cli_output = 0;
    int npos = 0;
    int usage = 0;
    inc_dirs = alloc(MAX_INC_DIRS * 8);
    src_name = "<stdin>";
    int argi = 1;
    while (argi < argc()) {
        int a = argv(argi);
        if (streq(a, "--elf") == 1) {
            elf_mode = 1;
        } else if (streq(a, "-I") == 1 && argi + 1 < argc() && n_inc_dirs < MAX_INC_DIRS) {
            argi += 1;
            int d = argv(argi);
            int dl = strlen_(d);
            int ws = alloc(dl + 2);
            int j = 0;
            for (j = 0; j < dl; j += 1) { store8(ws + j, load8(d + j)); }
            store8(ws + dl, 0);
            if (dl == 0 || load8(d + dl - 1) != '/') { store8(ws + dl, '/'); store8(ws + dl + 1, 0); }
            store64(inc_dirs + n_inc_dirs * 8, ws);
            n_inc_dirs += 1;
        } else if (!npos) {
            cli_input = argi; npos = 1;
        } else if (npos == 1) {
            cli_output = argi; npos = 2;
        } else {
            usage = 1;
        }
        argi += 1;
    }
    if (npos == 1) { usage = 1; }
    if (usage == 1) {
        eput("usage: coff1 [--elf] [-I dir]... <input.c0> <output.s>  |  coff1 [--elf] < input.c0 > output.s");
        efail();
    }
    if (npos == 2) {
        src_name = argv(cli_input);
        infd = open_read(src_name);
        if (infd < 0) { die_open(src_name, infd); }
        outfd = open_write(argv(cli_output));
        if (outfd < 0) { die_open(argv(cli_output), outfd); }
    }

    // Real path known (the normal CLI form with input/output files) ->
    // expand include directives, resolving relative paths against
    // the input file's own directory.
    if (npos == 2) {
        expand_buf = alloc(EXPAND_CAP);
        expand_len = 0;
        include_stack = alloc(INCLUDE_MAX_DEPTH * 8);
        included = alloc(MAX_INCLUDED * 8);
        expand_file(argv(cli_input));
        buf = expand_buf;
        n = expand_len;
    } else {
        // No include expansion without a path to resolve against, so
        // stdin is read as it is, into a growing buffer (see read_all).
        buf = read_all(infd);
        n = read_all_len;
    }

    lex_all(buf, n);
    tpos = 0;

    while (tok_kind(tpos) != 26) {
        is_void = 0;
        // `embed` is a word, not a keyword (see coff0.c).
        if (tok_kind(tpos) == 2 && streq(tok_name(tpos), "embed") == 1
            && tok_kind(tpos + 1) == 2 && tok_kind(tpos + 2) == 3) {
            int em = alloc(sizeof(Embed));
            em.name = tok_name(tpos + 1);
            int plen = tok_len(tpos + 2);
            int pstr = alloc(plen + 1);
            int pi = 0;
            for (pi = 0; pi < plen; pi += 1) { store8(pstr + pi, load8(tok_name(tpos + 2) + pi)); }
            store8(pstr + plen, 0);
            em.epath = pstr;
            em.efile = (toks + (tpos + 1) * sizeof(Token)).tfile;
            em.eline = (toks + (tpos + 1) * sizeof(Token)).tline;
            tpos += 3;
            expect(19, "';'");
            // The whole path the assembler will be given, the source file's
            // own directory included, since it goes between quotes in .incbin.
            em.eresolved = join_path(dirname_with_slash(em.efile), pstr);
            for (pi = 0; load8(em.eresolved + pi) != 0; pi += 1) {
                int pc = load8(em.eresolved + pi);
                if (pc == 34 || pc == 92 || pc == 10) { at_prev(); die("embed: the path may not contain quotes, backslashes or newlines"); }
            }
            if (!embhead) { embhead = em; embtail = em; }
            else { embtail.enext = em; embtail = em; }
            continue;
        }
        if (tok_kind(tpos) == 34) {
            tpos += 1;
            expect(21, "'int' after 'extern'");
            want(2, "a name");
            name = tok_name(tpos);
            tpos += 1;
            expect(19, "';'");
            e = alloc(sizeof(Global));  // externs are Global-shaped, name + (unused) init + next
            e.name = name;
            e.init = 0;
            e.gfile = (toks + (tpos - 2) * sizeof(Token)).tfile;
            e.gline = (toks + (tpos - 2) * sizeof(Token)).tline;
            if (!ehead) { ehead = e; etail = e; }
            else { etail.next = e; etail = e; }
            continue;
        }
        if (tok_kind(tpos) == 36) {
            tpos += 1;
            want(2, "a layout name");
            l = alloc(sizeof(Layout));
            l.name = tok_name(tpos);
            l.lfile = (toks + tpos * sizeof(Token)).tfile;
            l.lline = (toks + tpos * sizeof(Token)).tline;
            tpos += 1;
            expect(17, "'{'");
            fld_head = 0;
            fld_tail = 0;
            while (tok_kind(tpos) != 18) {
                expect(21, "'int' (every layout field is an int)");
                want(2, "a field name");
                fld = alloc(sizeof(LayoutField));
                fld.name = tok_name(tpos);
                fld.lffile = (toks + tpos * sizeof(Token)).tfile;
                fld.lfline = (toks + tpos * sizeof(Token)).tline;
                tpos += 1;
                expect(19, "';'");
                if (!fld_head) { fld_head = fld; fld_tail = fld; }
                else { fld_tail.next = fld; fld_tail = fld; }
            }
            expect(18, "'}'");
            l.fields = fld_head;
            if (!lhead) { lhead = l; ltail = l; }
            else { ltail.next = l; ltail = l; }
            continue;
        }
        int gtype = 0;
        int two_ret = 0;
        if (tok_kind(tpos) == 15) {
            tpos += 1;
            expect(21, "'int'");
            expect(20, "',' (a two-value return is '(int, int)')");
            expect(21, "'int'");
            expect(16, "')'");
            two_ret = 1;
        }
        else if (tok_kind(tpos) == 33) { is_void = 1; tpos += 1; }
        else if (at_typed_decl() == 1) { gtype = tok_name(tpos); tpos += 1; }
        else { expect(21, "'int' or 'void'"); }
        want(2, "a name");
        name = tok_name(tpos);
        decl_file = (toks + tpos * sizeof(Token)).tfile;
        decl_line = (toks + tpos * sizeof(Token)).tline;
        tpos += 1;
        if (gtype != 0 && tok_kind(tpos) == 15) { at_prev(); die("a function returns int or void, not a layout"); }
        if (tok_kind(tpos) == 15) {
            f = alloc(sizeof(Function));
            f.ptypes = alloc(16 * 8);
            f.name = name;
            f.ffile = decl_file;
            f.fline = decl_line;
            f.is_void = is_void;
            f.two_ret = two_ret;
            tpos += 1;
            np = 0;
            extra_head = 0;
            extra_tail = 0;
            if (tok_kind(tpos) != 16) {
                while (1) {
                    int ptype = 0;
                    if (at_typed_decl() == 1) { ptype = tok_name(tpos); tpos += 1; }
                    else { expect(21, "'int' or a layout name"); }
                    if (np >= 16) { at_prev(); die3("too many parameters for '", f.name, "' (max 16)"); }
                    want(2, "a parameter name");
                    if (np < 16) { store64(f.ptypes + np * 8, ptype); }
                    if (np < 6) {
                        store64(f + 56 + np * 8, tok_name(tpos));
                    } else {
                        pnode = alloc(sizeof(ExtraParam));
                        pnode.name = tok_name(tpos);
                        if (!extra_head) { extra_head = pnode; extra_tail = pnode; }
                        else { extra_tail.next = pnode; extra_tail = pnode; }
                    }
                    np += 1;
                    tpos += 1;
                    if (tok_kind(tpos) == 20) { tpos += 1; }
                    else { break; }
                }
            }
            expect(16, "')'");
            f.nparams = np;
            f.extra_params = extra_head;
            f.body = p_block();
            if (!fhead) { fhead = f; ftail = f; }
            else { ftail.fnext = f; ftail = f; }
        } else {
            if (two_ret == 1) { at_prev(); die("'(int, int)' must be followed by a function"); }
            if (is_void == 1) { at_prev(); die("'void' is not a valid type for a global"); }
            g = alloc(sizeof(Global));
            g.name = name;
            g.gfile = decl_file;
            g.gline = decl_line;
            g.gtype = gtype;
            if (tok_kind(tpos) == 8) {
                tpos += 1;
                g.init = const_fold(p_expr());
            }
            expect(19, "';'");
            if (!ghead) { ghead = g; gtail = g; }
            else { gtail.next = g; gtail = g; }
        }
    }

    // Pass A checks function signatures — no builtin-name clash, exactly one main
    // taking no parameters, no duplicate function names.
    // Same checks in the same order as coff0's main(), each declaration
    // against builtins, then against the other kind, then against earlier
    // declarations of its own kind. The order decides which message a file
    // with several mistakes gets, and the two compilers must agree on it.
    f = fhead;
    while (f != 0) {
        err_file = f.ffile;
        err_line = f.fline;
        if (is_builtin(f.name) == 1) { die3("'", f.name, "' is a builtin and cannot be redefined"); }
        check_symbol_name(f.name, "a function");
        f2 = fhead;
        while (f2 != f) {
            if (streq(f.name, f2.name) == 1) { die3("redefinition of function '", f.name, "'"); }
            f2 = f2.fnext;
        }
        if (streq(f.name, "main") == 1) {
            if (f.nparams != 0) { die("'main' must take no parameters"); }
            if (f.is_void == 1) { die("'main' must return int, not void"); }
            found_main = 1;
        }
        f = f.fnext;
    }
    err_line = 0;
    if (!found_main) { die("no 'main' function defined"); }

    g = ghead;
    while (g != 0) {
        err_file = g.gfile;
        err_line = g.gline;
        if (is_builtin(g.name) == 1) { die3("'", g.name, "' is a builtin and cannot be redefined"); }
        f = fhead;
        while (f != 0) {
            if (streq(f.name, g.name) == 1) { die3("'", g.name, "' is both a function and a global"); }
            f = f.fnext;
        }
        g2 = ghead;
        while (g2 != g) {
            if (streq(g.name, g2.name) == 1) { die3("redefinition of global '", g.name, "'"); }
            g2 = g2.next;
        }
        g = g.next;
    }

    e = ehead;
    while (e != 0) {
        err_file = e.gfile;
        err_line = e.gline;
        if (is_builtin(e.name) == 1) { die3("'", e.name, "' is a builtin and cannot be used as extern"); }
        check_symbol_name(e.name, "an extern");
        g = ghead;
        while (g != 0) {
            if (streq(g.name, e.name) == 1) { die3("'", e.name, "' is both a global and an extern"); }
            g = g.next;
        }
        int e2 = ehead;
        while (e2 != e) {
            if (streq(e.name, e2.name) == 1) { die3("redefinition of extern '", e.name, "'"); }
            e2 = e2.next;
        }
        e = e.next;
    }

    // An embed's name is an address, like an extern; name_size is a global
    // the assembler fills in. Same checks, order and messages as coff0.c.
    int emb = embhead;
    int emb_n = 0;
    while (emb != 0) {
        err_file = emb.efile;
        err_line = emb.eline;
        if (is_builtin(emb.name) == 1) { die3("'", emb.name, "' is a builtin and cannot be used as embed"); }
        check_symbol_name(emb.name, "an embed");
        if (glob_exists(emb.name) == 1 || func_exists(emb.name) == 1 || extern_exists(emb.name) == 1) {
            die3("'", emb.name, "' is declared twice");
        }
        int ex = alloc(sizeof(Global));
        ex.name = emb.name;
        ex.gfile = emb.efile;
        ex.gline = emb.eline;
        if (!ehead) { ehead = ex; etail = ex; } else { etail.next = ex; etail = ex; }
        int nl = strlen_(emb.name);
        int sz = alloc(nl + 6);
        int si = 0;
        for (si = 0; si < nl; si += 1) { store8(sz + si, load8(emb.name + si)); }
        store8(sz + nl, '_'); store8(sz + nl + 1, 's'); store8(sz + nl + 2, 'i');
        store8(sz + nl + 3, 'z'); store8(sz + nl + 4, 'e'); store8(sz + nl + 5, 0);
        if (glob_exists(sz) == 1 || func_exists(sz) == 1 || extern_exists(sz) == 1) {
            die3("'", sz, "' is declared twice");
        }
        int sg = alloc(sizeof(Global));
        sg.name = sz;
        sg.gfile = emb.efile;
        sg.gline = emb.eline;
        emb_n += 1;
        sg.gembed = emb_n;
        sg.init = emb.name;   // what the size is measured from, for codegen
        if (!ghead) { ghead = sg; gtail = sg; } else { gtail.next = sg; gtail = sg; }
        emb = emb.enext;
    }

    l = lhead;
    while (l != 0) {
        layout_declare(l);
        l = l.next;
    }
    g = ghead;
    while (g != 0) {
        err_file = g.gfile;
        err_line = g.gline;
        check_type(g.gtype);
        g = g.next;
    }

    // Pass C resolves every function body, assigning stack offsets.
    f = fhead;
    while (f != 0) {
        sym_count = 0;
        stack_size = 0;
        scope_depth = 0;
        current_fn_is_void = f.is_void;
        current_fn_two_ret = f.two_ret;
        err_file = f.ffile;
        err_line = f.fline;
        np = f.nparams;
        i = 0;
        for (i = 0; i < np; i += 1) {
            check_type(load64(f.ptypes + i * 8));
            sym_declare(param_name_at(f, i));
            store64(sym_types + (sym_count - 1) * 8, load64(f.ptypes + i * 8));
        }
        resolve(f.body);
        f.stack_size = stack_size;
        f = f.fnext;
    }

    // Pass D emits code.

    emit(".intel_syntax noprefix\n");
    emit(".global _start\n");
    emit("_start:\n");
    emit("    mov [.Largv0], rsp\n");
    emit("    call main\n");
    emit("    mov rdi, rax\n");
    if (elf_mode == 1) {
        emit("    mov rax, 0\n");     // Moonshot SYS_EXIT with main's value
    } else {
        emit("    mov rax, 60\n");    // Linux exit
    }
    emit("    syscall\n");

    f = fhead;
    while (f != 0) {
        gen_function(f);
        f = f.fnext;
    }

    if (string_count > 0) {
        emit("\n.section .rodata\n");
        i = 0;
        for (i = 0; i < string_count; i += 1) {
            emit(".Lstr"); print_int(i); emit(":\n");
            emit("    .byte");
            p = load64(string_ptrs + i * 8);
            len = load64(string_lens + i * 8);
            for (j = 0; j < len; j += 1) {
                emit(" "); print_int(p[j]); emit(",");
            }
            emit(" 0\n");
        }
    }

    // Embedded files, each followed by a label so their length is a
    // difference of two addresses (see coff0.c).
    int ei = 0;
    int eb = embhead;
    while (eb != 0) {
        if (!ei) { emit("\n.section .rodata\n"); }
        emit(".balign 8\n"); emit(eb.name); emit(":\n    .incbin \"");
        emit(eb.eresolved); emit("\"\n.Lembend"); print_int(ei); emit(":\n");
        ei += 1;
        eb = eb.enext;
    }

    emit("\n.section .data\n");
    emit(".Lcurbrk:\n    .quad 0\n");
    emit(".Largv0:\n    .quad 0\n");
    g = ghead;
    while (g != 0) {
        if (g.gembed == 0) {
            emit(".G"); emit(g.name); emit(":\n    .quad ");
            print_int(g.init);
            emit("\n");
        }
        g = g.next;
    }
    g = ghead;
    while (g != 0) {
        if (g.gembed != 0) {
            emit(".G"); emit(g.name); emit(":\n    .quad .Lembend");
            print_int(g.gembed - 1); emit(" - ");
            emit(g.init); emit("\n");
        }
        g = g.next;
    }

    if (outfd != 1) { close(outfd); }
    return 0;
}
