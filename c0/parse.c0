// Purpose: the second piece of the self-hosted compiler, kept as a
// standalone differential test stage. Reads c0 source from stdin (or an
// optional file argument, see main -- include directives need a real
// path to resolve against) and prints the parse tree to stdout in
// exactly the format of `coff0 -a`, which is the contract the astdiff
// loop in run_tests.sh checks. On any lex or parse error it prints
// PARSEERROR and exits 1.
//
// Phase 1 lexes the whole input into a token array in alloc'd memory,
// mirroring coff0's own structure. That also gives the parser free
// arbitrary lookahead, which the assign-vs-exprstmt split needs: the
// left side of an assignment can be an arbitrarily long `buf[i]`
// postfix chain, not just one IDENT token.
// Phase 2 is recursive descent, building AST nodes with alloc/store64.
//
// Token record: 32 bytes — 0 kind, 8 ival, 16 name ptr, 24 len.
// Token kinds: 1 NUM, 2 IDENT, 3 STR, 4 PLUS, 5 MINUS, 6 STAR, 7 SLASH,
//   8 ASSIGN, 9 EQ, 10 NE, 11 LT, 12 LE, 13 GT, 14 GE, 15 LPAREN,
//   16 RPAREN, 17 LBRACE, 18 RBRACE, 19 SEMI, 20 COMMA, 21 INT, 22 IF,
//   23 ELSE, 24 WHILE, 25 RETURN, 26 EOF, 27 AND, 28 OR, 29 BREAK, 30 CONTINUE,
//   31 LBRACKET, 32 RBRACKET, 33 VOID, 34 EXTERN, 35 DOT, 36 LAYOUT, 37 SIZEOF.
// AST node: 64 bytes — 0 kind, 8 ival, 16 name/str ptr, 24 str len,
//   32 child1 (lhs/cond/args/body), 40 child2 (rhs/then), 48 child3 (else),
//   56 next sibling.
// Node kinds: 1 NUM, 2 STR, 3 VAR, 4 ASSIGN, 5 DECL, 6 CALL, 7 ADD, 8 SUB,
//   9 MUL, 10 DIV, 11 EQ, 12 NE, 13 LT, 14 LE, 15 GT, 16 GE, 17 NEG,
//   18 IF, 19 WHILE, 20 RETURN, 21 EXPRSTMT, 22 BLOCK, 23 AND, 24 OR,
//   25 BREAK, 26 CONTINUE, 27 INDEX (child1=base, child2=index),
//   28 INDEXASSIGN (child1=base, child2=index, child3=value),
//   30 FIELD (name=field, child1=base; e.field, sugar over load64(base+offset)),
//   31 FIELDASSIGN (name=field, child1=base, child2=value),
//   32 SIZEOF (name=layout name; sizeof(Name), a compile-time constant --
//   parse.c0 only dumps the raw form, coff0's resolve pass is what would
//   rewrite it to a NUM, so -a output shows it as-is here).
// Layout record: 24 bytes — 0 name, 8 fields (head of a linked list),
//   16 next. Layout field record: 16 bytes — 0 name, 8 next.
// Precedence (low to high): logic_or, logic_and, equality, relational,
// additive, term, unary, postfix. && and || are both short-circuiting.
// postfix := primary (("[" expr "]") | ("." IDENT))*  -- buf[i] is sugar
// over load8(buf+i)/store8; e.field is sugar over load64(e+offset)/store64.

int toks = 0;
int tpos = 0;

// Include-expansion state -- see the "includes" section below (right after
// copy_bytes) for the real logic; these are just the shared globals it
// needs across recursive calls.
int INCLUDE_MAX_DEPTH = 32;
int include_stack = 0; // alloc'd once, INCLUDE_MAX_DEPTH * 8 bytes
int include_depth = 0;
int EXPAND_CAP = 4194304; // 4MB
int expand_buf = 0;
int expand_len = 0;

int is_digit(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

int is_hex_digit(int c) {
    if (is_digit(c) == 1) { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int hex_value(int c) {
    if (is_digit(c) == 1) { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

int is_ident_start(int c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

int is_ident_char(int c) {
    if (is_digit(c) == 1) { return 1; }
    return is_ident_start(c);
}

void print_int(int v) {
    int tmp = alloc(32);
    int neg = 0;
    int i = 31;
    if (v == 0) { print("0"); return; }
    if (v < 0) { neg = 1; v = 0 - v; }
    while (v > 0) {
        i = i - 1;
        store8(tmp + i, '0' + (v - (v / 10) * 10));
        v = v / 10;
    }
    if (neg == 1) { i = i - 1; store8(tmp + i, '-'); }
    print(tmp + i);
    return;
}

int word_is(int buf, int start, int len, int kw) {
    int i = 0;
    int k = 0;
    while (i < len) {
        k = load8(kw + i);
        if (k == 0) { return 0; }
        if (load8(buf + start + i) != k) { return 0; }
        i = i + 1;
    }
    if (load8(kw + len) != 0) { return 0; }
    return 1;
}

int copy_bytes(int buf, int start, int len) {
    int p = alloc(len + 1);
    int i = 0;
    while (i < len) {
        store8(p + i, load8(buf + start + i));
        i = i + 1;
    }
    return p;
}

// -------------------------------------------------------------- includes
//
// `include "path.c0";` is pure textual substitution, resolved entirely
// before real lexing starts -- mirrors coff0.c's resolve_includes exactly
// (differentially verified against it, and against lex.c0's own identical
// mirror), see coff0.c for the full design rationale.

int slen(int s) {
    int i = 0;
    while (load8(s + i) != 0) {
        i = i + 1;
    }
    return i;
}

int streq_(int a, int b) {
    int i = 0;
    int going = 1;
    int result = 0;
    while (going == 1) {
        int ca = load8(a + i);
        int cb = load8(b + i);
        if (ca != cb) { going = 0; }
        else if (ca == 0) { going = 0; result = 1; }
        else { i = i + 1; }
    }
    return result;
}

// Directory portion of `path` (a null-terminated string), trailing slash
// included so callers can concatenate directly, or a fresh empty string
// if `path` has no slash (same-directory relative resolution).
int dirname_with_slash(int path) {
    int len = slen(path);
    int i = len - 1;
    while (i >= 0) {
        if (load8(path + i) == '/') {
            return copy_bytes(path, 0, i + 1);
        }
        i = i - 1;
    }
    int empty = alloc(1);
    store8(empty, 0);
    return empty;
}

int join_path(int dir, int rel) {
    int dl = slen(dir);
    int rl = slen(rel);
    int out = alloc(dl + rl + 1);
    int i = 0;
    while (i < dl) {
        store8(out + i, load8(dir + i));
        i = i + 1;
    }
    int j = 0;
    while (j < rl) {
        store8(out + dl + j, load8(rel + j));
        j = j + 1;
    }
    store8(out + dl + rl, 0);
    return out;
}

void expand_putc(int c) {
    if (expand_len >= EXPAND_CAP) {
        print("PARSEERROR\n");
        exit(1);
    }
    store8(expand_buf + expand_len, c);
    expand_len = expand_len + 1;
    return;
}

// Reads `path`, scans its raw text for `include "X";` directives (copying
// everything else through unchanged, including string literals, char
// literals, and // comments verbatim so none of them can trigger a false
// match), and recursively expands each include in place -- appending the
// result into the shared expand_buf/expand_len globals. include_stack/
// include_depth guard against a file including itself, directly or
// transitively. Char literals get the SAME verbatim-copy treatment as
// strings deliberately, not as an afterthought: without it, a literal
// like '"' makes the scanner wrongly enter STRING mode at that bare `"`
// instead, scanning forward to whatever `"` happens to appear next in the
// file -- a real bug found building lex.c0's identical mirror of this
// function (which itself contains `!= '"'`).
void expand_file(int path) {
    int i = 0;
    while (i < include_depth) {
        if (streq_(load64(include_stack + i * 8), path) == 1) {
            print("PARSEERROR\n");
            exit(1);
        }
        i = i + 1;
    }
    if (include_depth >= INCLUDE_MAX_DEPTH) {
        print("PARSEERROR\n");
        exit(1);
    }
    store64(include_stack + include_depth * 8, path);
    include_depth = include_depth + 1;

    int fd = open_read(path);
    if (fd < 0) {
        print("PARSEERROR\n");
        exit(1);
    }
    int src = alloc(1048576);
    int n = 0;
    int got = read(fd, src, 1048576);
    while (got > 0) {
        n = n + got;
        got = read(fd, src + n, 1048576 - n);
    }
    close(fd);

    int dir = dirname_with_slash(path);
    int p = 0;
    while (p < n) {
        int c = load8(src + p);
        if (c == '"') {
            expand_putc(c);
            p = p + 1;
            int scanning = 1;
            while (scanning == 1) {
                if (p >= n || load8(src + p) == '"') { scanning = 0; }
                else {
                    int sc = load8(src + p);
                    if (sc == '\\' && p + 1 < n) {
                        expand_putc(sc);
                        p = p + 1;
                        expand_putc(load8(src + p));
                        p = p + 1;
                    } else {
                        expand_putc(sc);
                        p = p + 1;
                    }
                }
            }
            if (p < n) { expand_putc('"'); p = p + 1; }
        } else if (c == '\'') {
            expand_putc(c);
            p = p + 1;
            if (p < n && load8(src + p) == '\\' && p + 1 < n) {
                expand_putc(load8(src + p));
                p = p + 1;
                expand_putc(load8(src + p));
                p = p + 1;
            } else if (p < n) {
                expand_putc(load8(src + p));
                p = p + 1;
            }
            if (p < n && load8(src + p) == '\'') {
                expand_putc('\'');
                p = p + 1;
            }
        } else if (c == '/' && p + 1 < n && load8(src + p + 1) == '/') {
            while (p < n && load8(src + p) != '\n') {
                expand_putc(load8(src + p));
                p = p + 1;
            }
        } else if (is_ident_start(c) == 1) {
            int start = p;
            while (p < n && is_ident_char(load8(src + p)) == 1) {
                p = p + 1;
            }
            int wlen = p - start;
            if (wlen == 7 && word_is(src, start, 7, "include") == 1) {
                int q = p;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q = q + 1;
                }
                if (q >= n || load8(src + q) != '"') { print("PARSEERROR\n"); exit(1); }
                q = q + 1;
                int pstart = q;
                while (q < n && load8(src + q) != '"') { q = q + 1; }
                if (q >= n) { print("PARSEERROR\n"); exit(1); }
                int rel = copy_bytes(src, pstart, q - pstart);
                q = q + 1;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q = q + 1;
                }
                if (q >= n || load8(src + q) != ';') { print("PARSEERROR\n"); exit(1); }
                q = q + 1;
                expand_file(join_path(dir, rel));
                p = q;
            } else {
                int k = start;
                while (k < p) {
                    expand_putc(load8(src + k));
                    k = k + 1;
                }
            }
        } else {
            expand_putc(c);
            p = p + 1;
        }
    }

    include_depth = include_depth - 1;
    return;
}

void perr() {
    print("PARSEERROR\n");
    exit(1);
    return;
}

void tok_put(int i, int kind, int ival, int name, int len) {
    int p = toks + i * 32;
    store64(p, kind);
    store64(p + 8, ival);
    store64(p + 16, name);
    store64(p + 24, len);
    return;
}

int tok_kind(int i) { return load64(toks + i * 32); }
int tok_ival(int i) { return load64(toks + i * 32 + 8); }
int tok_name(int i) { return load64(toks + i * 32 + 16); }
int tok_len(int i)  { return load64(toks + i * 32 + 24); }

// Lex all of buf[0..n) into the global token array; appends an EOF token.
void lex_all(int buf, int n) {
    int pos = 0;
    int t = 0;
    int c = 0;
    int nxt = 0;
    int going = 0;
    int v = 0;
    int d = 0;
    int start = 0;
    int len = 0;
    int s = 0;
    int e = 0;
    int q = 0;
    int name = 0;
    int sbuf = 0;
    int slen = 0;
    int base = 0;
    int is_hex = 0;

    toks = alloc((n + 2) * 32);

    while (pos < n) {
        c = load8(buf + pos);

        if (c == ' ') { pos = pos + 1; }
        else if (c == '\n') { pos = pos + 1; }
        else if (c == '\t') { pos = pos + 1; }
        else if (c == 13) { pos = pos + 1; }

        else if (c == '/') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '/') {
                going = 1;
                while (going == 1) {
                    if (pos < n) {
                        if (load8(buf + pos) != '\n') { pos = pos + 1; }
                        else { going = 0; }
                    } else { going = 0; }
                }
            } else {
                tok_put(t, 7, 0, 0, 0);
                t = t + 1;
                pos = pos + 1;
            }
        }

        else if (is_digit(c) == 1) {
            v = 0;
            base = 10;
            is_hex = 0;
            if (c == '0' && pos + 2 < n) {
                nxt = load8(buf + pos + 1);
                if ((nxt == 'x' || nxt == 'X') && is_hex_digit(load8(buf + pos + 2)) == 1) {
                    is_hex = 1;
                }
            }
            if (is_hex == 1) { pos = pos + 2; base = 16; }
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    d = load8(buf + pos);
                    if (base == 16) {
                        if (is_hex_digit(d) == 1) {
                            v = v * 16 + hex_value(d);
                            pos = pos + 1;
                        } else { going = 0; }
                    } else if (is_digit(d) == 1) {
                        v = v * 10 + (d - '0');
                        pos = pos + 1;
                    } else { going = 0; }
                } else { going = 0; }
            }
            tok_put(t, 1, v, 0, 0);
            t = t + 1;
        }

        else if (is_ident_start(c) == 1) {
            start = pos;
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    if (is_ident_char(load8(buf + pos)) == 1) { pos = pos + 1; }
                    else { going = 0; }
                } else { going = 0; }
            }
            len = pos - start;
            if (word_is(buf, start, len, "int") == 1) { tok_put(t, 21, 0, 0, 0); }
            else if (word_is(buf, start, len, "if") == 1) { tok_put(t, 22, 0, 0, 0); }
            else if (word_is(buf, start, len, "else") == 1) { tok_put(t, 23, 0, 0, 0); }
            else if (word_is(buf, start, len, "while") == 1) { tok_put(t, 24, 0, 0, 0); }
            else if (word_is(buf, start, len, "return") == 1) { tok_put(t, 25, 0, 0, 0); }
            else if (word_is(buf, start, len, "break") == 1) { tok_put(t, 29, 0, 0, 0); }
            else if (word_is(buf, start, len, "continue") == 1) { tok_put(t, 30, 0, 0, 0); }
            else if (word_is(buf, start, len, "void") == 1) { tok_put(t, 33, 0, 0, 0); }
            else if (word_is(buf, start, len, "extern") == 1) { tok_put(t, 34, 0, 0, 0); }
            else if (word_is(buf, start, len, "layout") == 1) { tok_put(t, 36, 0, 0, 0); }
            else if (word_is(buf, start, len, "sizeof") == 1) { tok_put(t, 37, 0, 0, 0); }
            else {
                name = copy_bytes(buf, start, len);
                tok_put(t, 2, 0, name, len);
            }
            t = t + 1;
        }

        else if (c == '"') {
            pos = pos + 1;
            sbuf = alloc(n + 1);
            slen = 0;
            going = 1;
            while (going == 1) {
                if (pos >= n) { perr(); }
                s = load8(buf + pos);
                if (s == '"') {
                    going = 0;
                    pos = pos + 1;
                } else if (s == '\\') {
                    pos = pos + 1;
                    if (pos >= n) { perr(); }
                    e = load8(buf + pos);
                    v = 0 - 1;
                    if (e == 'n') { v = '\n'; }
                    if (e == 't') { v = '\t'; }
                    if (e == '\\') { v = '\\'; }
                    if (e == '"') { v = '"'; }
                    if (v < 0) { perr(); }
                    store8(sbuf + slen, v);
                    slen = slen + 1;
                    pos = pos + 1;
                } else {
                    store8(sbuf + slen, s);
                    slen = slen + 1;
                    pos = pos + 1;
                }
            }
            tok_put(t, 3, 0, sbuf, slen);
            t = t + 1;
        }

        else if (c == '\'') {
            pos = pos + 1;
            if (pos >= n) { perr(); }
            v = 0 - 1;
            e = load8(buf + pos);
            if (e == '\\') {
                pos = pos + 1;
                if (pos >= n) { perr(); }
                q = load8(buf + pos);
                if (q == 'n') { v = '\n'; }
                if (q == 't') { v = '\t'; }
                if (q == '\\') { v = '\\'; }
                if (q == '\'') { v = '\''; }
                if (q == '0') { v = 0; }
                if (v < 0) {
                    if (q != '0') { perr(); }
                }
                pos = pos + 1;
            } else {
                if (e == '\'') { perr(); }
                v = e;
                pos = pos + 1;
            }
            if (pos >= n) { perr(); }
            if (load8(buf + pos) != '\'') { perr(); }
            pos = pos + 1;
            tok_put(t, 1, v, 0, 0);
            t = t + 1;
        }

        else if (c == '=') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 9, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 8, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '!') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 10, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '<') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 12, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 11, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '>') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 14, 0, 0, 0); pos = pos + 2; }
            else { tok_put(t, 13, 0, 0, 0); pos = pos + 1; }
            t = t + 1;
        }
        else if (c == '+') { tok_put(t, 4, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '-') { tok_put(t, 5, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '*') { tok_put(t, 6, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '(') { tok_put(t, 15, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ')') { tok_put(t, 16, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '{') { tok_put(t, 17, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '}') { tok_put(t, 18, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ';') { tok_put(t, 19, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ',') { tok_put(t, 20, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '&') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '&') { tok_put(t, 27, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '|') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '|') { tok_put(t, 28, 0, 0, 0); pos = pos + 2; t = t + 1; }
            else { perr(); }
        }
        else if (c == '[') { tok_put(t, 31, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == ']') { tok_put(t, 32, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else if (c == '.') { tok_put(t, 35, 0, 0, 0); t = t + 1; pos = pos + 1; }
        else { perr(); }
    }

    tok_put(t, 26, 0, 0, 0);
    return;
}

// Name of the i'th declared parameter (0-indexed), regardless of whether it
// lives in the inline register-param slots or the extra_params list.
int param_name_at(int f, int i) {
    int p = 0;
    int k = 0;
    if (i < 6) { return load64(f + 16 + i * 8); }
    p = load64(f + 88);
    k = i - 6;
    while (k > 0) {
        p = load64(p + 8);
        k = k - 1;
    }
    return load64(p);
}

// --- parser ---------------------------------------------------------------

int new_node(int kind) {
    int p = alloc(64);
    store64(p, kind);
    return p;
}

void expect(int k) {
    if (tok_kind(tpos) != k) { perr(); }
    tpos = tpos + 1;
    return;
}

int p_primary() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int head = 0;
    int tail = 0;
    int a = 0;
    k = tok_kind(tpos);
    if (k == 15) {
        tpos = tpos + 1;
        nd = p_expr();
        expect(16);
        return nd;
    }
    if (k == 1) {
        nd = new_node(1);
        store64(nd + 8, tok_ival(tpos));
        tpos = tpos + 1;
        return nd;
    }
    if (k == 3) {
        nd = new_node(2);
        store64(nd + 16, tok_name(tpos));
        store64(nd + 24, tok_len(tpos));
        tpos = tpos + 1;
        return nd;
    }
    if (k == 2) {
        name = tok_name(tpos);
        tpos = tpos + 1;
        if (tok_kind(tpos) == 15) {
            tpos = tpos + 1;
            nd = new_node(6);
            store64(nd + 16, name);
            head = 0;
            tail = 0;
            if (tok_kind(tpos) != 16) {
                a = p_expr();
                head = a;
                tail = a;
                while (tok_kind(tpos) == 20) {
                    tpos = tpos + 1;
                    a = p_expr();
                    store64(tail + 56, a);
                    tail = a;
                }
            }
            expect(16);
            store64(nd + 32, head);
            return nd;
        }
        nd = new_node(3);
        store64(nd + 16, name);
        return nd;
    }
    if (k == 37) {
        tpos = tpos + 1;
        expect(15);
        if (tok_kind(tpos) != 2) { perr(); }
        nd = new_node(32);
        store64(nd + 16, tok_name(tpos));
        tpos = tpos + 1;
        expect(16);
        return nd;
    }
    perr();
    return 0;
}

int p_postfix() {
    int nd = 0;
    int idx = 0;
    int fld = 0;
    int going = 1;
    nd = p_primary();
    while (going == 1) {
        if (tok_kind(tpos) == 31) {
            tpos = tpos + 1;
            idx = new_node(27);
            store64(idx + 32, nd);
            store64(idx + 40, p_expr());
            expect(32);
            nd = idx;
        } else if (tok_kind(tpos) == 35) {
            tpos = tpos + 1;
            if (tok_kind(tpos) != 2) { perr(); }
            fld = new_node(30);
            store64(fld + 32, nd);
            store64(fld + 16, tok_name(tpos));
            tpos = tpos + 1;
            nd = fld;
        } else { going = 0; }
    }
    return nd;
}

int p_unary() {
    int nd = 0;
    if (tok_kind(tpos) == 5) {
        tpos = tpos + 1;
        nd = new_node(17);
        store64(nd + 32, p_unary());
        return nd;
    }
    return p_postfix();
}

int p_term() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int going = 1;
    left = p_unary();
    while (going == 1) {
        op = tok_kind(tpos);
        if (op == 6) {
            tpos = tpos + 1;
            nd = new_node(9);
            store64(nd + 32, left);
            store64(nd + 40, p_unary());
            left = nd;
        } else if (op == 7) {
            tpos = tpos + 1;
            nd = new_node(10);
            store64(nd + 32, left);
            store64(nd + 40, p_unary());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_add() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int going = 1;
    left = p_term();
    while (going == 1) {
        op = tok_kind(tpos);
        if (op == 4) {
            tpos = tpos + 1;
            nd = new_node(7);
            store64(nd + 32, left);
            store64(nd + 40, p_term());
            left = nd;
        } else if (op == 5) {
            tpos = tpos + 1;
            nd = new_node(8);
            store64(nd + 32, left);
            store64(nd + 40, p_term());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_rel() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    int going = 1;
    left = p_add();
    while (going == 1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 11) { kind = 13; }
        if (op == 12) { kind = 14; }
        if (op == 13) { kind = 15; }
        if (op == 14) { kind = 16; }
        if (kind > 0) {
            tpos = tpos + 1;
            nd = new_node(kind);
            store64(nd + 32, left);
            store64(nd + 40, p_add());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_equality() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    int going = 1;
    left = p_rel();
    while (going == 1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 9) { kind = 11; }
        if (op == 10) { kind = 12; }
        if (kind > 0) {
            tpos = tpos + 1;
            nd = new_node(kind);
            store64(nd + 32, left);
            store64(nd + 40, p_rel());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_logic_and() {
    int left = 0;
    int nd = 0;
    left = p_equality();
    while (tok_kind(tpos) == 27) {
        tpos = tpos + 1;
        nd = new_node(23);
        store64(nd + 32, left);
        store64(nd + 40, p_equality());
        left = nd;
    }
    return left;
}

int p_logic_or() {
    int left = 0;
    int nd = 0;
    left = p_logic_and();
    while (tok_kind(tpos) == 28) {
        tpos = tpos + 1;
        nd = new_node(24);
        store64(nd + 32, left);
        store64(nd + 40, p_logic_and());
        left = nd;
    }
    return left;
}

int p_expr() {
    return p_logic_or();
}

int p_stmt() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int e = 0;
    int out = 0;
    k = tok_kind(tpos);
    if (k == 17) { return p_block(); }
    if (k == 21) {
        tpos = tpos + 1;
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos = tpos + 1;
        nd = new_node(5);
        store64(nd + 16, name);
        if (tok_kind(tpos) == 8) {
            tpos = tpos + 1;
            store64(nd + 40, p_expr());
        }
        expect(19);
        return nd;
    }
    if (k == 22) {
        tpos = tpos + 1;
        expect(15);
        nd = new_node(18);
        store64(nd + 32, p_expr());
        expect(16);
        store64(nd + 40, p_stmt());
        if (tok_kind(tpos) == 23) {
            tpos = tpos + 1;
            store64(nd + 48, p_stmt());
        }
        return nd;
    }
    if (k == 24) {
        tpos = tpos + 1;
        expect(15);
        nd = new_node(19);
        store64(nd + 32, p_expr());
        expect(16);
        store64(nd + 40, p_stmt());
        return nd;
    }
    if (k == 25) {
        tpos = tpos + 1;
        nd = new_node(20);
        if (tok_kind(tpos) != 19) { store64(nd + 32, p_expr()); }
        expect(19);
        return nd;
    }
    if (k == 29) {
        tpos = tpos + 1;
        expect(19);
        return new_node(25);
    }
    if (k == 30) {
        tpos = tpos + 1;
        expect(19);
        return new_node(26);
    }
    // Parse a full expression first, then decide: a plain assignment
    // (VAR '=' expr), an indexed assignment (buf[i] '=' expr), or -- if
    // not followed by '=' at all -- an expression statement. Needs
    // arbitrary lookahead (buf[i] can be any length), unlike the other
    // statement forms above which dispatch on a fixed token peek.
    e = p_expr();
    if (tok_kind(tpos) == 8) {
        tpos = tpos + 1;
        if (load64(e) == 3) {
            name = load64(e + 16);
            out = new_node(4);
            store64(out + 16, name);
            store64(out + 40, p_expr());
            expect(19);
            return out;
        }
        if (load64(e) == 27) {
            out = new_node(28);
            store64(out + 32, load64(e + 32));
            store64(out + 40, load64(e + 40));
            store64(out + 48, p_expr());
            expect(19);
            return out;
        }
        if (load64(e) == 30) {
            out = new_node(31);
            store64(out + 16, load64(e + 16));
            store64(out + 32, load64(e + 32));
            store64(out + 40, p_expr());
            expect(19);
            return out;
        }
        perr();
    }
    out = new_node(21);
    store64(out + 32, e);
    expect(19);
    return out;
}

int p_block() {
    int nd = 0;
    int head = 0;
    int tail = 0;
    int s = 0;
    expect(17);
    nd = new_node(22);
    while (tok_kind(tpos) != 18) {
        s = p_stmt();
        if (head == 0) { head = s; tail = s; }
        else { store64(tail + 56, s); tail = s; }
    }
    expect(18);
    store64(nd + 32, head);
    return nd;
}

// --- dump (must match coff0 -a byte for byte) -----------------------------

void print_indent(int depth) {
    int i = 0;
    while (i < depth) {
        print("  ");
        i = i + 1;
    }
    return;
}

void dump_bin(int nd, int depth) {
    dump_node(load64(nd + 32), depth + 1);
    dump_node(load64(nd + 40), depth + 1);
    return;
}

void dump_node(int nd, int depth) {
    int k = 0;
    int c = 0;
    int i = 0;
    int p = 0;
    int len = 0;
    if (nd == 0) { return; }
    print_indent(depth);
    k = load64(nd);
    if (k == 1) { print("NUM "); print_int(load64(nd + 8)); print("\n"); return; }
    if (k == 2) {
        print("STR");
        p = load64(nd + 16);
        len = load64(nd + 24);
        i = 0;
        while (i < len) {
            print(" ");
            print_int(load8(p + i));
            i = i + 1;
        }
        print("\n");
        return;
    }
    if (k == 3) { print("VAR "); print(load64(nd + 16)); print("\n"); return; }
    if (k == 4) {
        print("ASSIGN ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 5) {
        print("DECL ");
        print(load64(nd + 16));
        print("\n");
        if (load64(nd + 40) != 0) { dump_node(load64(nd + 40), depth + 1); }
        return;
    }
    if (k == 6) {
        print("CALL ");
        print(load64(nd + 16));
        print("\n");
        c = load64(nd + 32);
        while (c != 0) {
            dump_node(c, depth + 1);
            c = load64(c + 56);
        }
        return;
    }
    if (k == 7) { print("ADD\n"); dump_bin(nd, depth); return; }
    if (k == 8) { print("SUB\n"); dump_bin(nd, depth); return; }
    if (k == 9) { print("MUL\n"); dump_bin(nd, depth); return; }
    if (k == 10) { print("DIV\n"); dump_bin(nd, depth); return; }
    if (k == 11) { print("EQ\n"); dump_bin(nd, depth); return; }
    if (k == 12) { print("NE\n"); dump_bin(nd, depth); return; }
    if (k == 13) { print("LT\n"); dump_bin(nd, depth); return; }
    if (k == 14) { print("LE\n"); dump_bin(nd, depth); return; }
    if (k == 15) { print("GT\n"); dump_bin(nd, depth); return; }
    if (k == 16) { print("GE\n"); dump_bin(nd, depth); return; }
    if (k == 23) { print("AND\n"); dump_bin(nd, depth); return; }
    if (k == 24) { print("OR\n"); dump_bin(nd, depth); return; }
    if (k == 17) {
        print("NEG\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 18) {
        print("IF\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        if (load64(nd + 48) != 0) {
            print_indent(depth + 1);
            print("ELSE\n");
            dump_node(load64(nd + 48), depth + 1);
        }
        return;
    }
    if (k == 19) {
        print("WHILE\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 20) {
        print("RETURN\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 21) {
        print("EXPRSTMT\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 25) { print("BREAK\n"); return; }
    if (k == 26) { print("CONTINUE\n"); return; }
    if (k == 27) {
        print("INDEX\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 28) {
        print("INDEXASSIGN\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        dump_node(load64(nd + 48), depth + 1);
        return;
    }
    if (k == 30) {
        print("FIELD ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 31) {
        print("FIELDASSIGN ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 32) {
        print("SIZEOF ");
        print(load64(nd + 16));
        print("\n");
        return;
    }
    if (k == 22) {
        print("BLOCK\n");
        c = load64(nd + 32);
        while (c != 0) {
            dump_node(c, depth + 1);
            c = load64(c + 56);
        }
        return;
    }
    return;
}

// --- main: read stdin, lex, parse the program, dump -----------------------
// Function record: 96 bytes — 0 name, 8 nparams, 16+8i param names for the
// first 6 (register-passed), 64 body, 72 next, 80 is_void (1 if declared
// "void" instead of "int"), 88 extra_params (head of a linked list for the
// 7th param onward, stack-passed; max 16 total params). Extra-param node:
// 16 bytes — 0 name, 8 next. Global record: 24 bytes — 0 name, 8 init,
// 16 next.

int main() {
    int buf = 0;
    int n = 0;
    int got = 0;
    int name = 0;
    int ghead = 0;
    int gtail = 0;
    int fhead = 0;
    int ftail = 0;
    int g = 0;
    int f = 0;
    int np = 0;
    int sign = 0;
    int i = 0;
    int going = 0;
    int is_void = 0;
    int extra_head = 0;
    int extra_tail = 0;
    int pnode = 0;
    int lhead = 0;
    int ltail = 0;
    int l = 0;
    int fld_head = 0;
    int fld_tail = 0;
    int fld = 0;

    // An optional file argument (`parse1 file.c0`) is what makes include
    // resolution possible at all -- see lex.c0's main() for why piped
    // stdin content alone cannot support it. No argument falls back to the
    // original stdin-only interface, unchanged.
    if (argc() == 2) {
        expand_buf = alloc(EXPAND_CAP);
        expand_len = 0;
        include_stack = alloc(INCLUDE_MAX_DEPTH * 8);
        expand_file(argv(1));
        buf = expand_buf;
        n = expand_len;
    } else {
        // 1048576 (1MB), not 65536 -- see lex.c0's identical fix for why.
        buf = alloc(1048576);
        got = read(0, buf, 1048576);
        while (got > 0) {
            n = n + got;
            got = read(0, buf + n, 1048576 - n);
        }
    }

    lex_all(buf, n);
    tpos = 0;

    while (tok_kind(tpos) != 26) {
        if (tok_kind(tpos) == 36) {
            tpos = tpos + 1;
            if (tok_kind(tpos) != 2) { perr(); }
            l = alloc(24);
            store64(l, tok_name(tpos));
            tpos = tpos + 1;
            expect(17);
            fld_head = 0;
            fld_tail = 0;
            while (tok_kind(tpos) != 18) {
                expect(21);
                if (tok_kind(tpos) != 2) { perr(); }
                fld = alloc(16);
                store64(fld, tok_name(tpos));
                tpos = tpos + 1;
                expect(19);
                if (fld_head == 0) { fld_head = fld; fld_tail = fld; }
                else { store64(fld_tail + 8, fld); fld_tail = fld; }
            }
            expect(18);
            store64(l + 8, fld_head);
            if (lhead == 0) { lhead = l; ltail = l; }
            else { store64(ltail + 16, l); ltail = l; }
            continue;
        }
        is_void = 0;
        if (tok_kind(tpos) == 33) { is_void = 1; tpos = tpos + 1; }
        else { expect(21); }
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos = tpos + 1;
        if (tok_kind(tpos) == 15) {
            f = alloc(96);
            store64(f, name);
            store64(f + 80, is_void);
            tpos = tpos + 1;
            np = 0;
            extra_head = 0;
            extra_tail = 0;
            if (tok_kind(tpos) != 16) {
                going = 1;
                while (going == 1) {
                    expect(21);
                    if (tok_kind(tpos) != 2) { perr(); }
                    if (np >= 16) { perr(); }
                    if (np < 6) {
                        store64(f + 16 + np * 8, tok_name(tpos));
                    } else {
                        pnode = alloc(16);
                        store64(pnode, tok_name(tpos));
                        if (extra_head == 0) { extra_head = pnode; extra_tail = pnode; }
                        else { store64(extra_tail + 8, pnode); extra_tail = pnode; }
                    }
                    np = np + 1;
                    tpos = tpos + 1;
                    if (tok_kind(tpos) == 20) { tpos = tpos + 1; }
                    else { going = 0; }
                }
            }
            expect(16);
            store64(f + 8, np);
            store64(f + 88, extra_head);
            store64(f + 64, p_block());
            if (fhead == 0) { fhead = f; ftail = f; }
            else { store64(ftail + 72, f); ftail = f; }
        } else {
            if (is_void == 1) { perr(); }
            g = alloc(24);
            store64(g, name);
            if (tok_kind(tpos) == 8) {
                tpos = tpos + 1;
                sign = 1;
                if (tok_kind(tpos) == 5) { tpos = tpos + 1; sign = 0 - 1; }
                if (tok_kind(tpos) != 1) { perr(); }
                store64(g + 8, sign * tok_ival(tpos));
                tpos = tpos + 1;
            }
            expect(19);
            if (ghead == 0) { ghead = g; gtail = g; }
            else { store64(gtail + 16, g); gtail = g; }
        }
    }

    g = ghead;
    while (g != 0) {
        print("GLOBAL ");
        print(load64(g));
        print(" ");
        print_int(load64(g + 8));
        print("\n");
        g = load64(g + 16);
    }
    l = lhead;
    while (l != 0) {
        print("LAYOUT ");
        print(load64(l));
        print("\n");
        fld = load64(l + 8);
        while (fld != 0) {
            print("  FIELDDECL ");
            print(load64(fld));
            print("\n");
            fld = load64(fld + 8);
        }
        l = load64(l + 16);
    }
    f = fhead;
    while (f != 0) {
        if (load64(f + 80) == 1) { print("FUNC void "); } else { print("FUNC "); }
        print(load64(f));
        np = load64(f + 8);
        i = 0;
        while (i < np) {
            print(" ");
            print(param_name_at(f, i));
            i = i + 1;
        }
        print("\n");
        dump_node(load64(f + 64), 1);
        f = load64(f + 72);
    }
    return 0;
}
