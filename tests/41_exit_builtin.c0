// expect: 7
//
// tests/41_exit_builtin.c0 - exit() terminates immediately, even from a nested call
// Copyright (C) 2026 tavro. Part of coff, GPL-3.0-or-later (see ../LICENSE).
int die(int code) {
    exit(code);
    return 0;   // never reached
}

int main() {
    die(7);
    return 99;  // never reached
}
