// This is the second piece of the self-hosted compiler, kept as a
// standalone differential test stage. Reads c0 source from stdin (or an
// optional file argument, see main -- include directives need a real
// path to resolve against) and prints the parse tree to stdout in
// exactly the format of `coff0 -a`, which is the contract the astdiff
// loop in run_tests.sh checks. On any lex or parse error it prints
// PARSEERROR and exits 1.
//
// Phase 1 lexes the whole input into a token array in alloc'd memory,
// mirroring coff0's own structure. That also gives the parser free
// arbitrary lookahead, which the assign-vs-exprstmt split needs, since the
// left side of an assignment can be an arbitrarily long `buf[i]`
// postfix chain, not just one IDENT token.
// Phase 2 is recursive descent, building AST nodes with alloc/store64.
//
// A token record is 32 bytes — 0 kind, 8 ival, 16 name ptr, 24 len.
// Token kinds are 1 NUM, 2 IDENT, 3 STR, 4 PLUS, 5 MINUS, 6 STAR, 7 SLASH,
//   8 ASSIGN, 9 EQ, 10 NE, 11 LT, 12 LE, 13 GT, 14 GE, 15 LPAREN,
//   16 RPAREN, 17 LBRACE, 18 RBRACE, 19 SEMI, 20 COMMA, 21 INT, 22 IF,
//   23 ELSE, 24 WHILE, 25 RETURN, 26 EOF, 27 AND, 28 OR, 29 BREAK, 30 CONTINUE,
//   31 LBRACKET, 32 RBRACKET, 33 VOID, 34 EXTERN, 35 DOT, 36 LAYOUT, 37 SIZEOF,
//   38 PERCENT, 39 AMP, 40 PIPE, 41 CARET, 42 TILDE, 43 SHL, 44 SHR, 45 NOT,
//   46 PLUSEQ, 47 MINUSEQ, 48 STAREQ, 49 SLASHEQ, 50 PERCENTEQ, 51 FOR,
//   52 DEFER.
// An AST node is 64 bytes — 0 kind, 8 ival, 16 name/str ptr, 24 str len,
//   32 child1 (lhs/cond/args/body), 40 child2 (rhs/then), 48 child3 (else),
//   56 next sibling.
// Node kinds are 1 NUM, 2 STR, 3 VAR, 4 ASSIGN, 5 DECL, 6 CALL, 7 ADD, 8 SUB,
//   9 MUL, 10 DIV, 11 EQ, 12 NE, 13 LT, 14 LE, 15 GT, 16 GE, 17 NEG,
//   18 IF, 19 WHILE, 20 RETURN, 21 EXPRSTMT, 22 BLOCK, 23 AND, 24 OR,
//   25 BREAK, 26 CONTINUE, 27 INDEX (child1=base, child2=index),
//   28 INDEXASSIGN (child1=base, child2=index, child3=value),
//   30 FIELD (name=field, child1=base; e.field, sugar over load64(base+offset)),
//   31 FIELDASSIGN (name=field, child1=base, child2=value),
//   32 SIZEOF (name=layout name; sizeof(Name), a compile-time constant --
//   parse.c0 only dumps the raw form, coff0's resolve pass is what
//   rewrites it to a NUM, so -a output shows it as-is here),
//   33 MOD (child1 % child2, same shape as DIV), 34 BITAND, 35 BITOR,
//   36 BITXOR, 37 SHL, 38 SHR (binary, same shape), 39 BITNOT (unary, like NEG),
//   40 FORLOOP (child1=cond, child2=body, child3=step), 41 MULTIASSIGN
//   (child1=call, child2=target1, child3=target2), 42 DEFER (child1=stmt).
// A layout record is 24 bytes — 0 name, 8 fields (head of a linked list),
//   16 next. A layout field record is 16 bytes — 0 name, 8 next.
// Precedence, low to high, is logic_or, logic_and, | ^ &, equality,
// relational, shift, additive, term, unary, postfix. && and || are both
// short-circuiting.
// postfix := primary (("[" expr "]") | ("." IDENT))*  -- buf[i] is sugar
// over load8(buf+i)/store8; e.field is sugar over load64(e+offset)/store64.

int toks = 0;
int tpos = 0;

// Include-expansion state -- see the "includes" section below (right after
// copy_bytes) for the real logic; these are just the shared globals it
// needs across recursive calls.
int INCLUDE_MAX_DEPTH = 32;
int include_stack = 0; // alloc'd once, INCLUDE_MAX_DEPTH * 8 bytes
int include_depth = 0;
int MAX_INCLUDED = 256;
int included = 0; // alloc'd once, every file ever spliced (include-once)
int n_included = 0;
int EXPAND_CAP = 4194304; // 4MB
int expand_buf = 0;
int expand_len = 0;

int is_digit(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    return 0;
}

int is_hex_digit(int c) {
    if (is_digit(c) == 1) { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int hex_value(int c) {
    if (is_digit(c) == 1) { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return c - 'A' + 10;
}

int is_ident_start(int c) {
    if (c >= 'a' && c <= 'z') { return 1; }
    if (c >= 'A' && c <= 'Z') { return 1; }
    if (c == '_') { return 1; }
    return 0;
}

int is_ident_char(int c) {
    if (is_digit(c) == 1) { return 1; }
    return is_ident_start(c);
}

void print_int(int v) {
    int tmp = alloc(32);
    int neg = 0;
    int i = 31;
    if (!v) { print("0"); return; }
    if (v < 0) { neg = 1; }
    while (v != 0) {
        int d = v % 10;
        if (d < 0) { d = 0 - d; }
        i -= 1;
        store8(tmp + i, '0' + d);
        v /= 10;
    }
    if (neg == 1) { i -= 1; store8(tmp + i, '-'); }
    print(tmp + i);
    return;
}

int word_is(int buf, int start, int len, int kw) {
    int i = 0;
    int k = 0;
    while (i < len) {
        k = load8(kw + i);
        if (!k) { return 0; }
        if (load8(buf + start + i) != k) { return 0; }
        i += 1;
    }
    if (load8(kw + len) != 0) { return 0; }
    return 1;
}

int copy_bytes(int buf, int start, int len) {
    int p = alloc(len + 1);
    int i = 0;
    for (i = 0; i < len; i += 1) {
        store8(p + i, load8(buf + start + i));
    }
    return p;
}

// -------------------------------------------------------------- includes
//
// `include "path.c0";` is pure textual substitution, resolved entirely
// before real lexing starts -- mirrors coff0.c's resolve_includes exactly
// (differentially verified against it, and against lex.c0's own identical
// mirror), see coff0.c for the full design rationale.

int slen(int s) {
    int i = 0;
    while (load8(s + i) != 0) {
        i += 1;
    }
    return i;
}

int streq_(int a, int b) {
    int i = 0;
    int going = 1;
    int result = 0;
    while (going == 1) {
        int ca = load8(a + i);
        int cb = load8(b + i);
        if (ca != cb) { going = 0; }
        else if (!ca) { going = 0; result = 1; }
        else { i += 1; }
    }
    return result;
}

// Directory portion of `path` (a null-terminated string), trailing slash
// included so callers can concatenate directly, or a fresh empty string
// if `path` has no slash (same-directory relative resolution).
int dirname_with_slash(int path) {
    int len = slen(path);
    int i = 0;
    for (i = len - 1; i >= 0; i -= 1) {
        if (load8(path + i) == '/') {
            return copy_bytes(path, 0, i + 1);
        }
    }
    int empty = alloc(1);
    store8(empty, 0);
    return empty;
}

int join_path(int dir, int rel) {
    int dl = slen(dir);
    int rl = slen(rel);
    int out = alloc(dl + rl + 1);
    int i = 0;
    for (i = 0; i < dl; i += 1) {
        store8(out + i, load8(dir + i));
    }
    int j = 0;
    for (j = 0; j < rl; j += 1) {
        store8(out + dl + j, load8(rel + j));
    }
    store8(out + dl + rl, 0);
    return out;
}

void expand_putc(int c) {
    if (expand_len >= EXPAND_CAP) {
        print("PARSEERROR\n");
        exit(1);
    }
    store8(expand_buf + expand_len, c);
    expand_len += 1;
    return;
}

// Reads `path`, scans its raw text for `include "X";` directives (copying
// everything else through unchanged, including string literals, char
// literals, and // comments verbatim so none of them can trigger a false
// match), and recursively expands each include in place -- appending the
// result into the shared expand_buf/expand_len globals. include_stack/
// include_depth guard against a file including itself, directly or
// transitively. Char literals get the SAME verbatim-copy treatment as
// strings deliberately. Without it, a literal like '"' makes the scanner
// wrongly enter STRING mode at that bare `"` instead, scanning forward to
// whatever `"` happens to appear next in the file (this function itself
// contains `!= '"'`).
// The path with "." parts dropped and "dir/.." folded away, the key that
// tells whether two include paths name the same file. A ".." with nothing
// left to fold stays, and one above the root is the root. Messages keep the
// path as written. Mirrors coff0.c's path_key.
int path_key(int path) {
    int n = 0;
    while (load8(path + n) != 0) { n += 1; }
    int out = alloc(n + 2);
    int len = 0;
    int abs = load8(path) == '/';
    if (abs) { store8(out, '/'); len = 1; }
    int base = len;
    int i = 0;
    while (i < n) {
        while (i < n && load8(path + i) == '/') { i += 1; }
        int s = i;
        while (i < n && load8(path + i) != '/') { i += 1; }
        int plen = i - s;
        int dot = plen == 1 && load8(path + s) == '.';
        int up = plen == 2 && load8(path + s) == '.' && load8(path + s + 1) == '.';
        if (plen == 0 || dot) {
        } else if (up) {
            int ls = len;
            while (ls > base && load8(out + ls - 1) != '/') { ls -= 1; }
            int last_is_up = len - ls == 2 && load8(out + ls) == '.' && load8(out + ls + 1) == '.';
            if (len > base && !last_is_up) {
                len = ls;
                if (len > base) { len -= 1; }
            } else if (!abs) {
                if (len > base) { store8(out + len, '/'); len += 1; }
                store8(out + len, '.');
                store8(out + len + 1, '.');
                len += 2;
            }
        } else {
            if (len > base) { store8(out + len, '/'); len += 1; }
            int k = 0;
            while (k < plen) { store8(out + len + k, load8(path + s + k)); k += 1; }
            len += plen;
        }
    }
    if (len == 0) { store8(out, '.'); len = 1; }
    store8(out + len, 0);
    return out;
}

void expand_file(int path) {
    int i = 0;
    int key = path_key(path);
    for (i = 0; i < include_depth; i += 1) {
        if (streq_(load64(include_stack + i * 8), key) == 1) {
            print("PARSEERROR\n");
            exit(1);
        }
    }
    if (include_depth >= INCLUDE_MAX_DEPTH) {
        print("PARSEERROR\n");
        exit(1);
    }
    // Include-once, so a file reached a second time (a diamond) is skipped.
    i = 0;
    for (i = 0; i < n_included; i += 1) {
        if (streq_(load64(included + i * 8), key) == 1) { return; }
    }
    if (n_included >= MAX_INCLUDED) {
        print("PARSEERROR\n");
        exit(1);
    }
    store64(included + n_included * 8, key);
    n_included += 1;
    store64(include_stack + include_depth * 8, key);
    include_depth += 1;

    int fd = open_read(path);
    if (fd < 0) {
        print("PARSEERROR\n");
        exit(1);
    }
    int src = alloc(1048576);
    int n = 0;
    int got = read(fd, src, 1048576);
    while (got > 0) {
        n += got;
        got = read(fd, src + n, 1048576 - n);
    }
    close(fd);

    int dir = dirname_with_slash(path);
    int p = 0;
    while (p < n) {
        int c = load8(src + p);
        if (c == '"') {
            expand_putc(c);
            p += 1;
            int scanning = 1;
            while (scanning == 1) {
                if (p >= n || load8(src + p) == '"') { scanning = 0; }
                else {
                    int sc = load8(src + p);
                    if (sc == '\\' && p + 1 < n) {
                        expand_putc(sc);
                        p += 1;
                        expand_putc(load8(src + p));
                        p += 1;
                    } else {
                        expand_putc(sc);
                        p += 1;
                    }
                }
            }
            if (p < n) { expand_putc('"'); p += 1; }
        } else if (c == '\'') {
            expand_putc(c);
            p += 1;
            if (p < n && load8(src + p) == '\\' && p + 1 < n) {
                expand_putc(load8(src + p));
                p += 1;
                expand_putc(load8(src + p));
                p += 1;
            } else if (p < n) {
                expand_putc(load8(src + p));
                p += 1;
            }
            if (p < n && load8(src + p) == '\'') {
                expand_putc('\'');
                p += 1;
            }
        } else if (c == '/' && p + 1 < n && load8(src + p + 1) == '/') {
            while (p < n && load8(src + p) != '\n') {
                expand_putc(load8(src + p));
                p += 1;
            }
        } else if (is_ident_start(c) == 1) {
            int start = p;
            while (p < n && is_ident_char(load8(src + p)) == 1) {
                p += 1;
            }
            int wlen = p - start;
            if (wlen == 7 && word_is(src, start, 7, "include") == 1) {
                int q = p;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != '"') { print("PARSEERROR\n"); exit(1); }
                q += 1;
                int pstart = q;
                while (q < n && load8(src + q) != '"') { q += 1; }
                if (q >= n) { print("PARSEERROR\n"); exit(1); }
                int rel = copy_bytes(src, pstart, q - pstart);
                q += 1;
                while (q < n && (load8(src + q) == ' ' || load8(src + q) == '\t' || load8(src + q) == '\n' || load8(src + q) == 13)) {
                    q += 1;
                }
                if (q >= n || load8(src + q) != ';') { print("PARSEERROR\n"); exit(1); }
                q += 1;
                expand_file(join_path(dir, rel));
                p = q;
            } else {
                int k = 0;
                for (k = start; k < p; k += 1) {
                    expand_putc(load8(src + k));
                }
            }
        } else {
            expand_putc(c);
            p += 1;
        }
    }

    include_depth -= 1;
    return;
}

void perr() {
    print("PARSEERROR\n");
    exit(1);
    return;
}

void tok_put(int i, int kind, int ival, int name, int len) {
    int p = toks + i * 32;
    store64(p, kind);
    store64(p + 8, ival);
    store64(p + 16, name);
    store64(p + 24, len);
    return;
}

int tok_kind(int i) { return load64(toks + i * 32); }
int tok_ival(int i) { return load64(toks + i * 32 + 8); }
int tok_name(int i) { return load64(toks + i * 32 + 16); }
int tok_len(int i)  { return load64(toks + i * 32 + 24); }

// Lex all of buf[0..n) into the global token array; appends an EOF token.
void lex_all(int buf, int n) {
    int pos = 0;
    int t = 0;
    int c = 0;
    int nxt = 0;
    int going = 0;
    int v = 0;
    int d = 0;
    int start = 0;
    int len = 0;
    int s = 0;
    int e = 0;
    int q = 0;
    int name = 0;
    int sbuf = 0;
    int slen = 0;
    int base = 0;
    int is_hex = 0;

    toks = alloc((n + 2) * 32);

    while (pos < n) {
        c = load8(buf + pos);

        if (c == ' ') { pos += 1; }
        else if (c == '\n') { pos += 1; }
        else if (c == '\t') { pos += 1; }
        else if (c == 13) { pos += 1; }

        else if (c == '/') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '/') {
                going = 1;
                while (going == 1) {
                    if (pos < n) {
                        if (load8(buf + pos) != '\n') { pos += 1; }
                        else { going = 0; }
                    } else { going = 0; }
                }
            } else if (nxt == '=') {
                tok_put(t, 49, 0, 0, 0);
                t += 1;
                pos += 2;
            } else {
                tok_put(t, 7, 0, 0, 0);
                t += 1;
                pos += 1;
            }
        }

        else if (is_digit(c) == 1) {
            v = 0;
            base = 10;
            is_hex = 0;
            if (c == '0' && pos + 2 < n) {
                nxt = load8(buf + pos + 1);
                if ((nxt == 'x' || nxt == 'X') && is_hex_digit(load8(buf + pos + 2)) == 1) {
                    is_hex = 1;
                }
            }
            if (is_hex == 1) { pos += 2; base = 16; }
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    d = load8(buf + pos);
                    if (base == 16) {
                        if (is_hex_digit(d) == 1) {
                            v = v * 16 + hex_value(d);
                            pos += 1;
                        } else { going = 0; }
                    } else if (is_digit(d) == 1) {
                        v = v * 10 + (d - '0');
                        pos += 1;
                    } else { going = 0; }
                } else { going = 0; }
            }
            tok_put(t, 1, v, 0, 0);
            t += 1;
        }

        else if (is_ident_start(c) == 1) {
            start = pos;
            going = 1;
            while (going == 1) {
                if (pos < n) {
                    if (is_ident_char(load8(buf + pos)) == 1) { pos += 1; }
                    else { going = 0; }
                } else { going = 0; }
            }
            len = pos - start;
            if (word_is(buf, start, len, "int") == 1) { tok_put(t, 21, 0, 0, 0); }
            else if (word_is(buf, start, len, "if") == 1) { tok_put(t, 22, 0, 0, 0); }
            else if (word_is(buf, start, len, "else") == 1) { tok_put(t, 23, 0, 0, 0); }
            else if (word_is(buf, start, len, "while") == 1) { tok_put(t, 24, 0, 0, 0); }
            else if (word_is(buf, start, len, "for") == 1) { tok_put(t, 51, 0, 0, 0); }
            else if (word_is(buf, start, len, "defer") == 1) { tok_put(t, 52, 0, 0, 0); }
            else if (word_is(buf, start, len, "return") == 1) { tok_put(t, 25, 0, 0, 0); }
            else if (word_is(buf, start, len, "break") == 1) { tok_put(t, 29, 0, 0, 0); }
            else if (word_is(buf, start, len, "continue") == 1) { tok_put(t, 30, 0, 0, 0); }
            else if (word_is(buf, start, len, "void") == 1) { tok_put(t, 33, 0, 0, 0); }
            else if (word_is(buf, start, len, "extern") == 1) { tok_put(t, 34, 0, 0, 0); }
            else if (word_is(buf, start, len, "layout") == 1) { tok_put(t, 36, 0, 0, 0); }
            else if (word_is(buf, start, len, "sizeof") == 1) { tok_put(t, 37, 0, 0, 0); }
            else {
                name = copy_bytes(buf, start, len);
                tok_put(t, 2, 0, name, len);
            }
            t += 1;
        }

        else if (c == '"') {
            pos += 1;
            sbuf = alloc(n + 1);
            slen = 0;
            going = 1;
            while (going == 1) {
                if (pos >= n) { perr(); }
                s = load8(buf + pos);
                if (s == '"') {
                    going = 0;
                    pos += 1;
                } else if (s == '\\') {
                    pos += 1;
                    if (pos >= n) { perr(); }
                    e = load8(buf + pos);
                    v = 0 - 1;
                    if (e == 'n') { v = '\n'; }
                    if (e == 't') { v = '\t'; }
                    if (e == '\\') { v = '\\'; }
                    if (e == '"') { v = '"'; }
                    if (v < 0) { perr(); }
                    store8(sbuf + slen, v);
                    slen += 1;
                    pos += 1;
                } else {
                    store8(sbuf + slen, s);
                    slen += 1;
                    pos += 1;
                }
            }
            tok_put(t, 3, 0, sbuf, slen);
            t += 1;
        }

        else if (c == '\'') {
            pos += 1;
            if (pos >= n) { perr(); }
            v = 0 - 1;
            e = load8(buf + pos);
            if (e == '\\') {
                pos += 1;
                if (pos >= n) { perr(); }
                q = load8(buf + pos);
                if (q == 'n') { v = '\n'; }
                if (q == 't') { v = '\t'; }
                if (q == '\\') { v = '\\'; }
                if (q == '\'') { v = '\''; }
                if (q == '0') { v = 0; }
                if (v < 0) {
                    if (q != '0') { perr(); }
                }
                pos += 1;
            } else {
                if (e == '\'') { perr(); }
                v = e;
                pos += 1;
            }
            if (pos >= n) { perr(); }
            if (load8(buf + pos) != '\'') { perr(); }
            pos += 1;
            tok_put(t, 1, v, 0, 0);
            t += 1;
        }

        else if (c == '=') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 9, 0, 0, 0); pos += 2; }
            else { tok_put(t, 8, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '!') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 10, 0, 0, 0); pos += 2; t += 1; }
            else { tok_put(t, 45, 0, 0, 0); pos += 1; t += 1; }
        }
        else if (c == '<') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 12, 0, 0, 0); pos += 2; }
            else if (nxt == '<') { tok_put(t, 43, 0, 0, 0); pos += 2; }
            else { tok_put(t, 11, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '>') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 14, 0, 0, 0); pos += 2; }
            else if (nxt == '>') { tok_put(t, 44, 0, 0, 0); pos += 2; }
            else { tok_put(t, 13, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '+') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 46, 0, 0, 0); pos += 2; }
            else { tok_put(t, 4, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '-') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 47, 0, 0, 0); pos += 2; }
            else { tok_put(t, 5, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '*') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 48, 0, 0, 0); pos += 2; }
            else { tok_put(t, 6, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '%') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '=') { tok_put(t, 50, 0, 0, 0); pos += 2; }
            else { tok_put(t, 38, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '^') { tok_put(t, 41, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '~') { tok_put(t, 42, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '(') { tok_put(t, 15, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ')') { tok_put(t, 16, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '{') { tok_put(t, 17, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '}') { tok_put(t, 18, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ';') { tok_put(t, 19, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ',') { tok_put(t, 20, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '&') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '&') { tok_put(t, 27, 0, 0, 0); pos += 2; }
            else { tok_put(t, 39, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '|') {
            nxt = 0;
            if (pos + 1 < n) { nxt = load8(buf + pos + 1); }
            if (nxt == '|') { tok_put(t, 28, 0, 0, 0); pos += 2; }
            else { tok_put(t, 40, 0, 0, 0); pos += 1; }
            t += 1;
        }
        else if (c == '[') { tok_put(t, 31, 0, 0, 0); t += 1; pos += 1; }
        else if (c == ']') { tok_put(t, 32, 0, 0, 0); t += 1; pos += 1; }
        else if (c == '.') { tok_put(t, 35, 0, 0, 0); t += 1; pos += 1; }
        else { perr(); }
    }

    tok_put(t, 26, 0, 0, 0);
    return;
}

// Name of the i'th declared parameter (0-indexed), regardless of whether it
// lives in the inline register-param slots or the extra_params list.
int param_name_at(int f, int i) {
    int p = 0;
    int k = 0;
    if (i < 6) { return load64(f + 16 + i * 8); }
    p = load64(f + 88);
    for (k = i - 6; k > 0; k -= 1) {
        p = load64(p + 8);
    }
    return load64(p);
}

// --- parser ---------------------------------------------------------------

int new_node(int kind) {
    int p = alloc(64);
    store64(p, kind);
    return p;
}

void expect(int k) {
    if (tok_kind(tpos) != k) { perr(); }
    tpos += 1;
    return;
}

int p_primary() {
    int nd = 0;
    int name = 0;
    int k = 0;
    int head = 0;
    int tail = 0;
    int a = 0;
    k = tok_kind(tpos);
    if (k == 15) {
        tpos += 1;
        nd = p_expr();
        expect(16);
        return nd;
    }
    if (k == 1) {
        nd = new_node(1);
        store64(nd + 8, tok_ival(tpos));
        tpos += 1;
        return nd;
    }
    if (k == 3) {
        nd = new_node(2);
        store64(nd + 16, tok_name(tpos));
        store64(nd + 24, tok_len(tpos));
        tpos += 1;
        return nd;
    }
    if (k == 2) {
        name = tok_name(tpos);
        tpos += 1;
        if (tok_kind(tpos) == 15) {
            tpos += 1;
            nd = new_node(6);
            store64(nd + 16, name);
            head = 0;
            tail = 0;
            if (tok_kind(tpos) != 16) {
                a = p_expr();
                head = a;
                tail = a;
                while (tok_kind(tpos) == 20) {
                    tpos += 1;
                    a = p_expr();
                    store64(tail + 56, a);
                    tail = a;
                }
            }
            expect(16);
            store64(nd + 32, head);
            return nd;
        }
        nd = new_node(3);
        store64(nd + 16, name);
        return nd;
    }
    if (k == 37) {
        tpos += 1;
        expect(15);
        if (tok_kind(tpos) != 2) { perr(); }
        nd = new_node(32);
        store64(nd + 16, tok_name(tpos));
        tpos += 1;
        expect(16);
        return nd;
    }
    perr();
    return 0;
}

int p_postfix() {
    int nd = 0;
    int idx = 0;
    int fld = 0;
    int going = 1;
    nd = p_primary();
    while (going == 1) {
        if (tok_kind(tpos) == 31) {
            tpos += 1;
            idx = new_node(27);
            store64(idx + 32, nd);
            store64(idx + 40, p_expr());
            expect(32);
            nd = idx;
        } else if (tok_kind(tpos) == 35) {
            tpos += 1;
            if (tok_kind(tpos) != 2) { perr(); }
            fld = new_node(30);
            store64(fld + 32, nd);
            store64(fld + 16, tok_name(tpos));
            tpos += 1;
            nd = fld;
        } else { going = 0; }
    }
    return nd;
}

int p_unary() {
    int nd = 0;
    int zero = 0;
    if (tok_kind(tpos) == 5) {
        tpos += 1;
        nd = new_node(17);
        store64(nd + 32, p_unary());
        return nd;
    }
    if (tok_kind(tpos) == 42) {
        tpos += 1;
        nd = new_node(39);
        store64(nd + 32, p_unary());
        return nd;
    }
    // !E is sugar for (E == 0), so no new node kind is needed.
    if (tok_kind(tpos) == 45) {
        tpos += 1;
        nd = new_node(11);
        store64(nd + 32, p_unary());
        zero = new_node(1);
        store64(zero + 8, 0);
        store64(nd + 40, zero);
        return nd;
    }
    return p_postfix();
}

int p_term() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int going = 1;
    left = p_unary();
    while (going == 1) {
        op = tok_kind(tpos);
        if (op == 6) {
            tpos += 1;
            nd = new_node(9);
            store64(nd + 32, left);
            store64(nd + 40, p_unary());
            left = nd;
        } else if (op == 7) {
            tpos += 1;
            nd = new_node(10);
            store64(nd + 32, left);
            store64(nd + 40, p_unary());
            left = nd;
        } else if (op == 38) {
            tpos += 1;
            nd = new_node(33);
            store64(nd + 32, left);
            store64(nd + 40, p_unary());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_add() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int going = 1;
    left = p_term();
    while (going == 1) {
        op = tok_kind(tpos);
        if (op == 4) {
            tpos += 1;
            nd = new_node(7);
            store64(nd + 32, left);
            store64(nd + 40, p_term());
            left = nd;
        } else if (op == 5) {
            tpos += 1;
            nd = new_node(8);
            store64(nd + 32, left);
            store64(nd + 40, p_term());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_rel() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    int going = 1;
    left = p_shift();
    while (going == 1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 11) { kind = 13; }
        if (op == 12) { kind = 14; }
        if (op == 13) { kind = 15; }
        if (op == 14) { kind = 16; }
        if (kind > 0) {
            tpos += 1;
            nd = new_node(kind);
            store64(nd + 32, left);
            store64(nd + 40, p_shift());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

int p_equality() {
    int left = 0;
    int nd = 0;
    int op = 0;
    int kind = 0;
    int going = 1;
    left = p_rel();
    while (going == 1) {
        op = tok_kind(tpos);
        kind = 0;
        if (op == 9) { kind = 11; }
        if (op == 10) { kind = 12; }
        if (kind > 0) {
            tpos += 1;
            nd = new_node(kind);
            store64(nd + 32, left);
            store64(nd + 40, p_rel());
            left = nd;
        } else { going = 0; }
    }
    return left;
}

// The bitwise operators sit at C's precedence levels, including & ^ |
// binding more loosely than == and != (see coff0.c's parse_shift).
int p_shift() {
    int left = 0;
    int nd = 0;
    left = p_add();
    while (tok_kind(tpos) == 43 || tok_kind(tpos) == 44) {
        if (tok_kind(tpos) == 43) { nd = new_node(37); }
        else { nd = new_node(38); }
        tpos += 1;
        store64(nd + 32, left);
        store64(nd + 40, p_add());
        left = nd;
    }
    return left;
}

int p_bitand() {
    int left = 0;
    int nd = 0;
    left = p_equality();
    while (tok_kind(tpos) == 39) {
        nd = new_node(34);
        tpos += 1;
        store64(nd + 32, left);
        store64(nd + 40, p_equality());
        left = nd;
    }
    return left;
}

int p_bitxor() {
    int left = 0;
    int nd = 0;
    left = p_bitand();
    while (tok_kind(tpos) == 41) {
        nd = new_node(36);
        tpos += 1;
        store64(nd + 32, left);
        store64(nd + 40, p_bitand());
        left = nd;
    }
    return left;
}

int p_bitor() {
    int left = 0;
    int nd = 0;
    left = p_bitxor();
    while (tok_kind(tpos) == 40) {
        nd = new_node(35);
        tpos += 1;
        store64(nd + 32, left);
        store64(nd + 40, p_bitxor());
        left = nd;
    }
    return left;
}

int p_logic_and() {
    int left = 0;
    int nd = 0;
    left = p_bitor();
    while (tok_kind(tpos) == 27) {
        tpos += 1;
        nd = new_node(23);
        store64(nd + 32, left);
        store64(nd + 40, p_bitor());
        left = nd;
    }
    return left;
}

int p_logic_or() {
    int left = 0;
    int nd = 0;
    left = p_logic_and();
    while (tok_kind(tpos) == 28) {
        tpos += 1;
        nd = new_node(24);
        store64(nd + 32, left);
        store64(nd + 40, p_logic_and());
        left = nd;
    }
    return left;
}

int p_expr() {
    return p_logic_or();
}

// Folds a global's constant initializer, the same way coff0.c and coff.c0
// do, so -a shows the same value. Anything that is not a constant is a parse
// error here (perr), where the compilers say why.
int const_fold(int nd) {
    int k = load64(nd);
    if (k == 1) { return load64(nd + 8); }
    if (k == 17) { return 0 - const_fold(load64(nd + 32)); }
    if (k == 39) { return ~const_fold(load64(nd + 32)); }
    if (k == 7 || k == 8 || k == 9 || k == 10 || k == 33
        || k == 34 || k == 35 || k == 36 || k == 37 || k == 38) {
        int a = const_fold(load64(nd + 32));
        int b = const_fold(load64(nd + 40));
        if (k == 7) { return a + b; }
        if (k == 8) { return a - b; }
        if (k == 9) { return a * b; }
        if (k == 10 || k == 33) {
            if (!b) { perr(); }
            if (b == 0 - 1 && a == 1 << 63) { perr(); }
            if (k == 10) { return a / b; }
            return a % b;
        }
        if (k == 34) { return a & b; }
        if (k == 35) { return a | b; }
        if (k == 36) { return a ^ b; }
        if (k == 37) { return a << (b & 63); }
        return a >> (b & 63);
    }
    perr();
    return 0;
}


int embhead = 0;
int embtail = 0;

int p_stmt() {
    int nd = 0;
    int name = 0;
    int k = 0;
    k = tok_kind(tpos);
    if (k == 17) { return p_block(); }
    // `int x` or `Layout x` (two identifiers in a row); -a shows no types.
    if (k == 21 || (k == 2 && tok_kind(tpos + 1) == 2)) {
        tpos += 1;
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos += 1;
        nd = new_node(5);
        store64(nd + 16, name);
        if (tok_kind(tpos) == 8) {
            tpos += 1;
            store64(nd + 40, p_expr());
        }
        expect(19);
        return nd;
    }
    if (k == 22) {
        tpos += 1;
        expect(15);
        nd = new_node(18);
        store64(nd + 32, p_expr());
        expect(16);
        store64(nd + 40, p_stmt());
        if (tok_kind(tpos) == 23) {
            tpos += 1;
            store64(nd + 48, p_stmt());
        }
        return nd;
    }
    if (k == 24) {
        tpos += 1;
        expect(15);
        nd = new_node(19);
        store64(nd + 32, p_expr());
        expect(16);
        store64(nd + 40, p_stmt());
        return nd;
    }
    if (k == 25) {
        tpos += 1;
        nd = new_node(20);
        if (tok_kind(tpos) != 19) {
            store64(nd + 32, p_expr());
            if (tok_kind(tpos) == 20) { tpos += 1; store64(nd + 40, p_expr()); }
        }
        expect(19);
        return nd;
    }
    if (k == 29) {
        tpos += 1;
        expect(19);
        return new_node(25);
    }
    if (k == 30) {
        tpos += 1;
        expect(19);
        return new_node(26);
    }
    // for (init; cond; step) body parses to a BLOCK holding the init statement
    // then a FORLOOP node (kind 40); the step reuses p_simple with no ';'.
    if (k == 51) {
        int finit = 0;
        int fcond = 0;
        int fstep = 0;
        int fbody = 0;
        int floop = 0;
        int fblk = 0;
        tpos += 1;
        expect(15);
        finit = p_stmt();
        fcond = p_expr();
        expect(19);
        fstep = p_simple(0);
        expect(16);
        fbody = p_stmt();
        floop = new_node(40);
        store64(floop + 32, fcond);
        store64(floop + 40, fbody);
        store64(floop + 48, fstep);
        fblk = new_node(22);
        store64(finit + 56, floop);
        store64(fblk + 32, finit);
        return fblk;
    }
    if (k == 52) {
        tpos += 1;
        nd = new_node(42);
        store64(nd + 32, p_stmt());
        return nd;
    }
    return p_simple(1);
}

// A plain/indexed/field assignment, a compound assignment, or an expression
// statement. want_semi is 0 for a for-loop step, which has ')' after it.
int p_simple(int want_semi) {
    int e = 0;
    int out = 0;
    int name = 0;
    int ck = 0;
    int bk = 0;
    int bin = 0;
    e = p_expr();
    if (tok_kind(tpos) == 20) {
        int t2 = 0;
        int call = 0;
        if (load64(e) != 3) { perr(); }
        tpos += 1;
        t2 = p_expr();
        if (load64(t2) != 3) { perr(); }
        expect(8);
        call = p_expr();
        if (load64(call) != 6) { perr(); }
        out = new_node(41);
        store64(out + 32, call);
        store64(out + 40, e);
        store64(out + 48, t2);
        if (want_semi == 1) { expect(19); }
        return out;
    }
    if (tok_kind(tpos) == 8) {
        tpos += 1;
        if (load64(e) == 3) {
            name = load64(e + 16);
            out = new_node(4);
            store64(out + 16, name);
            store64(out + 40, p_expr());
            if (want_semi == 1) { expect(19); }
            return out;
        }
        if (load64(e) == 27) {
            out = new_node(28);
            store64(out + 32, load64(e + 32));
            store64(out + 40, load64(e + 40));
            store64(out + 48, p_expr());
            if (want_semi == 1) { expect(19); }
            return out;
        }
        if (load64(e) == 30) {
            out = new_node(31);
            store64(out + 16, load64(e + 16));
            store64(out + 32, load64(e + 32));
            store64(out + 40, p_expr());
            if (want_semi == 1) { expect(19); }
            return out;
        }
        perr();
    }
    // A compound assignment lhs OP= rhs is sugar for lhs = (lhs OP rhs).
    if (tok_kind(tpos) >= 46 && tok_kind(tpos) <= 50) {
        ck = tok_kind(tpos);
        bk = 7;
        if (ck == 47) { bk = 8; }
        if (ck == 48) { bk = 9; }
        if (ck == 49) { bk = 10; }
        if (ck == 50) { bk = 33; }
        tpos += 1;
        bin = new_node(bk);
        store64(bin + 32, e);
        store64(bin + 40, p_expr());
        if (load64(e) == 3) {
            out = new_node(4);
            store64(out + 16, load64(e + 16));
            store64(out + 40, bin);
        } else if (load64(e) == 27) {
            out = new_node(28);
            store64(out + 32, load64(e + 32));
            store64(out + 40, load64(e + 40));
            store64(out + 48, bin);
        } else if (load64(e) == 30) {
            out = new_node(31);
            store64(out + 16, load64(e + 16));
            store64(out + 32, load64(e + 32));
            store64(out + 40, bin);
        } else {
            perr();
        }
        if (want_semi == 1) { expect(19); }
        return out;
    }
    out = new_node(21);
    store64(out + 32, e);
    if (want_semi == 1) { expect(19); }
    return out;
}

int p_block() {
    int nd = 0;
    int head = 0;
    int tail = 0;
    int s = 0;
    expect(17);
    nd = new_node(22);
    while (tok_kind(tpos) != 18) {
        s = p_stmt();
        if (!head) { head = s; tail = s; }
        else { store64(tail + 56, s); tail = s; }
    }
    expect(18);
    store64(nd + 32, head);
    return nd;
}

// --- dump (must match coff0 -a byte for byte) -----------------------------

void print_indent(int depth) {
    int i = 0;
    for (i = 0; i < depth; i += 1) {
        print("  ");
    }
    return;
}

void dump_bin(int nd, int depth) {
    dump_node(load64(nd + 32), depth + 1);
    dump_node(load64(nd + 40), depth + 1);
    return;
}

void dump_node(int nd, int depth) {
    int k = 0;
    int c = 0;
    int i = 0;
    int p = 0;
    int len = 0;
    if (!nd) { return; }
    print_indent(depth);
    k = load64(nd);
    if (k == 1) { print("NUM "); print_int(load64(nd + 8)); print("\n"); return; }
    if (k == 2) {
        print("STR");
        p = load64(nd + 16);
        len = load64(nd + 24);
        i = 0;
        for (i = 0; i < len; i += 1) {
            print(" ");
            print_int(load8(p + i));
        }
        print("\n");
        return;
    }
    if (k == 3) { print("VAR "); print(load64(nd + 16)); print("\n"); return; }
    if (k == 4) {
        print("ASSIGN ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 5) {
        print("DECL ");
        print(load64(nd + 16));
        print("\n");
        if (load64(nd + 40) != 0) { dump_node(load64(nd + 40), depth + 1); }
        return;
    }
    if (k == 6) {
        print("CALL ");
        print(load64(nd + 16));
        print("\n");
        c = load64(nd + 32);
        while (c != 0) {
            dump_node(c, depth + 1);
            c = load64(c + 56);
        }
        return;
    }
    if (k == 7) { print("ADD\n"); dump_bin(nd, depth); return; }
    if (k == 8) { print("SUB\n"); dump_bin(nd, depth); return; }
    if (k == 9) { print("MUL\n"); dump_bin(nd, depth); return; }
    if (k == 10) { print("DIV\n"); dump_bin(nd, depth); return; }
    if (k == 33) { print("MOD\n"); dump_bin(nd, depth); return; }
    if (k == 34) { print("BITAND\n"); dump_bin(nd, depth); return; }
    if (k == 35) { print("BITOR\n"); dump_bin(nd, depth); return; }
    if (k == 36) { print("BITXOR\n"); dump_bin(nd, depth); return; }
    if (k == 37) { print("SHL\n"); dump_bin(nd, depth); return; }
    if (k == 38) { print("SHR\n"); dump_bin(nd, depth); return; }
    if (k == 39) {
        print("BITNOT\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 11) { print("EQ\n"); dump_bin(nd, depth); return; }
    if (k == 12) { print("NE\n"); dump_bin(nd, depth); return; }
    if (k == 13) { print("LT\n"); dump_bin(nd, depth); return; }
    if (k == 14) { print("LE\n"); dump_bin(nd, depth); return; }
    if (k == 15) { print("GT\n"); dump_bin(nd, depth); return; }
    if (k == 16) { print("GE\n"); dump_bin(nd, depth); return; }
    if (k == 23) { print("AND\n"); dump_bin(nd, depth); return; }
    if (k == 24) { print("OR\n"); dump_bin(nd, depth); return; }
    if (k == 17) {
        print("NEG\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 18) {
        print("IF\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        if (load64(nd + 48) != 0) {
            print_indent(depth + 1);
            print("ELSE\n");
            dump_node(load64(nd + 48), depth + 1);
        }
        return;
    }
    if (k == 19) {
        print("WHILE\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 40) {
        print("FORLOOP\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        dump_node(load64(nd + 48), depth + 1);
        return;
    }
    if (k == 20) {
        print("RETURN\n");
        dump_node(load64(nd + 32), depth + 1);
        if (load64(nd + 40) != 0) { dump_node(load64(nd + 40), depth + 1); }
        return;
    }
    if (k == 41) {
        print("MULTIASSIGN\n");
        dump_node(load64(nd + 40), depth + 1);
        dump_node(load64(nd + 48), depth + 1);
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 42) {
        print("DEFER\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 21) {
        print("EXPRSTMT\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 25) { print("BREAK\n"); return; }
    if (k == 26) { print("CONTINUE\n"); return; }
    if (k == 27) {
        print("INDEX\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 28) {
        print("INDEXASSIGN\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        dump_node(load64(nd + 48), depth + 1);
        return;
    }
    if (k == 30) {
        print("FIELD ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 32), depth + 1);
        return;
    }
    if (k == 31) {
        print("FIELDASSIGN ");
        print(load64(nd + 16));
        print("\n");
        dump_node(load64(nd + 32), depth + 1);
        dump_node(load64(nd + 40), depth + 1);
        return;
    }
    if (k == 32) {
        print("SIZEOF ");
        print(load64(nd + 16));
        print("\n");
        return;
    }
    if (k == 22) {
        print("BLOCK\n");
        c = load64(nd + 32);
        while (c != 0) {
            dump_node(c, depth + 1);
            c = load64(c + 56);
        }
        return;
    }
    return;
}

// --- main reads the input, lexes, parses the program and dumps it -------
// A function record is 96 bytes — 0 name, 8 nparams, 16+8i param names for the
// first 6 (register-passed), 64 body, 72 next, 80 is_void (1 if declared
// "void" instead of "int"), 88 extra_params (head of a linked list for the
// 7th param onward, stack-passed; max 16 total params). An extra-param
// node is 16 bytes — 0 name, 8 next. A global record is 24 bytes — 0 name,
// 8 init, 16 next.

int main() {
    int buf = 0;
    int n = 0;
    int got = 0;
    int name = 0;
    int ghead = 0;
    int gtail = 0;
    int fhead = 0;
    int ftail = 0;
    int g = 0;
    int f = 0;
    int np = 0;
    int i = 0;
    int going = 0;
    int is_void = 0;
    int extra_head = 0;
    int extra_tail = 0;
    int pnode = 0;
    int lhead = 0;
    int ltail = 0;
    int l = 0;
    int fld_head = 0;
    int fld_tail = 0;
    int fld = 0;

    // An optional file argument (`parse1 file.c0`) is what makes include
    // resolution possible at all -- see lex.c0's main() for why piped
    // stdin content alone cannot support it. With no argument, stdin is
    // parsed as it is and includes are not expanded.
    if (argc() == 2) {
        expand_buf = alloc(EXPAND_CAP);
        expand_len = 0;
        include_stack = alloc(INCLUDE_MAX_DEPTH * 8);
        included = alloc(MAX_INCLUDED * 8);
        expand_file(argv(1));
        buf = expand_buf;
        n = expand_len;
    } else {
        // A fixed 1MB buffer, the same as lex.c0's.
        buf = alloc(1048576);
        got = read(0, buf, 1048576);
        while (got > 0) {
            n += got;
            got = read(0, buf + n, 1048576 - n);
        }
    }

    lex_all(buf, n);
    tpos = 0;

    while (tok_kind(tpos) != 26) {
        // `embed name "file";` -- -a shows it as EMBED name file, first,
        // the way coff0 -a does. `embed` is a word, not a keyword.
        if (tok_kind(tpos) == 2 && streq_(tok_name(tpos), "embed") == 1
            && tok_kind(tpos + 1) == 2 && tok_kind(tpos + 2) == 3) {
            int em = alloc(24);
            store64(em, tok_name(tpos + 1));
            int plen = tok_len(tpos + 2);
            int pstr = alloc(plen + 1);
            int pi = 0;
            for (pi = 0; pi < plen; pi += 1) { store8(pstr + pi, load8(tok_name(tpos + 2) + pi)); }
            store8(pstr + plen, 0);
            store64(em + 8, pstr);
            store64(em + 16, 0);
            tpos += 3;
            expect(19);
            if (!embhead) { embhead = em; embtail = em; }
            else { store64(embtail + 16, em); embtail = em; }
            continue;
        }
        // `extern int name;` declares no AST of its own, and coff0 -a
        // prints nothing for it, so it is parsed and dropped.
        if (tok_kind(tpos) == 34) {
            tpos += 1;
            expect(21);
            if (tok_kind(tpos) != 2) { perr(); }
            tpos += 1;
            expect(19);
            continue;
        }
        if (tok_kind(tpos) == 36) {
            tpos += 1;
            if (tok_kind(tpos) != 2) { perr(); }
            l = alloc(24);
            store64(l, tok_name(tpos));
            tpos += 1;
            expect(17);
            fld_head = 0;
            fld_tail = 0;
            while (tok_kind(tpos) != 18) {
                expect(21);
                if (tok_kind(tpos) != 2) { perr(); }
                fld = alloc(16);
                store64(fld, tok_name(tpos));
                tpos += 1;
                expect(19);
                if (!fld_head) { fld_head = fld; fld_tail = fld; }
                else { store64(fld_tail + 8, fld); fld_tail = fld; }
            }
            expect(18);
            store64(l + 8, fld_head);
            if (!lhead) { lhead = l; ltail = l; }
            else { store64(ltail + 16, l); ltail = l; }
            continue;
        }
        is_void = 0;
        int two_ret = 0;
        if (tok_kind(tpos) == 15) {
            tpos += 1; expect(21); expect(20); expect(21); expect(16);
            two_ret = 1;
        }
        else if (tok_kind(tpos) == 33) { is_void = 1; tpos += 1; }
        else if (tok_kind(tpos) == 2 && tok_kind(tpos + 1) == 2) { tpos += 1; }
        else { expect(21); }
        if (tok_kind(tpos) != 2) { perr(); }
        name = tok_name(tpos);
        tpos += 1;
        if (tok_kind(tpos) == 15) {
            f = alloc(104);
            store64(f, name);
            store64(f + 80, is_void);
            store64(f + 96, two_ret);
            tpos += 1;
            np = 0;
            extra_head = 0;
            extra_tail = 0;
            if (tok_kind(tpos) != 16) {
                going = 1;
                while (going == 1) {
                    if (tok_kind(tpos) == 2 && tok_kind(tpos + 1) == 2) { tpos += 1; }
                    else { expect(21); }
                    if (tok_kind(tpos) != 2) { perr(); }
                    if (np >= 16) { perr(); }
                    if (np < 6) {
                        store64(f + 16 + np * 8, tok_name(tpos));
                    } else {
                        pnode = alloc(16);
                        store64(pnode, tok_name(tpos));
                        if (!extra_head) { extra_head = pnode; extra_tail = pnode; }
                        else { store64(extra_tail + 8, pnode); extra_tail = pnode; }
                    }
                    np += 1;
                    tpos += 1;
                    if (tok_kind(tpos) == 20) { tpos += 1; }
                    else { going = 0; }
                }
            }
            expect(16);
            store64(f + 8, np);
            store64(f + 88, extra_head);
            store64(f + 64, p_block());
            if (!fhead) { fhead = f; ftail = f; }
            else { store64(ftail + 72, f); ftail = f; }
        } else {
            if (is_void == 1) { perr(); }
            g = alloc(24);
            store64(g, name);
            if (tok_kind(tpos) == 8) {
                tpos += 1;
                store64(g + 8, const_fold(p_expr()));
            }
            expect(19);
            if (!ghead) { ghead = g; gtail = g; }
            else { store64(gtail + 16, g); gtail = g; }
        }
    }

    int emp = embhead;
    while (emp != 0) {
        print("EMBED ");
        print(load64(emp));
        print(" ");
        print(load64(emp + 8));
        print("\n");
        emp = load64(emp + 16);
    }
    g = ghead;
    while (g != 0) {
        print("GLOBAL ");
        print(load64(g));
        print(" ");
        print_int(load64(g + 8));
        print("\n");
        g = load64(g + 16);
    }
    l = lhead;
    while (l != 0) {
        print("LAYOUT ");
        print(load64(l));
        print("\n");
        fld = load64(l + 8);
        while (fld != 0) {
            print("  FIELDDECL ");
            print(load64(fld));
            print("\n");
            fld = load64(fld + 8);
        }
        l = load64(l + 16);
    }
    f = fhead;
    while (f != 0) {
        if (load64(f + 80) == 1) { print("FUNC void "); }
        else if (load64(f + 96) == 1) { print("FUNC (int, int) "); }
        else { print("FUNC "); }
        print(load64(f));
        np = load64(f + 8);
        i = 0;
        for (i = 0; i < np; i += 1) {
            print(" ");
            print(param_name_at(f, i));
        }
        print("\n");
        dump_node(load64(f + 64), 1);
        f = load64(f + 72);
    }
    return 0;
}
